---
interface Props { title?: string; description?: string; }
const {
  title = "Babycakes — Feel Good Food",
  description = "Born from baby + cakes. Classic recipes reimagined for today."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta http-equiv="x-dns-prefetch-control" content="on"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <!-- Shrikhand: logo wordmark only | Neulis Neue: everything else -->
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Neulis+Neue:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet"/>
</head>
<body>

<header class="nav" id="nav">
  <div class="nav-in">
    <a href="/" class="nav-logo">babycakes</a>
    <nav class="nav-links">
      <div class="nav-group" id="ngf">
        <button class="nav-gbtn" aria-expanded="false" aria-haspopup="true">
          Flavors
          <svg class="nav-chev" width="10" height="6" viewBox="0 0 10 6" fill="none">
            <path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
        <div class="nav-drop" role="menu">
          <a href="/bi-weekly" role="menuitem"><span class="nd-dot nd-y"></span>Bi-Weekly Flavors</a>
          <a href="/always-available" role="menuitem"><span class="nd-dot nd-cr"></span>Always Available</a>
