---
import Base from '../../layouts/Base.astro';
const posts=[
  {slug:"strawberry-kiss",title:"Strawberry Kiss",period:"17 Feb – 13 March",tag:"bi-weekly",bg:"#c98fa0",desc:"A gentle taste of nostalgia and joy — made to sweeten every moment."},
  {slug:"dubai-chocolate",title:"Dubai Chocolate",period:"17 Feb – 13 March",tag:"bi-weekly",bg:"#2a1508",desc:"Where love becomes cake. Classic recipe, reimagined for today."},
  {slug:"mayongchid",title:"Mayongchid",period:"11 – 17 April",tag:"bi-weekly",bg:"#d4890a",desc:"Thai mango custard — the taste of home, the pride of every bite."},
  {slug:"cheesecake-blueberry",title:"Cheesecake Blueberry",period:"13 – 18 Feb",tag:"weekly",bg:"#3d2460",desc:"Baked with care, crafted with intention. A classic, perfected."},
  {slug:"nomyen",title:"Nomyen",period:"13 – 18 Feb",tag:"weekly",bg:"#e8a0b0",desc:"The softest pink — as sweet as a summer afternoon."},
  {slug:"cake-cube",title:"Cake Cube",period:"New Drop",tag:"new",bg:"#1a1a1a",desc:"Dubai Chocolate in a bold new format. Joy in a box."},
  {slug:"banoffee",title:"Banoffee",period:"13 – 18 Feb",tag:"weekly",bg:"#b5863a",desc:"Banana, toffee, cream — a British classic that never gets old."},
  {slug:"chocolate",title:"Chocolate",period:"Everyday",tag:"everyday",bg:"#3b1a0a",desc:"Our original. Rich, dark, and deeply comforting."},
];
---
<Base title="Weekly Updates | Babycakes" description="Every week a new flavor. Follow the drop.">

<section style="background:var(--pd);padding:10rem var(--px) 5rem;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;opacity:0.04;background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:28px 28px"></div>
  <div style="max-width:1400px;margin:0 auto;position:relative;z-index:2">
    <div class="tag tag-y au" style="margin-bottom:1rem">Updated Every Week</div>
    <h1 class="logo au au-1" style="font-size:clamp(3.5rem,10vw,8rem);color:var(--y);line-height:0.95;letter-spacing:-0.02em">Weekly<br/>Updates.</h1>
    <p class="au au-2" style="margin-top:1.5rem;color:rgba(251,245,171,0.6);font-size:1.05rem;max-width:480px;line-height:1.7">A new flavor, a new story — every week. This is the drop you don't want to miss.</p>
  </div>
</section>

<div class="marquee">
  <div class="marquee-track">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Cake Cube","Thai Tea","All-star","feel good food","Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Cake Cube","Thai Tea","All-star","feel good food"].map(t=>(
      <span class="marquee-item">{t}<span class="marquee-dot">✦</span></span>
    ))}
  </div>
</div>

<section style="padding:5rem var(--px) 8rem">
  <div style="max-width:1400px;margin:0 auto">
    <!-- Filter tabs -->
    <div style="display:flex;gap:0.75rem;margin-bottom:3.5rem;flex-wrap:wrap">
      {["All","bi-weekly","weekly","new","everyday"].map(f=>(
        <button style={`padding:0.4rem 1.1rem;border-radius:999px;border:1.5px solid var(--pd);font-size:0.75rem;font-weight:700;letter-spacing:0.04em;text-transform:uppercase;cursor:pointer;background:${f==='All'?'var(--pd)':'transparent'};color:${f==='All'?'var(--y)':'var(--pd)'};transition:all 0.15s`}>{f}</button>
      ))}
    </div>

    <!-- Journal grid — Pidapipó style -->
    <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:2rem">
      {posts.map((p,i)=>(
        <a href={`/weekly-updates/${p.slug}`} style={`display:flex;flex-direction:column;border-radius:1.25rem;overflow:hidden;background:#fff;box-shadow:0 2px 20px rgba(76,67,120,0.08);transition:transform 0.25s ease,box-shadow 0.25s ease;animation:fadeUp 0.5s cubic-bezier(0.22,1,0.36,1) ${i*0.06}s both`} onmouseover="this.style.transform='translateY(-5px)';this.style.boxShadow='0 16px 48px rgba(76,67,120,0.18)'" onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='0 2px 20px rgba(76,67,120,0.08)'">
          <div style={`background:${p.bg};aspect-ratio:4/3;position:relative;display:flex;align-items:flex-end;padding:1.25rem`}>
            <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.5) 0%,transparent 55%)"></div>
            <span class="logo" style="position:relative;z-index:2;font-size:1.8rem;color:#fff;line-height:1.1;text-shadow:0 2px 8px rgba(0,0,0,0.3)">{p.title}</span>
          </div>
          <div style="padding:1.25rem 1.4rem 1.75rem;flex:1;display:flex;flex-direction:column">
            <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:0.75rem">
              <span class="tag tag-y">{p.tag}</span>
              <span style="font-size:0.7rem;color:var(--p);font-weight:700">{p.period}</span>
            </div>
            <h2 style="font-size:1.05rem;font-weight:900;color:var(--pd);margin-bottom:0.5rem">{p.title}</h2>
            <p style="font-size:0.875rem;color:#666;line-height:1.65;flex:1">{p.desc}</p>
            <span style="margin-top:1rem;font-size:0.8rem;font-weight:800;color:var(--p)">Read more →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
</Base>
