---
import Base from '../layouts/Base.astro';
const roles = [
  { title:"Pastry Chef",          type:"Full-time", loc:"Bangkok, TH", dept:"Kitchen",   desc:"Lead bi-weekly flavor development. Craft, test, and refine new recipes that hit our feel-good standard." },
  { title:"Social Media Manager", type:"Full-time", loc:"Bangkok, TH", dept:"Marketing", desc:"Own the brand voice across Instagram, TikTok, and LINE. Create content that stops people and makes them order." },
  { title:"Brand Designer",       type:"Full-time", loc:"Bangkok, TH", dept:"Creative",  desc:"Bring the Babycakes visual world to life — from weekly posts to packaging. Every touchpoint matters." },
  { title:"Operations Manager",   type:"Full-time", loc:"Bangkok, TH", dept:"Ops",       desc:"Keep the machine running. Inventory, delivery coordination — ensure every cake arrives perfect and on time." },
  { title:"Customer Experience",  type:"Part-time", loc:"Bangkok, TH", dept:"Service",   desc:"Handle orders, feedback, and relationships across LINE, phone, and in-branch with warmth and efficiency." },
  { title:"Rider / Delivery",     type:"Part-time", loc:"Bangkok, TH", dept:"Logistics", desc:"Deliver feel-good food across Bangkok. Reliable, punctual, and always professional." },
];
const perks = [
  { t:"Monthly Tasting Sessions", d:"You taste the product — it is literally part of the job." },
  { t:"Birthday Cake Policy",     d:"Every team member gets a custom Babycakes cake on their birthday." },
  { t:"Wellness Allowance",       d:"Monthly allowance for gym, therapy, or massage — your choice." },
  { t:"Flexible Hours",           d:"We care about output, not clock-watching." },
  { t:"Learning Fridays",         d:"Monthly guest sessions with chefs, designers, and brand builders." },
  { t:"Team Bake Days",           d:"Collaborative baking sessions — your idea might be next." },
];
---
<Base title="Careers | Babycakes" description="Join the Babycakes family. Passionate people, feel-good culture, and a lot of cake.">

<section class="pg-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.75rem">We're Hiring</div>
    <h1 class="lf pg-h1 au au1">Join the<br/>family.</h1>
    <p class="pg-sub au au2">We're looking for passionate people who believe in feel-good food.<br/>If you care about craft, warmth, and doing things properly — you'll fit in here.</p>
    <a href="#roles" class="btn btn-y btn-lg au au3" style="margin-top:2.5rem;display:inline-flex">See Open Roles</a>
  </div>
</section>

<!-- PERKS — off-white, clean grid, no emojis -->
<section class="sec" style="background:var(--off)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-p sh-eye">Why Join Us</span>
        <h2 class="lf sh-h">The good stuff.</h2>
      </div>
    </div>
    <div class="g3">
      {perks.map((p, i) => (
        <div class="perk-card au" style={"animation-delay:" + (i * 0.07) + "s"}>
          <h3 class="perk-t">{p.t}</h3>
          <p class="perk-d">{p.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ROLES -->
<section class="sec" id="roles">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-p sh-eye">Open Positions</span>
        <h2 class="lf sh-h">{roles.length} Open Roles.</h2>
      </div>
    </div>
    <div class="roles-wrap">
      {roles.map((r, i) => (
        <div class="role-row au" style={"animation-delay:" + (i * 0.06) + "s"}>
          <div class="role-dept"><span class="tag tag-y">{r.dept}</span></div>
          <div class="role-body">
            <h3 class="role-t">{r.title}</h3>
            <p class="role-d">{r.desc}</p>
          </div>
          <div class="role-meta">
            <span class="role-type">{r.type}</span>
            <span class="role-loc">{r.loc}</span>
          </div>
          <a href={"mailto:hello@babycakes.th?subject=Application: " + r.title} class="btn btn-d btn-sm role-apply">Apply</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CTA -->
<section style="background:var(--dk);padding:clamp(6rem,10vw,9rem) var(--px)">
  <div class="wrap" style="max-width:600px;text-align:center;margin-inline:auto">
    <span class="tag tag-y" style="margin-bottom:1.5rem;display:inline-flex">Don't see your role?</span>
    <h2 class="lf" style="font-size:clamp(2.75rem,7vw,5rem);color:var(--y);line-height:0.92;margin-bottom:1.5rem">Say hello.</h2>
    <p style="color:rgba(251,245,171,0.42);font-size:1rem;line-height:1.85;margin-bottom:3rem">We are always open to meeting great people. Tell us who you are and how you would add to the Babycakes story.</p>
    <a href="mailto:hello@babycakes.th" class="btn btn-y btn-lg">hello@babycakes.th</a>
  </div>
</section>
</Base>
<style>
.pg-hero { position:relative; background:var(--d); padding:10rem var(--px) 6rem; overflow:hidden; }
.pg-h1 { font-size:clamp(3.5rem,10vw,8.5rem); color:var(--y); line-height:0.9; letter-spacing:-0.025em; margin-bottom:1.5rem; }
.pg-sub { color:rgba(251,245,171,0.45); font-size:clamp(0.95rem,1.6vw,1.05rem); line-height:1.9; max-width:480px; }
.perk-card { background:var(--w); border:1px solid var(--g1); border-radius:var(--rm); padding:2.25rem 2rem; animation:fadeUp 0.65s var(--ease) both; }
.perk-t { font-size:1rem; font-weight:600; color:var(--d); margin-bottom:0.75rem; }
.perk-d { font-size:0.875rem; color:var(--g3); line-height:1.8; }
.roles-wrap { border:1px solid var(--g1); border-radius:var(--rl); overflow:hidden; }
.role-row { display:grid; grid-template-columns:110px 1fr 160px 100px; align-items:center; gap:2.5rem; padding:2rem 2.5rem; border-bottom:1px solid var(--g1); background:var(--w); transition:background 0.15s; animation:fadeUp 0.55s var(--ease) both; }
.role-row:last-child { border-bottom:none; }
.role-row:hover { background:var(--off); }
.role-t { font-size:1rem; font-weight:600; color:var(--d); margin-bottom:0.4rem; }
.role-d { font-size:0.85rem; color:var(--g3); line-height:1.7; }
.role-meta { display:flex; flex-direction:column; gap:0.3rem; }
.role-type { font-size:0.78rem; font-weight:600; color:var(--d); }
.role-loc  { font-size:0.75rem; color:var(--g3); font-weight:400; }
.role-apply { flex-shrink:0; }
@media(max-width:900px) { .role-row{grid-template-columns:1fr;gap:1rem;padding:1.75rem} .role-dept{order:-1} .role-apply{width:fit-content} }
</style>
