---
import Base from '../layouts/Base.astro';
const roles=[
  {title:"Pastry Chef",type:"Full-time",loc:"Bangkok, TH",dept:"Kitchen",desc:"Lead our bi-weekly flavor development. Craft, test, and refine new recipes that hit the brand's feel-good standard."},
  {title:"Social Media Manager",type:"Full-time",loc:"Bangkok, TH",dept:"Marketing",desc:"Own the brand voice across Instagram, TikTok, and LINE. Create content that makes people stop, feel something, and order."},
  {title:"Brand Designer",type:"Full-time",loc:"Bangkok, TH",dept:"Creative",desc:"Bring the Babycakes visual world to life — from weekly flavor posts to packaging, every touchpoint matters."},
  {title:"Operations Manager",type:"Full-time",loc:"Bangkok, TH",dept:"Ops",desc:"Keep the machine running. Inventory, delivery, branch coordination — ensure every cake arrives on time and perfect."},
  {title:"Customer Experience",type:"Part-time",loc:"Bangkok, TH",dept:"Service",desc:"Be the first voice customers hear. Handle orders, feedback, and relationships with warmth and care."},
  {title:"Rider / Delivery",type:"Part-time",loc:"Bangkok, TH",dept:"Logistics",desc:"Deliver feel-good food across Bangkok. Reliable, fast, and always with a smile."},
];
const vals=[
  {t:"Baked with intention.",d:"We don't rush. Every detail — flavor, texture, timing — is deliberate.",i:"◎"},
  {t:"Warmth is non-negotiable.",d:"How we treat each other is how we treat our customers. With care.",i:"♡"},
  {t:"Sweet ambition.",d:"We're small but growing fast. If you want to build something, this is the place.",i:"✦"},
  {t:"Feel-good culture.",d:"No toxic hustle. Good work, good people, good food.",i:"✎"},
];
---
<Base title="Careers | Babycakes" description="Join the Babycakes family. We're looking for passionate people who believe in feel-good food.">

<section class="care-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-w au" style="width:fit-content;margin-bottom:1.25rem">We're Hiring</div>
    <h1 class="lf care-h1 au au1">Join the<br/>family.</h1>
    <p class="care-sub au au2">We're looking for passionate people who believe in feel-good food. If you care about craft, warmth, and doing things right — you'll fit in here.</p>
    <a href="#roles" class="btn btn-y au au3" style="margin-top:2rem">See Open Roles →</a>
  </div>
</section>

<section class="sec" style="background:var(--y)">
  <div class="wrap">
    <div style="text-align:center;margin-bottom:4rem">
      <div class="tag tag-p" style="margin-bottom:1rem">How We Work</div>
      <h2 class="lf" style="font-size:clamp(2.5rem,5vw,3.5rem);color:var(--pd);line-height:1">What we believe in.</h2>
    </div>
    <div class="g4 vgrid">
      {vals.map((v,i)=>(
        <div class="vcard" style={"animation-delay:"+i*.08+"s"}>
          <span class="vi">{v.i}</span>
          <h3 class="vt">{v.t}</h3>
          <p class="vd">{v.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec" id="roles">
  <div class="wrap">
    <div class="sh" style="margin-bottom:3rem">
      <div>
        <div class="tag tag-o" style="margin-bottom:.9rem">Open Positions</div>
        <h2 class="lf sh-title">{roles.length} Open Roles.</h2>
      </div>
    </div>
    <div class="roles-list">
      {roles.map((r,i)=>(
        <div class="role-row" style={"animation:fadeUp .5s var(--eout) "+i*.06+"s both"}>
          <div class="rdept"><span class="tag tag-y">{r.dept}</span></div>
          <div class="rinfo">
            <h3 class="rtitle">{r.title}</h3>
            <p class="rdesc">{r.desc}</p>
          </div>
          <div class="rmeta">
            <span class="rtype">{r.type}</span>
            <span class="rloc">📍 {r.loc}</span>
          </div>
          <a href={"mailto:hello@babycakes.th?subject=Application: "+r.title} class="btn btn-p btn-sm">Apply →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<section style="background:var(--pd);padding:clamp(5rem,9vw,8rem) var(--px);text-align:center">
  <div style="max-width:640px;margin-inline:auto">
    <div class="lf" style="font-size:clamp(2.5rem,6vw,4.5rem);color:var(--y);line-height:1;margin-bottom:1.5rem">Don't see your role?</div>
    <p style="color:rgba(251,245,171,.6);font-size:1.05rem;line-height:1.8;margin-bottom:2.5rem">We're always open to meeting great people. Drop us a message and tell us how you'd add to the Babycakes story.</p>
    <a href="mailto:hello@babycakes.th" class="btn btn-y">Say Hello →</a>
  </div>
</section>

</Base>
<style>
.care-hero{position:relative;background:var(--pd);padding:10rem var(--px) 6rem;overflow:hidden}
.care-h1{font-size:clamp(4rem,12vw,9.5rem);color:var(--y);line-height:.9;letter-spacing:-.025em;margin-bottom:1.5rem}
.care-sub{color:rgba(251,245,171,.6);font-size:clamp(1rem,1.8vw,1.15rem);max-width:500px;line-height:1.8}
.vgrid{}
.vcard{background:var(--w);border-radius:var(--rmd);padding:2.25rem 2rem;animation:fadeUp .55s var(--eout) both}
.vi{display:block;font-size:1.5rem;color:var(--p);margin-bottom:1rem}
.vt{font-size:1rem;font-weight:900;color:var(--pd);margin-bottom:.6rem;line-height:1.3}
.vd{font-size:.875rem;color:var(--g3);line-height:1.7}
@media(max-width:768px){.vgrid{grid-template-columns:1fr 1fr!important}}
@media(max-width:480px){.vgrid{grid-template-columns:1fr!important}}
.sh{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;flex-wrap:wrap}
.sh-title{font-size:clamp(2.5rem,5vw,4rem);color:var(--pd);line-height:1}
.roles-list{display:flex;flex-direction:column;border:1.5px solid var(--g2);border-radius:var(--rlg);overflow:hidden}
.role-row{display:grid;grid-template-columns:130px 1fr 180px 140px;align-items:center;gap:2rem;padding:2rem 2.5rem;border-bottom:1.5px solid var(--g2);background:var(--w);transition:background .18s}
.role-row:last-child{border-bottom:none}
.role-row:hover{background:var(--ow)}
.rtitle{font-size:1.05rem;font-weight:900;color:var(--pd);margin-bottom:.4rem}
.rdesc{font-size:.82rem;color:var(--g3);line-height:1.6}
.rmeta{display:flex;flex-direction:column;gap:.35rem}
.rtype{font-size:.75rem;font-weight:800;color:var(--pd);letter-spacing:.04em}
.rloc{font-size:.72rem;color:var(--g3)}
@media(max-width:900px){.role-row{grid-template-columns:1fr;gap:1rem;padding:1.75rem}.rdept{order:-1}}
</style>
