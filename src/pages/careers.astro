---
import Base from '../layouts/Base.astro';
const roles=[
  {title:"Pastry Chef",         type:"Full-time",  loc:"Bangkok, TH",  dept:"Kitchen",   desc:"Lead bi-weekly flavor development. Craft, test, and refine new recipes that hit our feel-good standard."},
  {title:"Social Media Manager",type:"Full-time",  loc:"Bangkok, TH",  dept:"Marketing", desc:"Own the brand voice across Instagram, TikTok, and LINE. Create content that stops people and makes them order."},
  {title:"Brand Designer",      type:"Full-time",  loc:"Bangkok, TH",  dept:"Creative",  desc:"Bring the Babycakes visual world to life — from weekly posts to packaging. Every touchpoint matters."},
  {title:"Operations Manager",  type:"Full-time",  loc:"Bangkok, TH",  dept:"Ops",       desc:"Keep the machine running. Inventory, delivery, coordination — every cake arrives perfect and on time."},
  {title:"Customer Experience", type:"Part-time",  loc:"Bangkok, TH",  dept:"Service",   desc:"Be the first voice customers hear. Handle orders, feedback, and relationships with warmth and care."},
  {title:"Rider / Delivery",    type:"Part-time",  loc:"Bangkok, TH",  dept:"Logistics", desc:"Deliver feel-good food across Bangkok. Reliable, fast, and always with a smile."},
];
const perks=[
  {t:"Monthly Tasting Sessions",  d:"You eat the product — it's literally part of the job.",       i:"🍰"},
  {t:"Birthday Cake Policy",      d:"Every team member gets a custom Babycakes on their birthday.", i:"🎂"},
  {t:"Wellness Allowance",        d:"Monthly allowance for gym, therapy, massage — your call.",     i:"♡"},
  {t:"Flexible Hours",            d:"We care about output, not clock-watching.",                     i:"⏰"},
  {t:"Learning Fridays",          d:"Monthly guest sessions with chefs, designers, and brand builders.", i:"📚"},
  {t:"Team Bake Days",            d:"Collaborative baking sessions — your idea might be next.",      i:"✨"},
];
---
<Base title="Careers | Babycakes" description="Join the Babycakes family. Passionate people, feel-good culture, and a lot of cake.">

<section class="care-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-w au" style="width:fit-content;margin-bottom:1.5rem">We're Hiring</div>
    <h1 class="lf care-h1 au au-1">Join the<br/>family.</h1>
    <p class="care-sub au au-2">We're looking for passionate people who believe in feel-good food. If you care about craft, warmth, and doing things properly — you'll fit in here.</p>
    <a href="#roles" class="btn btn-y au au-3" style="margin-top:2.25rem">See Open Roles →</a>
  </div>
</section>

<!-- PERKS -->
<section class="sec" style="background:var(--yellow)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-p sh-eyebrow">Why Join Us</span>
        <h2 class="lf sh-title" style="color:var(--dark)">The good stuff.</h2>
      </div>
    </div>
    <div class="g3 perks-grid">
      {perks.map((p,i)=>(
        <div class="perk-card" style={"animation-delay:"+i*.06+"s"}>
          <span class="perk-icon">{p.i}</span>
          <h3 class="perk-title">{p.t}</h3>
          <p class="perk-desc">{p.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ROLES -->
<section class="sec" id="roles">
  <div class="wrap">
    <div class="sh" style="margin-bottom:3rem">
      <div>
        <span class="tag tag-o sh-eyebrow">Open Positions</span>
        <h2 class="lf sh-title">{roles.length} Open Roles.</h2>
      </div>
    </div>
    <div class="roles-wrap">
      {roles.map((r,i)=>(
        <div class="role-row" style={"animation:fadeUp .5s var(--ease) "+i*.06+"s both"}>
          <div class="role-dept"><span class="tag tag-y">{r.dept}</span></div>
          <div class="role-body">
            <h3 class="role-title">{r.title}</h3>
            <p class="role-desc">{r.desc}</p>
          </div>
          <div class="role-meta">
            <span class="role-type">{r.type}</span>
            <span class="role-loc">📍 {r.loc}</span>
          </div>
          <a href={"mailto:hello@babycakes.th?subject=Application: "+r.title} class="btn btn-p btn-sm role-btn">Apply →</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- OPEN CTA -->
<section style="background:var(--dark);padding:clamp(5rem,9vw,8rem) var(--px)">
  <div class="wrap" style="max-width:600px;text-align:center;margin-inline:auto">
    <div class="tag tag-y" style="margin-bottom:1.5rem;margin-inline:auto;width:fit-content">Don't see your role?</div>
    <h2 class="lf" style="font-size:clamp(2.5rem,6vw,4.5rem);color:var(--yellow);line-height:.95;margin-bottom:1.5rem">Say hello.</h2>
    <p style="color:rgba(251,245,171,.5);font-size:1.05rem;line-height:1.85;margin-bottom:2.5rem">We're always open to meeting great people. Tell us who you are and how you'd add to the Babycakes story.</p>
    <a href="mailto:hello@babycakes.th" class="btn btn-y" style="font-size:1rem;padding:1rem 2.75rem">hello@babycakes.th →</a>
  </div>
</section>
</Base>

<style>
.care-hero { position:relative; background:var(--dark); padding:10rem var(--px) 6rem; overflow:hidden; }
.care-h1 { font-size:clamp(4rem,12vw,9.5rem); color:var(--yellow); line-height:.9; letter-spacing:-.025em; margin-bottom:1.5rem; }
.care-sub { color:rgba(251,245,171,.58); font-size:clamp(1rem,1.8vw,1.1rem); max-width:520px; line-height:1.85; }
.perks-grid {}
.perk-card { background:var(--white); border-radius:var(--r-md); padding:2.25rem 2rem; animation:fadeUp .6s var(--ease) both; }
.perk-icon { display:block; font-size:2rem; margin-bottom:1.25rem; }
.perk-title { font-size:1rem; font-weight:900; color:var(--dark); margin-bottom:.6rem; }
.perk-desc { font-size:var(--text-sm); color:var(--gray-3); line-height:1.75; }
.roles-wrap { border:1.5px solid var(--gray-2); border-radius:var(--r-xl); overflow:hidden; }
.role-row { display:grid; grid-template-columns:130px 1fr 160px 130px; align-items:center; gap:2rem; padding:2rem 2.5rem; border-bottom:1.5px solid var(--gray-2); background:var(--white); transition:background .18s; }
.role-row:last-child { border-bottom:none; }
.role-row:hover { background:var(--cream); }
.role-title { font-size:1rem; font-weight:900; color:var(--dark); margin-bottom:.4rem; }
.role-desc { font-size:var(--text-sm); color:var(--gray-3); line-height:1.65; }
.role-meta { display:flex; flex-direction:column; gap:.35rem; }
.role-type { font-size:var(--text-xs); font-weight:800; color:var(--dark); letter-spacing:.04em; }
.role-loc { font-size:var(--text-xs); color:var(--gray-3); }
.role-btn { flex-shrink:0; text-align:center; }
@media (max-width:900px) { .role-row { grid-template-columns:1fr; gap:1rem; padding:1.75rem; } .role-dept { order:-1; } }
</style>
