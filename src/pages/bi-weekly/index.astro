---
import Base from '../../layouts/Base.astro';
const posts = [
  { slug:"strawberry-kiss",       name:"Strawberry Kiss",       period:"17 Feb – 13 March", bg:"#A85565", desc:"A gentle taste of nostalgia and joy. Layered sponge, fresh strawberry cream, made to sweeten every moment." },
  { slug:"dubai-chocolate",       name:"Dubai Chocolate",       period:"17 Feb – 13 March", bg:"#1E0D05", desc:"Where love becomes cake. Crispy knafeh, dark chocolate — a viral sensation, reimagined with care." },
  { slug:"mayongchid",            name:"Mayongchid",            period:"11 – 17 April",     bg:"#B07212", desc:"Thai mango custard. Seasonal, sun-golden, and gone before you know it. A true Thai treasure." },
  { slug:"cheesecake-blueberry",  name:"Cheesecake Blueberry",  period:"13 – 18 Feb",       bg:"#362056", desc:"Velvety cheesecake meets jammy blueberry. A classic, perfected with every batch." },
  { slug:"nomyen",                name:"Nomyen",                period:"13 – 18 Feb",       bg:"#C47A8A", desc:"Thai milk tea in cake form. The comfort of home in every soft, sweet, pink bite." },
  { slug:"cake-cube",             name:"Cake Cube",             period:"New Drop",          bg:"#1a1a1a", desc:"Our iconic flavors in a bold new format. A box of joy, available at select spots." },
  { slug:"banoffee",              name:"Banoffee",              period:"13 – 18 Feb",       bg:"#7A5820", desc:"Banana, toffee, cream — a British classic that never gets old. Pure comfort." },
  { slug:"thai-tea",              name:"Thai Tea",              period:"15 – 22 April",     bg:"#B04818", desc:"Bold, spiced, unmistakably Thai. A flavor that tells a whole story in every slice." },
  { slug:"crunchy-cake",          name:"Crunchy Cake",          period:"Limited",           bg:"#3A2010", desc:"Made with KitKat®. Crispy layers, chocolate drizzle — pure indulgence." },
];
---
<Base title="Bi-Weekly Flavors | Babycakes" description="Every two weeks, a new flavor drop. Follow the Babycakes bi-weekly rotation.">

<section class="bw-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-w au" style="width:fit-content;margin-bottom:1.5rem">Updated Every Two Weeks</div>
    <h1 class="lf bw-h1 au au-1">Bi-Weekly<br/>Flavors.</h1>
    <p class="bw-sub au au-2">A new flavor, a new story — every two weeks.<br/>This is the drop you don't want to miss.</p>
  </div>
</section>

<div class="mq">
  <div class="mq-track">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Cake Cube","Banoffee","Thai Tea","Crunchy Cake","feel good food","Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Cake Cube","Banoffee","Thai Tea","Crunchy Cake","feel good food"].map(t=>(
      <span class="mq-item">{t}<span class="mq-dot">✦</span></span>
    ))}
  </div>
</div>

<section class="sec">
  <div class="wrap">
    <div class="g3 journal">
      {posts.map((p,i)=>(
        <a href={"/bi-weekly/"+p.slug} class="jcard" style={"animation-delay:"+i*.05+"s"}>
          <div class="jimg" style={"background:"+p.bg}>
            <div class="jov"></div>
            <span class="lf jname">{p.name}</span>
          </div>
          <div class="jbody">
            <div class="jmeta">
              <span class="tag tag-y">bi-weekly</span>
              <span class="jper">{p.period}</span>
            </div>
            <h2 class="jtitle">{p.name}</h2>
            <p class="jdesc">{p.desc}</p>
            <span class="jmore">Read more →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
</Base>

<style>
.bw-hero { position:relative; background:var(--dark); padding:10rem var(--px) 6rem; overflow:hidden; }
.bw-h1 { font-size:clamp(4rem,12vw,9rem); color:var(--yellow); line-height:.9; letter-spacing:-.025em; margin-bottom:1.5rem; }
.bw-sub { color:rgba(251,245,171,.55); font-size:clamp(1rem,1.8vw,1.1rem); line-height:1.85; max-width:480px; }
.jcard { display:flex; flex-direction:column; border-radius:var(--r-md); overflow:hidden; background:var(--white); box-shadow:0 2px 20px rgba(76,67,120,.07); transition:transform .28s var(--ease),box-shadow .28s var(--ease); animation:fadeUp .6s var(--ease) both; text-decoration:none; color:inherit; }
.jcard:hover { transform:translateY(-6px); box-shadow:0 18px 52px rgba(76,67,120,.16); }
.jimg { position:relative; aspect-ratio:4/3; display:flex; align-items:flex-end; padding:1.5rem; overflow:hidden; }
.jov { position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.65) 0%,transparent 55%); }
.jname { position:relative; z-index:2; font-size:2rem; color:#fff; line-height:1.05; text-shadow:0 2px 16px rgba(0,0,0,.35); }
.jbody { padding:1.5rem 1.6rem 2rem; flex:1; display:flex; flex-direction:column; gap:0; }
.jmeta { display:flex; align-items:center; justify-content:space-between; margin-bottom:1rem; }
.jper { font-size:var(--text-xs); font-weight:700; color:var(--purple); letter-spacing:.04em; }
.jtitle { font-size:1.05rem; font-weight:900; color:var(--dark); margin-bottom:.6rem; line-height:1.3; }
.jdesc { font-size:var(--text-sm); color:var(--gray-3); line-height:1.75; flex:1; }
.jmore { margin-top:1.25rem; font-size:.78rem; font-weight:800; color:var(--purple); letter-spacing:.02em; }
</style>
