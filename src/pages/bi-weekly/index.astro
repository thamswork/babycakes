---
import Base from '../../layouts/Base.astro';
const posts = [
  { slug:"strawberry-kiss",      name:"Strawberry Kiss",       period:"17 Feb – 13 March", bg:"#5a1e2a", desc:"Layered sponge, fresh strawberry cream. The season's most romantic slice." },
  { slug:"dubai-chocolate",      name:"Dubai Chocolate",       period:"17 Feb – 13 March", bg:"#100704", desc:"Crispy knafeh, dark chocolate. A viral sensation, perfected." },
  { slug:"mayongchid",           name:"Mayongchid",            period:"11 – 17 April",     bg:"#6a4610", desc:"Thai mango custard. Seasonal, sun-golden, and gone before you know it." },
  { slug:"cheesecake-blueberry", name:"Cheesecake Blueberry",  period:"13 – 18 Feb",       bg:"#1c0e32", desc:"Velvety cheesecake meets jammy blueberry. A classic, perfected." },
  { slug:"nomyen",               name:"Nomyen",                period:"13 – 18 Feb",       bg:"#8a3050", desc:"Thai milk tea in cake form. Soft, sweet, and deeply comforting." },
  { slug:"cake-cube",            name:"Cake Cube",             period:"New Drop",          bg:"#141414", desc:"Our iconic flavors in a bold new individual format." },
  { slug:"banoffee",             name:"Banoffee",              period:"13 – 18 Feb",       bg:"#5c3c10", desc:"Banana, toffee, cream. A classic that never gets old." },
  { slug:"thai-tea",             name:"Thai Tea",              period:"15 – 22 April",     bg:"#7a2c0e", desc:"Bold, spiced, unmistakably Thai." },
  { slug:"crunchy-cake",         name:"Crunchy Cake",          period:"Limited",           bg:"#1e1008", desc:"Made with KitKat. Crispy layers, rich chocolate drizzle." },
];
---
<Base title="Bi-Weekly Flavors | Babycakes" description="Babycakes bi-weekly flavor drops — updated every two weeks.">

<section class="pg-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.5rem">Updated Every Two Weeks</div>
    <h1 class="lf pg-h1 au au1">Bi-Weekly<br/>Flavors.</h1>
    <p class="pg-sub au au2">A new flavor, a new story — every two weeks. Don't miss the drop.</p>
  </div>
</section>

<div class="mq">
  <div class="mq-t">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Cake Cube","Banoffee","Thai Tea","Crunchy Cake","feel good food","Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Cake Cube","Banoffee","Thai Tea","Crunchy Cake","feel good food"].map(t=>(
      <span class="mq-i">{t}<span class="mq-dot-el"></span></span>
    ))}
  </div>
</div>

<section class="sec">
  <div class="wrap">
    <!-- 2-col on mobile, 3-col on desktop -->
    <div class="bw-grid">
      {posts.map((p,i)=>(
        <a href={"/bi-weekly/"+p.slug} class="pc au" style={"animation-delay:"+i*.05+"s"}>
          <div class="pc-img" style={"aspect-ratio:3/4;background:linear-gradient(145deg,"+p.bg+","+p.bg+"99)"}>
            <div class="pc-ph">{p.name}</div>
            <!-- <img src={"/photos/"+p.slug+".jpg"} alt={p.name} /> -->
          </div>
          <div class="pc-body">
            <div class="pc-meta">
              <span class="tag tag-y">bi-weekly</span>
              <span class="pc-per">{p.period}</span>
            </div>
            <div class="lf pc-name">{p.name}</div>
            <p class="pc-desc">{p.desc}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
</Base>
<style>
.pg-hero { position:relative; background:var(--d); padding:clamp(8rem,14vw,11rem) var(--px) clamp(4rem,7vw,5.5rem); overflow:hidden; }
.pg-h1 { font-size:clamp(3rem,10vw,8rem); color:var(--y); line-height:.9; letter-spacing:-.025em; margin-bottom:1.25rem; }
.pg-sub { color:rgba(251,245,171,.45); font-size:clamp(.95rem,1.6vw,1.05rem); line-height:1.9; max-width:420px; }
/* 2-col mobile, 3-col desktop */
.bw-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap);
}
@media(min-width:900px) {
  .bw-grid { grid-template-columns: repeat(3, 1fr); }
}
</style>
