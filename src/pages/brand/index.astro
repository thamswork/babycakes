---
import Base from '../../layouts/Base.astro';
const values = [
  { t:"Warmth",         d:"Every cake carries the warmth of the person who made it. We do not rush. We do not cut corners.",      n:"01" },
  { t:"Intention",      d:"Nothing accidental, nothing rushed. Every recipe is deliberate — tested, refined, and made with purpose.", n:"02" },
  { t:"Heritage",       d:"Rooted in family tradition. Inspired by timeless recipes passed down through generations.",               n:"03" },
  { t:"Accessibility",  d:"Feel-good food for everyone. A great cake should not require a special occasion.",                        n:"04" },
];
const ms = [
  { y:"2021", e:"Founded",          d:"Started with three flavors and walk-in orders from a home kitchen in Bangna, Bangkok." },
  { y:"2022", e:"First pop-up",     d:"Launched at Refill Coffee. Sold out in 4 hours. Permanent HQ Bangna opened shortly after." },
  { y:"2023", e:"Bi-weekly model",  d:"Introduced the bi-weekly rotation — creating urgency, community, and loyal repeat customers." },
  { y:"2024", e:"Cake Cube drops",  d:"New product format and rapid branch expansion across Bangkok's major malls." },
  { y:"2025", e:"88K community",    d:"GrabFood and LINE ordering launched. Babycakes reaches every corner of Bangkok." },
  { y:"2026", e:"New brand system", d:"Full visual identity update. Building toward national expansion and a permanent flagship." },
];
const culture = [
  { t:"Monthly Tasting Table",  d:"Before each bi-weekly drop, the whole team tastes and votes on new recipes together." },
  { t:"Bake Together Days",     d:"Monthly sessions where anyone can bring a recipe idea. The best ones make it onto the next drop." },
  { t:"Learning Fridays",       d:"Last Friday each month — a guest chef or brand builder shares their craft with the team." },
  { t:"Birthday Cake Policy",   d:"Every team member gets a custom Babycakes on their birthday. Obviously." },
  { t:"Wellness Allowance",     d:"Monthly budget for gym, therapy, or massage — each person decides what they need." },
  { t:"Flexible Hours",         d:"We care about output, not clock-watching. Great work does not need to happen 9 to 5." },
];
---
<Base title="Brand | Babycakes" description="The Babycakes story — who we are, what we believe, and how we work.">

<section class="brand-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.75rem">Our Brand</div>
    <h1 class="lf bh-h1 au au1">The Babycakes<br/>Story.</h1>
    <p class="bh-sub au au2">Born from baby + cakes — a name rooted in love and care.<br/>Every cake tells a story. Here is ours.</p>
    <div class="bh-stats au au3">
      <div class="bh-stat"><strong class="lf">2021</strong><span>Founded</span></div>
      <div class="bh-stat"><strong class="lf">10</strong><span>Bangkok Branches</span></div>
      <div class="bh-stat"><strong class="lf">88K+</strong><span>Community</span></div>
      <div class="bh-stat"><strong class="lf">3.4M</strong><span>TikTok Likes</span></div>
    </div>
  </div>
</section>

<nav class="b-nav">
  <div class="wrap b-nav-in">
    <a href="#about">What is Babycakes</a>
    <a href="#values">What We Believe</a>
    <a href="#team">Team</a>
    <a href="#culture">Culture</a>
    <a href="#timeline">Journey</a>
  </div>
</nav>

<!-- ABOUT -->
<section class="sec" id="about">
  <div class="wrap">
    <div class="about-grid">
      <div>
        <span class="tag tag-o sh-eye">What is Babycakes</span>
        <h2 class="lf about-h2">Feel good food,<br/>baked with love.</h2>
        <p class="about-p">Babycakes was born from a simple belief: that food baked with love tastes different. We create cakes that are soft, nostalgic, and comforting — like a taste of home.</p>
        <p class="about-p">Every cake is crafted with warmth, intention, and heart — inspired by timeless family recipes passed down through generations. Classic recipes, reimagined for today.</p>
        <div class="about-links">
          <a href="/bi-weekly" class="btn btn-d btn-lg">See This Week's Flavors</a>
          <a href="/locations" class="btn btn-od btn-lg">Find a Branch</a>
        </div>
      </div>
      <div class="about-right">
        <div class="about-quote">
          <span class="aq-mark">&ldquo;</span>
          <p class="aq-text">Born from a love of home baking and a vision to make feel-good food accessible to everyone.</p>
          <span class="aq-credit">Founder, Babycakes Bangkok</span>
        </div>
        <div class="about-nums">
          <div><strong class="lf">160&thinsp;&#3647;</strong><span>Starting Price</span></div>
          <div><strong class="lf">10</strong><span>Locations</span></div>
          <div><strong class="lf">Weekly</strong><span>New Flavors</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- VALUES -->
<section class="sec" id="values" style="background:var(--off)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-o sh-eye">What We Believe</span>
        <h2 class="lf sh-h">The principles behind<br/>every cake.</h2>
      </div>
    </div>
    <div class="g4">
      {values.map((v, i) => (
        <div class="val-card au" style={"animation-delay:" + (i * 0.08) + "s"}>
          <span class="val-n">{v.n}</span>
          <h3 class="val-t">{v.t}</h3>
          <p class="val-d">{v.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TEAM -->
<section class="sec" id="team" style="background:var(--dk)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-y sh-eye">Our Team</span>
        <h2 class="lf sh-h" style="color:var(--y)">The people who<br/>make it happen.</h2>
      </div>
      <a href="/careers" class="btn btn-y btn-lg">Join the Team</a>
    </div>
    <div class="founder-card">
      <div class="founder-initial">B</div>
      <div>
        <span class="tag tag-ow" style="margin-bottom:1.5rem">Founder</span>
        <h3 class="lf founder-name">The Founder</h3>
        <span class="founder-role">Founder &amp; Creative Director</span>
        <p class="founder-bio">The creative force behind Babycakes — leading brand vision, recipe direction, and everything that makes Babycakes feel like Babycakes. Started from a home kitchen in Bangna in 2021. Now Bangkok's most-loved tray cake brand with 10 branches and a community of 88K+.</p>
        <div class="founder-stats">
          <div><strong class="lf">2021</strong><span>Founded</span></div>
          <div><strong class="lf">10</strong><span>Branches</span></div>
          <div><strong class="lf">88K+</strong><span>Community</span></div>
        </div>
      </div>
    </div>
    <div class="team-note">
      <p>Our full team — kitchen, marketing, operations, and delivery — is the engine behind every bi-weekly drop and every perfectly timed order. We are growing. Come work with us.</p>
      <a href="/careers" class="btn btn-y btn-sm" style="margin-top:1.75rem;display:inline-flex">See Open Roles</a>
    </div>
  </div>
</section>

<!-- CULTURE -->
<section class="sec" id="culture" style="background:var(--y)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-d sh-eye">Culture &amp; HR</span>
        <h2 class="lf sh-h" style="color:var(--d)">How we work<br/>together.</h2>
      </div>
      <a href="/careers" class="btn btn-d btn-lg">Join the Team</a>
    </div>
    <div class="g3">
      {culture.map((c, i) => (
        <div class="cult-card au" style={"animation-delay:" + (i * 0.07) + "s"}>
          <h3 class="cult-t">{c.t}</h3>
          <p class="cult-d">{c.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- TIMELINE -->
<section class="sec" id="timeline">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-o sh-eye">Our Journey</span>
        <h2 class="lf sh-h">From home kitchen<br/>to Bangkok staple.</h2>
      </div>
    </div>
    <div class="tl">
      {ms.map((m, i) => (
        <div class={"tl-row au" + (i === ms.length - 1 ? " tl-last" : "")} style={"animation-delay:" + (i * 0.07) + "s"}>
          <span class="lf tl-y">{m.y}</span>
          <div class="tl-connector">
            <div class="tl-dot"></div>
            <div class="tl-line"></div>
          </div>
          <div class="tl-body">
            <h3 class="tl-e">{m.e}</h3>
            <p class="tl-d">{m.d}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec-sm" style="background:var(--d)">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap">
    <div>
      <h3 class="lf" style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--y);line-height:1.1">Want to be part of this?</h3>
      <p style="color:rgba(251,245,171,0.4);margin-top:0.6rem;font-size:0.9rem;line-height:1.75;max-width:340px">Growing fast. Always open to the right people and partnerships.</p>
    </div>
    <div style="display:flex;gap:1rem;flex-wrap:wrap">
      <a href="/careers" class="btn btn-y btn-lg">See Open Roles</a>
      <a href="mailto:hello@babycakes.th" class="btn btn-ow btn-lg">Say Hello</a>
    </div>
  </div>
</section>

</Base>
<style>
.brand-hero { position:relative; background:var(--d); padding:10rem var(--px) 5.5rem; overflow:hidden; }
.bh-h1 { font-size:clamp(3.25rem,9vw,7.5rem); color:var(--y); line-height:0.9; letter-spacing:-0.025em; margin-bottom:1.5rem; }
.bh-sub { color:rgba(251,245,171,0.45); font-size:clamp(0.95rem,1.6vw,1.05rem); line-height:1.9; max-width:480px; margin-bottom:3rem; }
.bh-stats { display:flex; flex-wrap:wrap; border:1px solid rgba(251,245,171,0.1); border-radius:var(--rm); overflow:hidden; width:fit-content; }
.bh-stat { padding:1.35rem 2.5rem; border-right:1px solid rgba(251,245,171,0.1); display:flex; flex-direction:column; gap:0.3rem; }
.bh-stat:last-child { border-right:none; }
.bh-stat strong { font-size:1.75rem; color:var(--y); line-height:1; }
.bh-stat span { font-size:0.62rem; font-weight:500; letter-spacing:0.1em; text-transform:uppercase; color:rgba(251,245,171,0.28); }
@media(max-width:540px) { .bh-stats{width:100%} .bh-stat{border-right:none;border-bottom:1px solid rgba(251,245,171,0.1)} .bh-stat:last-child{border-bottom:none} }

.b-nav { background:var(--w); border-bottom:1px solid var(--g1); position:sticky; top:67px; z-index:400; }
.b-nav-in { display:flex; gap:2.5rem; padding-block:1rem; max-width:var(--mx); margin-inline:auto; padding-inline:var(--px); overflow-x:auto; scrollbar-width:none; white-space:nowrap; }
.b-nav-in::-webkit-scrollbar { display:none; }
.b-nav a { font-size:0.7rem; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; color:var(--g3); transition:color 0.15s; padding-block:0.25rem; border-bottom:2px solid transparent; transition:color 0.15s, border-color 0.15s; }
.b-nav a:hover { color:var(--d); border-bottom-color:var(--d); }

.about-grid { display:grid; grid-template-columns:1fr 1fr; gap:clamp(4rem,8vw,9rem); align-items:start; }
.about-h2 { font-size:clamp(2.5rem,5vw,4rem); color:var(--d); line-height:1.02; margin-top:1rem; margin-bottom:1.75rem; }
.about-p { font-size:1rem; line-height:1.9; color:var(--d); opacity:0.7; }
.about-p + .about-p { margin-top:1.25rem; }
.about-links { display:flex; gap:1rem; flex-wrap:wrap; margin-top:2.5rem; }
.about-right { display:flex; flex-direction:column; gap:2rem; }
.about-quote { background:var(--off); border-left:3px solid var(--d); padding:2.25rem 2.25rem 2.25rem 2.5rem; border-radius:0 var(--rm) var(--rm) 0; }
.aq-mark { font-family:'Shrikhand',serif; font-size:3.5rem; color:var(--y); line-height:0.75; display:block; margin-bottom:1rem; }
.aq-text { font-size:1.05rem; line-height:1.85; color:var(--d); font-style:italic; margin-bottom:1rem; }
.aq-credit { font-size:0.72rem; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; color:var(--g3); }
.about-nums { display:flex; gap:2.5rem; padding:1.75rem 0; border-top:1px solid var(--g1); flex-wrap:wrap; }
.about-nums div { display:flex; flex-direction:column; gap:0.3rem; }
.about-nums strong { font-family:'Shrikhand',serif; font-size:1.875rem; color:var(--d); line-height:1; }
.about-nums span { font-size:0.65rem; font-weight:500; letter-spacing:0.09em; text-transform:uppercase; color:var(--pm); }
@media(max-width:768px) { .about-grid{grid-template-columns:1fr} }

.val-card { background:var(--w); border:1px solid var(--g1); border-radius:var(--rm); padding:2.25rem 2rem; animation:fadeUp 0.65s var(--ease) both; }
.val-n { font-size:0.62rem; font-weight:600; letter-spacing:0.1em; color:var(--pm); display:block; margin-bottom:1.25rem; }
.val-t { font-size:1rem; font-weight:600; color:var(--d); margin-bottom:0.75rem; }
.val-d { font-size:0.875rem; color:var(--g3); line-height:1.8; }

.founder-card { display:grid; grid-template-columns:160px 1fr; gap:3.5rem; align-items:start; background:rgba(255,255,255,0.04); border:1px solid rgba(251,245,171,0.08); border-radius:var(--rl); padding:3rem 3.5rem; margin-bottom:1.75rem; }
.founder-initial { width:120px; height:120px; border-radius:var(--rm); background:var(--y); display:flex; align-items:center; justify-content:center; font-family:'Shrikhand',serif; font-size:3.5rem; color:var(--d); flex-shrink:0; }
.founder-name { font-family:'Shrikhand',serif; font-size:2rem; color:var(--y); margin-bottom:0.35rem; line-height:1; }
.founder-role { display:block; font-size:0.68rem; font-weight:500; letter-spacing:0.1em; text-transform:uppercase; color:var(--pm); margin-bottom:1.25rem; }
.founder-bio { font-size:0.9rem; color:rgba(251,245,171,0.5); line-height:1.9; max-width:520px; }
.founder-stats { display:flex; gap:3rem; margin-top:2rem; padding-top:2rem; border-top:1px solid rgba(251,245,171,0.08); flex-wrap:wrap; }
.founder-stats div { display:flex; flex-direction:column; gap:0.3rem; }
.founder-stats strong { font-family:'Shrikhand',serif; font-size:1.5rem; color:var(--y); line-height:1; }
.founder-stats span { font-size:0.62rem; font-weight:500; letter-spacing:0.09em; text-transform:uppercase; color:rgba(251,245,171,0.28); }
.team-note { background:rgba(255,255,255,0.04); border:1px solid rgba(251,245,171,0.07); border-radius:var(--rm); padding:2.5rem 3rem; }
.team-note p { font-size:0.95rem; color:rgba(251,245,171,0.45); line-height:1.9; max-width:580px; }
@media(max-width:600px) { .founder-card{grid-template-columns:1fr;padding:2rem} .founder-initial{width:90px;height:90px;font-size:2.5rem} }

.cult-card { background:rgba(76,67,120,0.07); border:1px solid rgba(76,67,120,0.1); border-radius:var(--rm); padding:2.25rem 2rem; animation:fadeUp 0.65s var(--ease) both; }
.cult-t { font-size:1rem; font-weight:600; color:var(--d); margin-bottom:0.75rem; }
.cult-d { font-size:0.875rem; color:var(--d); opacity:0.62; line-height:1.8; }

.tl { display:flex; flex-direction:column; }
.tl-row { display:grid; grid-template-columns:80px 32px 1fr; gap:2rem; }
.tl-y { font-size:1.2rem; color:var(--pm); line-height:1; padding-top:0.35rem; text-align:right; }
.tl-connector { display:flex; flex-direction:column; align-items:center; padding-top:0.4rem; }
.tl-dot { width:12px; height:12px; border-radius:50%; background:var(--y); border:2.5px solid var(--d); flex-shrink:0; box-shadow:0 0 0 4px rgba(159,151,194,0.15); }
.tl-line { flex:1; width:2px; background:var(--g1); margin-top:8px; min-height:3rem; }
.tl-last .tl-line { display:none; }
.tl-body { padding-bottom:3rem; }
.tl-last .tl-body { padding-bottom:0; }
.tl-e { font-size:1rem; font-weight:600; color:var(--d); margin-bottom:0.4rem; }
.tl-d { font-size:0.875rem; color:var(--g3); line-height:1.8; }
@media(max-width:500px) { .tl-row{grid-template-columns:56px 24px 1fr;gap:1rem} .tl-y{font-size:0.95rem} }
</style>
