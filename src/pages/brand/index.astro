---
import Base from '../../layouts/Base.astro';
const founders = [
  {
    slug: "nile",
    name: "Pasiri",
    nickname: "Nile",
    surname: "Tangkaravakun",
    role: "Co-founder & Brand Architect",
    bg: "#2e1848",
    bio: [
      "The creative engine behind the Babycakes aesthetic. Nile pioneered the brand's Handwritten Messaging concept — transforming the tray cake from a food item into a communication tool, specifically targeting Gen Z's desire for shareable, meaningful moments.",
      "The Soft Chocolate Baby Tray is built on a recipe from Nile's mother, made in 1999. She guards it personally to ensure quality never changes as the brand scales."
    ],
    stats: [
      { n:"1999", l:"Original recipe" },
      { n:"Chula", l:"Chulalongkorn Univ." },
      { n:"Brand", l:"Creative direction" },
    ]
  },
  {
    slug: "tess",
    name: "Natnicha",
    nickname: "Tess",
    surname: "Burapachaisri",
    role: "Co-founder & Business Lead",
    bg: "#142040",
    bio: [
      "The operational architect behind Babycakes' explosive growth. Tess applies the rigor she learned at Chanel to the bakery's backend — transforming a backyard kitchen into a centralized operation capable of handling seven-figure monthly revenue.",
      "She leads expansion into prime real estate like One Bangkok, Emsphere, and Central Chidlom, and manages the logistical complexities of 12+ distribution points."
    ],
    stats: [
      { n:"Columbia", l:"Economics" },
      { n:"Chanel", l:"Luxury background" },
      { n:"Ops", l:"Scaling & systems" },
    ]
  }
];
const ms = [
  { y:"2021", e:"Founded from home",      d:"Started with three flavors and word-of-mouth orders from a home kitchen in Bangna, Bangkok." },
  { y:"2022", e:"First pop-up & HQ",      d:"Launched at Refill Coffee. Sold out in 4 hours. Permanent HQ Bangna opened shortly after." },
  { y:"2023", e:"Bi-weekly model",         d:"Introduced the rotating flavor drop — creating urgency, community, and loyal repeat customers." },
  { y:"2024", e:"12+ locations",           d:"Expanded into One Bangkok, Emsphere, Siam Paragon, Central Chidlom, and more." },
  { y:"2025", e:"฿1M+ peak revenue",       d:"Peak monthly sales of ฿1M+ during Valentine's and Christmas. GrabFood and LINE MAN integrated." },
  { y:"2026", e:"Lifestyle brand",         d:"New brand system launched. Building toward product diversification, regional reach, and flagship store." },
];
const culture = [
  { t:"Monthly Tasting Table",  d:"Before each bi-weekly drop, the whole team tastes and votes on new recipes together." },
  { t:"Bake Together Days",     d:"Anyone can bring a recipe idea. The best ones make it onto the next drop." },
  { t:"Learning Fridays",       d:"Last Friday each month — a guest chef, designer, or brand builder shares their craft." },
  { t:"Birthday Cake Policy",   d:"Every team member gets a custom Babycakes on their birthday. Obviously." },
  { t:"Wellness Allowance",     d:"Monthly budget for gym, therapy, or massage — each person decides." },
  { t:"Flexible Hours",         d:"We care about output, not clock-watching." },
];
---
<Base title="Brand | Babycakes" description="The Babycakes story — two founders, one 1999 recipe, and Bangkok's most-loved tray cake.">

<!-- HERO -->
<section class="brand-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.5rem">Our Brand</div>
    <h1 class="lf bh-h1 au au1">The Babycakes<br/>Story.</h1>
    <p class="bh-sub au au2">A 1999 family recipe. A home kitchen in Bangna. Two founders who believed food baked with love tastes different.</p>
    <div class="bh-stats au au3">
      <div class="bh-s"><strong class="lf">2021</strong><span>Founded</span></div>
      <div class="bh-s"><strong class="lf">12+</strong><span>Locations</span></div>
      <div class="bh-s"><strong class="lf">฿1M+</strong><span>Peak monthly</span></div>
      <div class="bh-s"><strong class="lf">3.4M</strong><span>TikTok likes</span></div>
    </div>
  </div>
</section>

<!-- SUBNAV -->
<nav class="b-nav">
  <div class="wrap b-nav-in">
    <a href="#story">Story</a>
    <a href="#founders">Founders</a>
    <a href="#timeline">Timeline</a>
    <a href="#culture">Culture</a>
    <a href="#collabs">Collabs</a>
  </div>
</nav>

<!-- STORY — full bleed image + text -->
<section class="sec" id="story">
  <div class="wrap">
    <div class="story-g">
      <div>
        <span class="tag tag-o sh-eye">What is Babycakes</span>
        <h2 class="lf" style="font-size:clamp(2rem,4.5vw,3.5rem);color:var(--d);line-height:1.02;margin-top:0.75rem;margin-bottom:1.5rem">Feel good food,<br/>baked with love.</h2>
        <p class="story-bp">Babycakes was born from a simple belief: that food baked with love tastes different. The brand sits in the "Affordable Luxury" niche — more premium than street bakeries, more personal than hotel patisseries.</p>
        <p class="story-bp">The Soft Chocolate Baby Tray — built on Nile's mother's 1999 recipe — remains the primary revenue driver. Every product is crafted to be a "small gesture" gift, priced to encourage impulse buying and frequent sharing.</p>
        <div class="story-links">
          <a href="/bi-weekly" class="btn btn-d btn-lg">See This Week's Drop</a>
          <a href="/locations" class="btn btn-od btn-lg">Find a Branch</a>
        </div>
      </div>
      <!-- History photo: first store -->
      <div class="story-imgcol">
        <div class="story-img-wrap">
          <div class="story-img-ph">
            <!-- <img src="refill-coffee-popup.jpg" alt="First Babycakes pop-up at Refill Coffee, 2022" /> -->
            <span>First pop-up photo<br/>Refill Coffee, 2022</span>
          </div>
          <div class="story-img-caption">
            <span class="lf sic-year">2022</span>
            <p>First pop-up at Refill Coffee, Bangna — sold out in 4 hours.</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FOUNDERS — full bleed each, alternating -->
<section id="founders">
  {founders.map((f, fi) => (
    <div class={"founder-block" + (fi % 2 === 1 ? " founder-block-rev" : "")}>
      <!-- Photo column -->
      <div class="founder-photo-col" style={"background:"+f.bg}>
        <!-- <img src={"founder-"+f.slug+".jpg"} alt={f.name+" "+f.surname+", "+f.role} /> -->
        <div class="founder-ph">
          <span>Photo of {f.nickname}</span>
        </div>
        <div class="founder-photo-tag">{f.nickname}</div>
      </div>
      <!-- Text column -->
      <div class="founder-text-col">
        <span class="tag tag-d sh-eye">Co-founder</span>
        <h2 class="lf founder-nm">{f.nickname}.</h2>
        <p class="founder-full">{f.name} {f.surname}</p>
        <p class="founder-role-label">{f.role}</p>
        {f.bio.map(b => <p class="founder-bio">{b}</p>)}
        <div class="founder-stats">
          {f.stats.map(s => (
            <div><strong class="lf">{s.n}</strong><span>{s.l}</span></div>
          ))}
        </div>
      </div>
    </div>
  ))}
</section>

<!-- TIMELINE — photo-led -->
<section class="sec" id="timeline">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-o sh-eye">Our Journey</span>
        <h2 class="lf sh-h">From home kitchen<br/>to Bangkok staple.</h2>
      </div>
    </div>
    <div class="tl">
      {ms.map((m, i) => (
        <div class={"tl-row au" + (i === ms.length - 1 ? " tl-last" : "")} style={"animation-delay:" + (i * 0.07) + "s"}>
          <span class="lf tl-y">{m.y}</span>
          <div class="tl-conn"><div class="tl-dot"></div><div class="tl-line"></div></div>
          <div class="tl-body">
            <!-- Photo slot for each milestone -->
            <div class="tl-img-wrap">
              <div class="tl-img-ph">Photo</div>
              <!-- <img src={"timeline-"+m.y+".jpg"} alt={m.e} /> -->
            </div>
            <h3 class="tl-e">{m.e}</h3>
            <p class="tl-d">{m.d}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CULTURE -->
<section class="sec" id="culture" style="background:var(--y)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-d sh-eye">Culture &amp; HR</span>
        <h2 class="lf sh-h" style="color:var(--d)">How we work<br/>together.</h2>
      </div>
      <a href="/careers" class="btn btn-d btn-lg">Join the Team</a>
    </div>
    <div class="g3">
      {culture.map((c,i) => (
        <div class="cult-card au" style={"animation-delay:"+(i*0.07)+"s"}>
          <h3 class="cult-t">{c.t}</h3>
          <p class="cult-d">{c.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- COLLABS anchor -->
<section class="sec-sm sec-cr" id="collabs">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-line sh-eye">Partners &amp; Collaborations</span>
        <h2 class="lf sh-h">The brands we work with.</h2>
      </div>
      <a href="/collabs" class="btn btn-od">See All Collabs</a>
    </div>
    <div class="collab-logos">
      {["Refill Coffee","KitKat®","Only Grab","LINE MAN","Homeland"].map(b => (
        <div class="collab-logo-ph">{b}</div>
      ))}
    </div>
    <p style="margin-top:1.5rem;font-size:0.82rem;color:var(--g3)">Want to collaborate? <a href="mailto:hello@babycakes.th" style="color:var(--d);font-weight:600;text-decoration:underline;text-underline-offset:3px">Get in touch →</a></p>
  </div>
</section>

<!-- CTA -->
<section class="sec-sm" style="background:var(--d)">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap">
    <div>
      <h3 class="lf" style="font-size:clamp(1.5rem,3.5vw,2.5rem);color:var(--y);line-height:1.1">Want to be part of this?</h3>
      <p style="color:rgba(251,245,171,0.38);margin-top:0.5rem;font-size:0.875rem;line-height:1.75;max-width:340px">Growing fast. Open to the right people and partnerships.</p>
    </div>
    <div style="display:flex;gap:0.875rem;flex-wrap:wrap">
      <a href="/careers" class="btn btn-y btn-lg">See Open Roles</a>
      <a href="mailto:hello@babycakes.th" class="btn btn-ow btn-lg">Say Hello</a>
    </div>
  </div>
</section>
</Base>
<style>
.brand-hero { position:relative; background:var(--d); padding:clamp(8rem,15vw,12rem) var(--px) clamp(4rem,8vw,6rem); overflow:hidden; }
.bh-h1 { font-size:clamp(3rem,9vw,7.5rem); color:var(--y); line-height:0.9; letter-spacing:-0.025em; margin-bottom:clamp(1rem,2.5vw,1.5rem); }
.bh-sub { color:rgba(251,245,171,0.45); font-size:clamp(0.95rem,1.7vw,1.1rem); line-height:1.9; max-width:520px; margin-bottom:clamp(2rem,4vw,3rem); }
.bh-stats { display:flex; flex-wrap:wrap; border:1px solid rgba(251,245,171,0.1); border-radius:var(--rm); overflow:hidden; width:fit-content; }
.bh-s { padding:clamp(1rem,2vw,1.35rem) clamp(1.25rem,3vw,2.5rem); border-right:1px solid rgba(251,245,171,0.1); display:flex; flex-direction:column; gap:0.28rem; }
.bh-s:last-child { border-right:none; }
.bh-s strong { font-size:clamp(1.25rem,3vw,1.75rem); color:var(--y); line-height:1; }
.bh-s span { font-size:0.58rem; font-weight:500; letter-spacing:0.1em; text-transform:uppercase; color:rgba(251,245,171,0.26); }
@media(max-width:480px) { .bh-stats{width:100%} .bh-s{border-right:none;border-bottom:1px solid rgba(251,245,171,0.1)} .bh-s:last-child{border-bottom:none} }

.b-nav { background:var(--w); border-bottom:1px solid var(--g1); position:sticky; top:var(--nav-h); z-index:400; }
.b-nav-in { display:flex; gap:clamp(1.5rem,3vw,2.5rem); padding-block:0.9rem; max-width:var(--mx); margin-inline:auto; padding-inline:var(--px); overflow-x:auto; scrollbar-width:none; white-space:nowrap; -webkit-overflow-scrolling:touch; }
.b-nav-in::-webkit-scrollbar { display:none; }
.b-nav a { font-size:0.68rem; font-weight:500; letter-spacing:0.08em; text-transform:uppercase; color:var(--g3); transition:color 0.15s,border-color 0.15s; padding-block:0.2rem; border-bottom:2px solid transparent; flex-shrink:0; }
.b-nav a:hover { color:var(--d); border-bottom-color:var(--d); }

/* STORY */
.story-g { display:grid; grid-template-columns:1fr 1fr; gap:clamp(3rem,7vw,8rem); align-items:start; }
.story-bp { font-size:1rem; line-height:1.9; color:var(--d); opacity:0.7; }
.story-bp+.story-bp { margin-top:1.1rem; }
.story-links { display:flex; gap:0.875rem; flex-wrap:wrap; margin-top:2.25rem; }
.story-imgcol { display:flex; flex-direction:column; gap:1.25rem; }
.story-img-wrap { display:flex; flex-direction:column; gap:0.875rem; }
.story-img-ph { aspect-ratio:4/3; border-radius:var(--rm); background:var(--d); display:flex; align-items:center; justify-content:center; overflow:hidden; }
.story-img-ph span { font-size:0.65rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:rgba(255,255,255,0.18); text-align:center; padding:1.5rem; }
.story-img-caption { display:flex; gap:1rem; align-items:flex-start; }
.sic-year { font-size:2rem; color:var(--d); line-height:1; flex-shrink:0; }
.story-img-caption p { font-size:0.82rem; color:var(--g3); line-height:1.65; padding-top:0.35rem; }
@media(max-width:768px) { .story-g{grid-template-columns:1fr} .story-links{flex-direction:column} .story-links .btn{width:100%;text-align:center} }

/* FOUNDERS */
.founder-block { display:grid; grid-template-columns:1fr 1fr; min-height:clamp(520px,70vw,800px); }
.founder-block-rev { direction:rtl; }
.founder-block-rev > * { direction:ltr; }
.founder-photo-col { position:relative; overflow:hidden; }
.founder-ph { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; }
.founder-ph span { font-size:0.65rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:rgba(251,245,171,0.2); text-align:center; padding:2rem; }
.founder-photo-tag { position:absolute; bottom:1.75rem; left:1.75rem; font-family:'Shrikhand',serif; font-size:2.5rem; color:rgba(255,255,255,0.15); z-index:2; line-height:1; }
.founder-text-col { display:flex; flex-direction:column; justify-content:center; padding:clamp(3rem,6vw,6rem) clamp(2rem,5vw,5.5rem); background:var(--cr); }
.founder-nm { font-family:'Shrikhand',serif; font-size:clamp(2.5rem,5vw,4.5rem); color:var(--d); line-height:1; margin-bottom:0.25rem; }
.founder-full { font-size:0.78rem; font-weight:500; letter-spacing:0.04em; color:var(--g3); margin-bottom:0.2rem; }
.founder-role-label { font-size:0.7rem; font-weight:600; letter-spacing:0.09em; text-transform:uppercase; color:var(--pm); margin-bottom:1.5rem; }
.founder-bio { font-size:0.95rem; line-height:1.9; color:var(--d); opacity:0.7; }
.founder-bio+.founder-bio { margin-top:1rem; }
.founder-stats { display:flex; gap:2.5rem; margin-top:2rem; padding-top:2rem; border-top:1.5px solid var(--g1); flex-wrap:wrap; }
.founder-stats div { display:flex; flex-direction:column; gap:0.3rem; }
.founder-stats strong { font-family:'Shrikhand',serif; font-size:1.5rem; color:var(--d); line-height:1; }
.founder-stats span { font-size:0.6rem; font-weight:600; letter-spacing:0.09em; text-transform:uppercase; color:var(--pm); }
@media(max-width:768px) { .founder-block,.founder-block-rev{grid-template-columns:1fr;direction:ltr;min-height:auto} .founder-photo-col{height:clamp(280px,55vw,440px)} .founder-text-col{padding:clamp(2.5rem,7vw,4rem) var(--px)} }

/* TIMELINE */
.tl { display:flex; flex-direction:column; }
.tl-row { display:grid; grid-template-columns:clamp(52px,8vw,80px) 28px 1fr; gap:clamp(1rem,2.5vw,2rem); }
.tl-y { font-size:clamp(1rem,2vw,1.2rem); color:var(--pm); line-height:1; padding-top:0.35rem; text-align:right; }
.tl-conn { display:flex; flex-direction:column; align-items:center; padding-top:0.4rem; }
.tl-dot { width:11px; height:11px; border-radius:50%; background:var(--y); border:2.5px solid var(--d); flex-shrink:0; box-shadow:0 0 0 4px rgba(159,151,194,0.14); }
.tl-line { flex:1; width:2px; background:var(--g1); margin-top:7px; min-height:2.5rem; }
.tl-last .tl-line { display:none; }
.tl-body { padding-bottom:clamp(2rem,4vw,3rem); display:flex; flex-direction:column; gap:0.75rem; }
.tl-last .tl-body { padding-bottom:0; }
/* Timeline photo slot */
.tl-img-wrap { aspect-ratio:16/7; border-radius:var(--rm); overflow:hidden; background:var(--g1); }
.tl-img-ph { width:100%; height:100%; display:flex; align-items:center; justify-content:center; font-size:0.6rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:var(--g3); }
.tl-e { font-size:1rem; font-weight:600; color:var(--d); }
.tl-d { font-size:0.875rem; color:var(--g3); line-height:1.8; }

/* CULTURE */
.cult-card { background:rgba(76,67,120,0.07); border:1px solid rgba(76,67,120,0.1); border-radius:var(--rm); padding:clamp(1.5rem,3vw,2.25rem) clamp(1.25rem,2.5vw,2rem); animation:fadeUp 0.65s var(--ease) both; }
.cult-t { font-size:1rem; font-weight:600; color:var(--d); margin-bottom:0.75rem; }
.cult-d { font-size:0.875rem; color:var(--d); opacity:0.62; line-height:1.8; }

/* COLLABS */
.collab-logos { display:flex; align-items:center; gap:1.25rem; flex-wrap:wrap; }
.collab-logo-ph { height:44px; padding:0 1.5rem; background:var(--w); border:1px solid var(--g1); border-radius:var(--rm); display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:600; color:var(--g3); white-space:nowrap; }
</style>
