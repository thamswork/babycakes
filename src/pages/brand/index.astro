---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

// Load all brand JSON files
const brandFiles = await getCollection('brand');

const getFile = (id: string) => brandFiles.find(f => f.id === id)?.data ?? {};

const hero      = getFile('hero') as any;
const story     = getFile('story') as any;
const timeline  = getFile('timeline') as any;
const founderNile = getFile('founder-nile') as any;
const founderTess = getFile('founder-tess') as any;
const founders  = [founderNile, founderTess].sort((a,b)=>(a.order||0)-(b.order||0));

const culture = [
  { t:"Monthly Tasting Table",  d:"Before each bi-weekly drop, the whole team tastes and votes on new recipes." },
  { t:"Bake Together Days",     d:"Anyone can bring a recipe idea. The best ones make it onto the next drop." },
  { t:"Learning Fridays",       d:"Last Friday each month — a guest chef or brand builder shares their craft." },
  { t:"Birthday Cake Policy",   d:"Every team member gets a custom Babycakes on their birthday. Obviously." },
  { t:"Wellness Allowance",     d:"Monthly budget for gym, therapy, or massage — each person decides." },
  { t:"Flexible Hours",         d:"We care about output, not clock-watching." },
];

const ms = timeline.items ?? [];
const lastIdx = ms.length - 1;
---
<Base title="Brand | Babycakes" description="The Babycakes story — two founders, one 1999 recipe, Bangkok's most-loved tray cake.">

<!-- HERO -->
<section class="brand-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.5rem">{hero.tagline ?? 'Our Brand'}</div>
    <h1 class="lf bh-h1 au au1">{hero.headline_1 ?? 'The Babycakes'}<br/>{hero.headline_2 ?? 'Story.'}</h1>
    <p class="bh-sub au au2">{hero.subheading}</p>
    <div class="bh-stats au au3">
      <div class="bh-s"><strong class="lf">{hero.stat_1_value}</strong><span>{hero.stat_1_label}</span></div>
      <div class="bh-s"><strong class="lf">{hero.stat_2_value}</strong><span>{hero.stat_2_label}</span></div>
      <div class="bh-s"><strong class="lf">{hero.stat_3_value}</strong><span>{hero.stat_3_label}</span></div>
      <div class="bh-s"><strong class="lf">{hero.stat_4_value}</strong><span>{hero.stat_4_label}</span></div>
    </div>
  </div>
</section>

<!-- SUBNAV -->
<nav class="b-nav">
  <div class="wrap b-nav-in">
    <a href="#story">Story</a>
    <a href="#founders">Founders</a>
    <a href="#timeline">Timeline</a>
    <a href="#culture">Culture</a>
  </div>
</nav>

<!-- STORY -->
<section class="sec" id="story">
  <div class="wrap">
    <div class="story-g">
      <div>
        <span class="tag tag-p sh-eye">What is Babycakes</span>
        <h2 class="lf" style="font-size:clamp(2rem,4.5vw,3.5rem);color:var(--d);line-height:1.02;margin-top:.75rem;margin-bottom:1.75rem">
          {story.headline ?? 'Feel good food, baked with love.'}
        </h2>
        <p class="sbp">{story.body_1}</p>
        <p class="sbp">{story.body_2}</p>
        <div class="story-links">
          <a href="/bi-weekly" class="btn btn-d btn-lg">This Week's Drop</a>
          <a href="/locations" class="btn btn-op btn-lg">Find a Branch</a>
        </div>
      </div>
      <div>
        <div class="story-img">
          {story.popup_photo
            ? <img src={story.popup_photo} alt={"Babycakes " + (story.popup_year ?? '')} />
            : <div class="story-img-ph"><span>First pop-up photo<br/>{story.popup_year}</span></div>
          }
        </div>
        <div class="story-cap">
          <span class="lf story-cap-y">{story.popup_year ?? '2022'}</span>
          <p>{story.popup_caption}</p>
        </div>
        <div class="story-nums">
          <div><strong class="lf">{story.stat_price}</strong><span>{story.stat_price_label}</span></div>
          <div><strong class="lf">{story.stat_locations}</strong><span>{story.stat_locations_label}</span></div>
          <div><strong class="lf">{story.stat_rhythm}</strong><span>{story.stat_rhythm_label}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- FOUNDERS -->
<div id="founders">
  {founders.map((f: any, fi: number) => (
    <section class={"founder-sec" + (fi % 2 === 1 ? " founder-sec-r" : "")}>
      <div class="founder-photo" style={"background:" + (f.bg_color ?? '#2a1640')}>
        {f.photo
          ? <img src={f.photo} alt={f.full_name + ", " + f.role} style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover" />
          : <div class="founder-ph"><span>Photo of {f.nickname}</span></div>
        }
        <div class="founder-watermark lf">{f.nickname}</div>
      </div>
      <div class="founder-txt">
        <span class="tag tag-p sh-eye">Co-founder</span>
        <h2 class="lf founder-nm">{f.nickname}.</h2>
        <p class="founder-full-name">{f.full_name}</p>
        <p class="founder-role-lbl">{f.role}</p>
        <p class="founder-bio">{f.bio_1}</p>
        {f.bio_2 && <p class="founder-bio">{f.bio_2}</p>}
        <div class="founder-stats">
          <div><strong class="lf">{f.stat_1_value}</strong><span>{f.stat_1_label}</span></div>
          <div><strong class="lf">{f.stat_2_value}</strong><span>{f.stat_2_label}</span></div>
          <div><strong class="lf">{f.stat_3_value}</strong><span>{f.stat_3_label}</span></div>
        </div>
      </div>
    </section>
  ))}
</div>

<!-- TIMELINE -->
<section class="sec" id="timeline">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-p sh-eye">Our Journey</span>
        <h2 class="lf sh-h">From home kitchen<br/>to Bangkok staple.</h2>
      </div>
    </div>
    <div class="tl">
      {ms.map((m: any, i: number) => (
        <div class={"tl-row au" + (i === lastIdx ? " tl-last" : "")} style={"animation-delay:" + (i * .07) + "s"}>
          <span class="lf tl-y">{m.year}</span>
          <div class="tl-conn"><div class="tl-dot"></div><div class="tl-line"></div></div>
          <div class="tl-body">
            {m.photo
              ? <div class="tl-img"><img src={m.photo} alt={m.event} /></div>
              : <div class="tl-img"><div class="tl-img-ph">Photo {m.year}</div></div>
            }
            <h3 class="tl-e">{m.event}</h3>
            <p class="tl-d">{m.desc}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- CULTURE -->
<section class="sec sec-cr" id="culture">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-p sh-eye">Culture &amp; HR</span>
        <h2 class="lf sh-h">How we work<br/>together.</h2>
      </div>
      <a href="/careers" class="btn btn-p btn-lg">Join the Team</a>
    </div>
    <div class="g3">
      {culture.map((c,i) => (
        <div class="cult-card au" style={"animation-delay:"+(i*.07)+"s"}>
          <h3 class="cult-t">{c.t}</h3>
          <p class="cult-d">{c.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="sec-sm" style="background:var(--p)">
  <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap">
    <div>
      <h3 class="lf" style="font-size:clamp(1.5rem,3.5vw,2.5rem);color:#fff;line-height:1.1">Want to be part of this?</h3>
      <p style="color:rgba(255,255,255,.5);margin-top:.5rem;font-size:.875rem;line-height:1.75;max-width:320px">Growing fast. Open to the right people and partnerships.</p>
    </div>
    <div style="display:flex;gap:.875rem;flex-wrap:wrap">
      <a href="/careers" class="btn btn-y btn-lg">See Open Roles</a>
      <a href="mailto:hello@babycakes.th" class="btn btn-ow btn-lg">Say Hello</a>
    </div>
  </div>
</section>
</Base>
<style>
.brand-hero{position:relative;background:var(--d);padding:clamp(8rem,15vw,12rem) var(--px) clamp(4rem,8vw,6rem);overflow:hidden}
.bh-h1{font-size:clamp(3rem,9vw,7.5rem);color:var(--y);line-height:.9;letter-spacing:-.025em;margin-bottom:1.25rem}
.bh-sub{color:rgba(251,245,171,.45);font-size:clamp(.95rem,1.7vw,1.1rem);line-height:1.9;max-width:520px;margin-bottom:clamp(2rem,4vw,3rem)}
.bh-stats{display:flex;flex-wrap:wrap;border:1px solid rgba(251,245,171,.1);border-radius:var(--rm);overflow:hidden;width:fit-content}
.bh-s{padding:clamp(.875rem,2vw,1.25rem) clamp(1.25rem,3vw,2.25rem);border-right:1px solid rgba(251,245,171,.1);display:flex;flex-direction:column;gap:.25rem}
.bh-s:last-child{border-right:none}
.bh-s strong{font-size:clamp(1.25rem,3vw,1.75rem);color:var(--y);line-height:1}
.bh-s span{font-size:.58rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:rgba(251,245,171,.26)}
@media(max-width:480px){.bh-stats{width:100%}.bh-s{border-right:none;border-bottom:1px solid rgba(251,245,171,.1)}.bh-s:last-child{border-bottom:none}}

.b-nav{background:var(--w);border-bottom:1px solid var(--g1);position:sticky;top:var(--nav-h);z-index:400}
.b-nav-in{display:flex;gap:clamp(1.5rem,3vw,2.5rem);padding-block:.9rem;max-width:var(--mx);margin-inline:auto;padding-inline:var(--px);overflow-x:auto;scrollbar-width:none;white-space:nowrap;-webkit-overflow-scrolling:touch}
.b-nav-in::-webkit-scrollbar{display:none}
.b-nav a{font-size:.68rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--g3);transition:color .15s,border-color .15s;padding-block:.2rem;border-bottom:2px solid transparent;flex-shrink:0}
.b-nav a:hover{color:var(--p);border-bottom-color:var(--p)}

.story-g{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,7vw,8rem);align-items:start}
.sbp{font-size:1rem;line-height:1.9;color:var(--d);opacity:.7}
.sbp+.sbp{margin-top:1rem}
.story-links{display:flex;gap:.875rem;flex-wrap:wrap;margin-top:2.25rem}
.story-img{aspect-ratio:4/3;border-radius:var(--rm);overflow:hidden;position:relative;background:var(--d)}
.story-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.story-img-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.18);text-align:center;padding:1.5rem}
.story-cap{display:flex;gap:.875rem;align-items:flex-start;margin-top:1rem}
.story-cap-y{font-family:'Shrikhand',serif;font-size:1.75rem;color:var(--d);line-height:1;flex-shrink:0}
.story-cap p{font-size:.82rem;color:var(--g3);line-height:1.65;padding-top:.3rem}
.story-nums{display:flex;gap:2rem;padding:1.5rem 0;border-top:1px solid var(--g1);flex-wrap:wrap;margin-top:1rem}
.story-nums div{display:flex;flex-direction:column;gap:.25rem}
.story-nums strong{font-family:'Shrikhand',serif;font-size:1.75rem;color:var(--d);line-height:1}
.story-nums span{font-size:.6rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--p)}
@media(max-width:768px){.story-g{grid-template-columns:1fr}.story-links{flex-direction:column}.story-links .btn{width:100%;text-align:center}}

.founder-sec{display:grid;grid-template-columns:1fr 1fr;min-height:clamp(500px,65vw,780px)}
.founder-sec-r{direction:rtl}
.founder-sec-r>*{direction:ltr}
.founder-photo{position:relative;overflow:hidden}
.founder-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.founder-ph span{font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(251,245,171,.18);text-align:center;padding:2rem}
.founder-watermark{position:absolute;bottom:-.15em;right:.05em;font-family:'Shrikhand',serif;font-size:clamp(6rem,12vw,12rem);color:rgba(255,255,255,.05);line-height:1;pointer-events:none;z-index:2}
.founder-txt{display:flex;flex-direction:column;justify-content:center;padding:clamp(3rem,6vw,6rem) clamp(2rem,5vw,5.5rem);background:var(--cr)}
.founder-nm{font-family:'Shrikhand',serif;font-size:clamp(2.5rem,5vw,4.5rem);color:var(--d);line-height:1;margin-bottom:.25rem}
.founder-full-name{font-size:.78rem;font-weight:500;letter-spacing:.04em;color:var(--g3);margin-bottom:.2rem}
.founder-role-lbl{font-size:.68rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--p);margin-bottom:1.75rem}
.founder-bio{font-size:.95rem;line-height:1.9;color:var(--d);opacity:.7}
.founder-bio+.founder-bio{margin-top:1rem}
.founder-stats{display:flex;gap:2.5rem;margin-top:2rem;padding-top:2rem;border-top:1.5px solid var(--g1);flex-wrap:wrap}
.founder-stats div{display:flex;flex-direction:column;gap:.3rem}
.founder-stats strong{font-family:'Shrikhand',serif;font-size:1.5rem;color:var(--d);line-height:1}
.founder-stats span{font-size:.6rem;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--p)}
@media(max-width:768px){.founder-sec,.founder-sec-r{grid-template-columns:1fr;direction:ltr;min-height:auto}.founder-photo{height:clamp(280px,55vw,440px)}.founder-txt{padding:clamp(2.5rem,7vw,4rem) var(--px)}}

.tl{display:flex;flex-direction:column}
.tl-row{display:grid;grid-template-columns:clamp(52px,8vw,80px) 28px 1fr;gap:clamp(1rem,2.5vw,2rem)}
.tl-y{font-family:'Shrikhand',serif;font-size:clamp(1rem,2vw,1.15rem);color:var(--p);line-height:1;padding-top:.35rem;text-align:right}
.tl-conn{display:flex;flex-direction:column;align-items:center;padding-top:.4rem}
.tl-dot{width:10px;height:10px;border-radius:50%;background:var(--y);border:2px solid var(--d);flex-shrink:0;box-shadow:0 0 0 4px rgba(159,151,194,.14)}
.tl-line{flex:1;width:1.5px;background:var(--g1);margin-top:7px;min-height:2.5rem}
.tl-last .tl-line{display:none}
.tl-body{padding-bottom:clamp(2rem,4vw,3rem);display:flex;flex-direction:column;gap:.75rem}
.tl-last .tl-body{padding-bottom:0}
.tl-img{aspect-ratio:16/7;border-radius:var(--rm);overflow:hidden;background:var(--cr);position:relative}
.tl-img img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.tl-img-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g3)}
.tl-e{font-size:1rem;font-weight:700;color:var(--d)}
.tl-d{font-size:.875rem;color:var(--g3);line-height:1.8}

.cult-card{background:var(--w);border:1px solid var(--g1);border-radius:var(--rm);padding:clamp(1.5rem,3vw,2.25rem);animation:fadeUp .65s var(--ease) both}
.cult-t{font-size:1rem;font-weight:700;color:var(--d);margin-bottom:.75rem}
.cult-d{font-size:.875rem;color:var(--g3);line-height:1.8}
</style>
