---
import Base from '../../layouts/Base.astro';
const products = [
  { slug:"chocolate",     name:"Chocolate",          bg:"#2a1008", price:"259",  desc:"Our original. Rich, dark, deeply comforting. The one that started it all." },
  { slug:"classic",       name:"Classic",            bg:"#7a5c2e", price:"259",  desc:"Soft vanilla sponge with a light cream — timeless, tender, and always satisfying." },
  { slug:"thai-milk-tea", name:"Thai Tea",           bg:"#b84a10", price:"259",  desc:"Bold, spiced, unmistakably Thai. A permanent fixture on our menu." },
  { slug:"lemon",         name:"Lemon Yoghurt",      bg:"#9aaa20", price:"279",  desc:"Bright, tangy, and fresh. A lighter option that punches above its weight." },
  { slug:"party-tray",    name:"Party Tray",         bg:"#4C4378", price:"899",  desc:"Mixed flavors in one tray. Perfect for sharing — or not." },
  { slug:"baby-cookies",  name:"Baby Cookies",       bg:"#8a3060", price:"159",  desc:"Our bite-sized cookies. Same warmth, same care — in a smaller package." },
];
---
<Base title="Always Available | Babycakes" description="Our permanent menu. The classics that are always available at Babycakes.">

<section class="aa-hero">
  <div class="dots"></div>
  <div class="wrap" style="position:relative;z-index:2">
    <div class="tag tag-w au" style="width:fit-content;margin-bottom:1.5rem">Always In Stock</div>
    <h1 class="lf aa-h1 au au-1">Always<br/>Available.</h1>
    <p class="aa-sub au au-2">Our permanent classics — available every day,<br/>at every branch. No need to wait for the drop.</p>
  </div>
</section>

<div class="mq">
  <div class="mq-track">
    {["Chocolate","Classic","Thai Tea","Lemon Yoghurt","Party Tray","Baby Cookies","feel good food","always available","Chocolate","Classic","Thai Tea","Lemon Yoghurt","Party Tray","Baby Cookies","feel good food","always available"].map(t=>(
      <span class="mq-item">{t}<span class="mq-dot">✦</span></span>
    ))}
  </div>
</div>

<section class="sec">
  <div class="wrap">
    <div class="sh" style="margin-bottom:3.5rem">
      <div>
        <span class="tag tag-o sh-eyebrow">Permanent Menu</span>
        <h2 class="sh-title">Our Classics.</h2>
      </div>
    </div>
    <div class="g3">
      {products.map((p,i)=>(
        <a href={"/always-available/"+p.slug} class="pcard" style={"animation-delay:"+i*.06+"s"}>
          <div class="pimg" style={"background:"+p.bg}>
            <div class="pov"></div>
            <div class="pbadge">
              <span class="tag tag-w">always available</span>
              <span class="pprice">฿{p.price}</span>
            </div>
            <span class="lf pname">{p.name}</span>
          </div>
          <div class="pbody">
            <h3 class="ptitle">{p.name}</h3>
            <p class="pdesc">{p.desc}</p>
            <span class="pmore">Learn more →</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="sec-sm" style="background:var(--yellow)">
  <div class="wrap" style="text-align:center;max-width:560px">
    <span class="tag tag-p sh-eyebrow">Order Now</span>
    <h2 class="lf" style="font-size:clamp(2rem,4vw,3rem);color:var(--dark);margin:.75rem 0 1.25rem;line-height:1.1">Available at all branches<br/>and online delivery.</h2>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap">
      <a href="#" class="btn btn-p">Order via LINE →</a>
      <a href="#" class="btn btn-ghd">Find a Branch →</a>
    </div>
  </div>
</section>
</Base>

<style>
.aa-hero { position:relative; background:var(--dark); padding:10rem var(--px) 6rem; overflow:hidden; }
.aa-h1 { font-size:clamp(4rem,12vw,9rem); color:var(--yellow); line-height:.9; letter-spacing:-.025em; margin-bottom:1.5rem; }
.aa-sub { color:rgba(251,245,171,.55); font-size:clamp(1rem,1.8vw,1.1rem); line-height:1.85; max-width:480px; }
.pcard { display:flex; flex-direction:column; border-radius:var(--r-md); overflow:hidden; background:var(--white); box-shadow:0 2px 20px rgba(76,67,120,.07); transition:transform .28s var(--ease),box-shadow .28s var(--ease); animation:fadeUp .6s var(--ease) both; text-decoration:none; color:inherit; }
.pcard:hover { transform:translateY(-6px); box-shadow:0 18px 52px rgba(76,67,120,.16); }
.pimg { position:relative; aspect-ratio:4/3; display:flex; flex-direction:column; justify-content:space-between; padding:1.5rem; overflow:hidden; }
.pov { position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.6) 0%,transparent 55%); }
.pbadge { position:relative; z-index:2; display:flex; align-items:center; justify-content:space-between; }
.pprice { font-size:1.1rem; font-weight:900; color:var(--yellow); }
.pname { position:relative; z-index:2; font-size:2rem; color:#fff; line-height:1.05; text-shadow:0 2px 16px rgba(0,0,0,.35); }
.pbody { padding:1.5rem 1.6rem 2rem; flex:1; display:flex; flex-direction:column; }
.ptitle { font-size:1.05rem; font-weight:900; color:var(--dark); margin-bottom:.6rem; }
.pdesc { font-size:var(--text-sm); color:var(--gray-3); line-height:1.75; flex:1; }
.pmore { margin-top:1.25rem; font-size:.78rem; font-weight:800; color:var(--purple); }
</style>
