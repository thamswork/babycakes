---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('collabs', ({data}) => data.active !== false))
  .sort((a,b) => (a.data.order ?? 99) - (b.data.order ?? 99));

const ongoing  = all.filter(c => c.data.status !== 'past');
const past     = all.filter(c => c.data.status === 'past');
import brandPhotosRaw from '../../content/settings/brand-photos.json';
const collabsHeroPhoto = (brandPhotosRaw as any).collabs_hero_photo || (brandPhotosRaw as any).culture_photo || '';
---
<Base title="Collabs | Babycakes" description="Babycakes collaborations, partnerships, and limited edition drops.">

<section class="photo-hero">
  <div class="photo-hero-bg">
    <img src={collabsHeroPhoto} alt="Babycakes collabs" loading="eager" fetchpriority="high" class="photo-hero-img"/>
    <div class="photo-hero-overlay"></div>
  </div>
  <div class="wrap photo-hero-in">
    <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.5rem">Partners &amp; Collabs</div>
    <h1 class="pg-h1 au au1">We work with<br/>the best</h1>
    <p class="pg-sub au au2">Limited drops, delivery partners, and brand collaborations.<br/>
      Want to work with us? <a href="mailto:hello@babycakes.th" style="color:var(--y);text-decoration:underline;text-underline-offset:3px">Get in touch.</a>
    </p>
  </div>
</section>

<div class="mq">
  <div class="mq-t">
    {[...all.map(c=>c.data.name),"Limited drops","Brand collabs","Delivery partners",...all.map(c=>c.data.name),"Limited drops","Brand collabs","Delivery partners"].map(t=>(
      <span class="mq-i">{t}<span class="mq-dot-el"></span></span>
    ))}
  </div>
</div>

<section class="sec">
  <div class="wrap">

    <!-- Current -->
    <div class="sh">
      <div>
        <span class="tag tag-y sh-eye" style="padding-inline:1.25rem">Active Partners</span>
        <h2 class="collab-sh">Current collaborations</h2>
      </div>
    </div>
    <div class="g3">
      {ongoing.map((c,i) => (
        <a href={"/collabs/"+c.data.slug} class="pc collab-card au" style={"animation-delay:"+i*.06+"s"}>
          <div class="pc-img collab-img" style={"aspect-ratio:4/3;background:"+(c.data.bg||'#2a1640')}>
            {c.data.logo
              ? <img src={c.data.logo} alt={c.data.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:2rem" loading="lazy"/>
              : <div class="collab-name-bg lf">{c.data.name}</div>
            }
            <div class="collab-badge">{c.data.type}</div>
            {c.data.featured && <div class="collab-featured">Featured</div>}
          </div>
          <div class="pc-body">
            <div class="pc-meta">
              <span class="tag tag-cr">{c.data.type}</span>
              <span class={"status-dot status-"+c.data.status}>{c.data.status}</span>
            </div>
            <div class="pc-name">{c.data.name}</div>
            <p class="pc-desc">{c.data.desc}</p>
            <span class="pc-more">View collab →</span>
          </div>
        </a>
      ))}
    </div>

    <!-- Past -->
    {past.length > 0 && (
      <div style="margin-top:clamp(4rem,8vw,7rem)">
        <div class="sh">
          <div>
            <span class="tag tag-cr sh-eye" style="padding-inline:1.25rem">Archive</span>
            <h2 class="collab-sh" style="color:var(--g3)">Past collaborations</h2>
          </div>
        </div>
        <div class="g3">
          {past.map((c,i) => (
            <a href={"/collabs/"+c.data.slug} class="pc collab-card collab-past au" style={"animation-delay:"+i*.06+"s"}>
              <div class="pc-img collab-img" style={"aspect-ratio:4/3;background:"+(c.data.bg||'#2a1640')}>
                {c.data.logo
                  ? <img src={c.data.logo} alt={c.data.name} style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;padding:2rem;opacity:.6" loading="lazy"/>
                  : <div class="collab-name-bg lf" style="opacity:.5">{c.data.name}</div>
                }
                <div class="collab-badge">{c.data.type}</div>
                {c.data.collab_date && <div class="collab-year">{c.data.collab_date}</div>}
              </div>
              <div class="pc-body">
                <div class="pc-meta">
                  <span class="tag tag-cr">{c.data.type}</span>
                  <span class="status-dot status-past">past</span>
                </div>
                <div class="pc-name">{c.data.name}</div>
                <p class="pc-desc">{c.data.desc}</p>
                <span class="pc-more">View collab →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- CTA -->
    <div class="collab-cta">
      <div>
        <h3 class="collab-cta-h">Want to collaborate?</h3>
        <p class="collab-cta-sub">Open to limited flavor drops, pop-ups, and brand collabs. Reach out on LINE or email.</p>
      </div>
      <div style="display:flex;gap:.875rem;flex-wrap:wrap">
        <a href="https://lin.ee/babycakes-collab" target="_blank" rel="noopener" class="btn btn-p btn-lg">Partnership LINE</a>
        <a href="mailto:hello@babycakes.th" class="btn btn-od btn-lg">Email us</a>
      </div>
    </div>

  </div>
</section>
</Base>
<style>
.pg-hero{position:relative;background:var(--p);padding:clamp(8rem,14vw,11rem) var(--px) clamp(4rem,7vw,5.5rem);overflow:hidden}
.pg-h1{font-family:var(--font);font-weight:800;font-style:italic;font-size:clamp(3rem,9vw,7rem);color:var(--y);line-height:.95;letter-spacing:-.025em;margin-bottom:1.25rem}
.pg-sub{color:rgba(255,255,255,.65);font-size:clamp(.95rem,1.6vw,1.05rem);line-height:1.9;max-width:480px}
.collab-sh{font-family:var(--font);font-weight:800;font-style:italic;font-size:clamp(2.25rem,5.5vw,4rem);color:var(--p);line-height:1;letter-spacing:-.025em;margin-top:.875rem}
.collab-card{text-decoration:none}
.collab-past{opacity:.75}
.collab-past:hover{opacity:1}
.collab-img{position:relative;display:flex;align-items:center;justify-content:center;overflow:hidden}
.collab-name-bg{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--font-logo);font-size:clamp(1.25rem,3vw,2rem);color:rgba(255,255,255,.5);text-align:center;padding:1.5rem;line-height:1.1}
.collab-badge{position:absolute;top:1rem;left:1rem;font-size:.55rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.25rem .7rem;border-radius:var(--r);background:rgba(0,0,0,.4);color:rgba(255,255,255,.75);backdrop-filter:blur(4px);font-family:var(--font)}
.collab-featured{position:absolute;top:1rem;right:1rem;font-size:.55rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.25rem .7rem;border-radius:var(--r);background:var(--y);color:var(--d);font-family:var(--font)}
.collab-year{position:absolute;bottom:1rem;right:1rem;font-size:.6rem;font-weight:700;color:rgba(255,255,255,.4);font-family:var(--font);letter-spacing:.06em}
.status-dot{font-size:.55rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:999px;font-family:var(--font)}
.status-ongoing{background:rgba(0,180,100,.12);color:#00b464}
.status-past{background:var(--g1);color:var(--g3)}
.status-upcoming{background:rgba(159,151,194,.15);color:var(--p)}
.pc-more{display:inline-block;margin-top:.875rem;font-size:.75rem;font-weight:600;color:var(--p);letter-spacing:.04em;font-family:var(--font)}
.collab-cta{display:flex;align-items:center;justify-content:space-between;gap:2.5rem;flex-wrap:wrap;margin-top:5rem;padding-top:4rem;border-top:1.5px solid var(--g1)}
.collab-cta-h{font-family:var(--font);font-weight:800;font-style:italic;font-size:clamp(1.75rem,3.5vw,2.75rem);color:var(--p);line-height:1.05}
.collab-cta-sub{color:var(--g3);font-size:.95rem;line-height:1.8;margin-top:.625rem;max-width:420px}
@media(max-width:600px){
  .pg-h1{font-size:clamp(2.75rem,13vw,5rem)}
  .collab-sh{font-size:clamp(1.875rem,10vw,3rem)}
  .g3{grid-template-columns:repeat(2,1fr);gap:.625rem}
  .pc-body{padding:.875rem .875rem 1rem}
  .pc-name{font-size:.95rem}
  .pc-desc{font-size:.75rem;-webkit-line-clamp:2;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden}
  .collab-cta{flex-direction:column;align-items:flex-start;padding-top:2.5rem;margin-top:2.5rem}
  .collab-cta>div:last-child{flex-direction:column;width:100%}
  .collab-cta .btn{width:100%;justify-content:center}
}
</style>
