---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('collabs');
  const paths: any[] = [];
  all.forEach(c => {
    const fileId   = c.id;
    const dataSlug = (c.data as any).slug;
    paths.push({ params: { slug: fileId }, props: { collab: c.data } });
    if (dataSlug && dataSlug !== fileId) {
      paths.push({ params: { slug: dataSlug }, props: { collab: c.data } });
    }
  });
  return paths;
}

const c = Astro.props.collab as any;

const bgMap: Record<string,string> = {
  'refill-coffee':'#2a1c0e','kitkat':'#8B0000',
  'grabfood':'#00a651','line-man':'#1a1a2e','homeland':'#1a3320',
};
const bg = bgMap[c.slug] || '#2a1640';
const photos = [c.logo, c.photo_2, c.photo_3, c.photo_4].filter(Boolean);
---
<Base title={c.name + " | Babycakes Collabs"} description={c.desc ?? "A Babycakes collaboration with " + c.name}>

<!-- ── HERO ── -->
<section class="ch" style={"background:"+bg}>
  <div class="dots"></div>
  <div class="wrap ch-in">
    <a href="/collabs" class="ch-back">← All collabs</a>
    <div class="ch-meta">
      <span class="tag tag-ow">{c.type}</span>
    </div>
    <h1 class="lf ch-h1">{c.name}</h1>
    {c.desc && <p class="ch-sub">{c.desc}</p>}
    {(c.url || c.line) && (
      <div class="ch-ctas">
        {c.url  && <a href={c.url}  target="_blank" rel="noopener" class="btn btn-ow btn-lg">Visit site</a>}
        {c.line && <a href={c.line} target="_blank" rel="noopener" class="btn btn-y  btn-lg">Contact via LINE</a>}
      </div>
    )}
  </div>
</section>

<!-- ── BODY ── -->
<section class="sec">
  <div class="wrap cl">

    <!-- MAIN -->
    <div class="cl-main">

      <!-- Photos -->
      {photos.length > 0 ? (
        <div class={"collage n"+Math.min(photos.length,4)}>
          {photos.slice(0,4).map((src:string, i:number) => (
            <div class={"ci ci"+(i+1)}>
              <img src={src} alt={c.name+" image "+(i+1)} loading={i===0?"eager":"lazy"}/>
            </div>
          ))}
        </div>
      ) : (
        <div class="cl-nophoto" style={"background:"+bg}>
          <span class="lf">{c.name}</span>
        </div>
      )}

      <!-- About -->
      {c.desc && (
        <div class="cl-about">
          <span class="cl-eyebrow">About this partnership</span>
          <p class="cl-body">{c.desc}</p>
        </div>
      )}

      <!-- CTA block -->
      <div class="cl-cta-block">
        <div class="cl-cta-text">
          <h3 class="lf cl-cta-h">Interested in collaborating?</h3>
          <p class="cl-cta-sub">Reach out on our partnership LINE or email us directly.</p>
        </div>
        <div class="cl-cta-btns">
          <a href="https://lin.ee/babycakes-collab" target="_blank" rel="noopener" class="btn btn-y btn-lg">Partnership LINE</a>
          <a href="mailto:hello@babycakes.th" class="btn btn-ow btn-lg">Email us</a>
        </div>
      </div>

    </div>

    <!-- SIDEBAR -->
    <aside class="cl-side">

      <!-- Details card -->
      <div class="cl-card">
        <p class="cl-card-h">Partnership details</p>
        <div class="cl-row"><span>Partner</span><strong>{c.name}</strong></div>
        <div class="cl-row"><span>Type</span>
          <span class="tag tag-p" style="font-size:.55rem;padding:.25rem .7rem">{c.type}</span>
        </div>
        {c.url && (
          <div class="cl-row">
            <span>Website</span>
            <a href={c.url} target="_blank" rel="noopener" class="cl-link">{c.url.replace(/^https?:\/\//,'')}</a>
          </div>
        )}
        {photos.length > 0 && (
          <div class="cl-row"><span>Gallery</span><strong>{photos.length} photo{photos.length>1?'s':''}</strong></div>
        )}
      </div>

      <!-- LINE card -->
      {c.line && (
        <div class="cl-card cl-card-dark">
          <p class="cl-card-h cl-card-h-lt">Get in touch</p>
          <p class="cl-card-sub">For collab enquiries, use our partnership LINE.</p>
          <a href={c.line} target="_blank" rel="noopener" class="btn btn-y" style="width:100%;justify-content:center;margin-top:.25rem">Contact via LINE</a>
        </div>
      )}

      <a href="/collabs" class="cl-back-link">← All collabs</a>

    </aside>
  </div>
</section>

</Base>
<style>
/* ── HERO ── */
.ch {
  position: relative;
  padding: clamp(7rem,14vw,11rem) var(--px) clamp(4rem,7vw,5.5rem);
  overflow: hidden;
}
.ch-in { position: relative; z-index: 2; }
.ch-back {
  display: inline-flex; align-items: center; gap: .4rem;
  font-size: .65rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(255,255,255,.4);
  margin-bottom: 1.75rem; transition: color .15s;
}
.ch-back:hover { color: rgba(255,255,255,.75); }
.ch-meta { margin-bottom: 1.25rem; }
.ch-h1 {
  font-size: clamp(3rem,9vw,7rem);
  color: #fff; line-height: .92;
  letter-spacing: -.03em;
  margin-bottom: 1.25rem;
}
.ch-sub {
  color: rgba(255,255,255,.55);
  font-size: clamp(.95rem,1.6vw,1.1rem);
  line-height: 1.9; max-width: 520px;
  margin-bottom: 2rem;
}
.ch-ctas { display: flex; gap: .875rem; flex-wrap: wrap; }

/* ── LAYOUT ── */
.cl {
  display: grid;
  grid-template-columns: 1fr 300px;
  gap: 4rem;
  align-items: start;
}
.cl-main { display: flex; flex-direction: column; gap: 3rem; }

/* ── PHOTO COLLAGE ── */
.collage {
  display: grid; border-radius: var(--rl);
  overflow: hidden; gap: 3px; background: var(--g1);
}
.n1 { grid-template-columns: 1fr; }
.n1 .ci1 { aspect-ratio: 16/9; }
.n2 { grid-template-columns: 1fr 1fr; }
.n2 .ci { aspect-ratio: 4/3; }
.n3 { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
.n3 .ci1 { grid-row: 1/3; }
.n3 .ci2, .n3 .ci3 { aspect-ratio: 4/3; }
.n4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
.n4 .ci { aspect-ratio: 4/3; }
.ci {
  position: relative; overflow: hidden; min-height: 160px;
}
.ci img {
  position: absolute; inset: 0;
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .5s var(--ease);
}
.ci:hover img { transform: scale(1.04); }

/* No photo fallback */
.cl-nophoto {
  border-radius: var(--rl); aspect-ratio: 16/9;
  display: flex; align-items: center; justify-content: center;
}
.cl-nophoto span {
  font-size: clamp(2.5rem,7vw,5rem);
  color: rgba(255,255,255,.15);
  letter-spacing: -.02em;
}

/* ── ABOUT ── */
.cl-about {
  display: flex; flex-direction: column; gap: 1rem;
  padding-left: 1rem;
  border-left: 3px solid var(--y);
}
.cl-eyebrow {
  font-size: .6rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--p);
}
.cl-body {
  font-size: 1.05rem; color: var(--tx);
  line-height: 1.9; font-weight: var(--fw-body);
}

/* ── CTA BLOCK ── */
.cl-cta-block {
  display: flex; align-items: center;
  justify-content: space-between;
  gap: 2rem; flex-wrap: wrap;
  padding: 2.5rem;
  background: var(--xdk);
  border-radius: var(--rl);
}
.cl-cta-h {
  font-size: clamp(1.25rem,2.5vw,1.75rem);
  color: var(--y); margin-bottom: .5rem;
}
.cl-cta-sub {
  color: rgba(255,255,255,.45);
  font-size: .88rem; line-height: 1.75;
}
.cl-cta-btns { display: flex; gap: .75rem; flex-wrap: wrap; }

/* ── SIDEBAR ── */
.cl-side {
  display: flex; flex-direction: column; gap: 1.25rem;
  position: sticky; top: calc(var(--nav-h) + 2rem);
}
.cl-card {
  border-radius: var(--rl); padding: 2rem;
  background: var(--cr); border: 1px solid var(--g1);
}
.cl-card-dark {
  background: var(--d); border-color: transparent;
}
.cl-card-h {
  font-size: .58rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--g3); margin-bottom: 1.25rem;
}
.cl-card-h-lt { color: rgba(251,245,171,.4); }
.cl-card-sub {
  font-size: .82rem; color: rgba(251,245,171,.45);
  line-height: 1.75; margin-bottom: 1.25rem;
}
.cl-row {
  display: flex; justify-content: space-between;
  align-items: center; gap: 1rem;
  padding: .625rem 0;
  border-bottom: 1px solid var(--g1);
  font-size: .82rem;
}
.cl-row:last-child { border-bottom: none; }
.cl-row span { color: var(--g3); flex-shrink: 0; }
.cl-row strong { color: var(--d); font-weight: 700; }
.cl-link {
  color: var(--p); font-weight: 700;
  font-size: .78rem; word-break: break-all;
  transition: opacity .15s;
}
.cl-link:hover { opacity: .7; }
.cl-back-link {
  font-size: .68rem; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--p); text-align: center;
  transition: opacity .15s;
}
.cl-back-link:hover { opacity: .7; }

/* ── MOBILE ── */
@media (max-width: 960px) {
  .cl { grid-template-columns: 1fr; gap: 2.5rem; }
  .cl-side { position: static; order: -1; }
  .cl-cta-block { flex-direction: column; align-items: flex-start; padding: 1.75rem; }
  .cl-cta-btns .btn { width: 100%; justify-content: center; }
  .n3 { grid-template-columns: 1fr; grid-template-rows: auto; }
  .n3 .ci1 { grid-row: auto; aspect-ratio: 4/3; }
}
@media (max-width: 600px) {
  .ch { padding-top: clamp(5.5rem,14vw,8rem); padding-bottom: 2.5rem; }
  .ch-h1 { font-size: clamp(2.25rem,10vw,4rem); }
  .ch-sub { font-size: .9rem; }
  .cl-card { padding: 1.5rem; }
}
</style>
