---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const all = await getCollection('collabs');
  const paths: any[] = [];
  all.forEach(c => {
    const fileId   = c.id;
    const dataSlug = (c.data as any).slug;
    paths.push({ params: { slug: fileId }, props: { collab: c.data } });
    if (dataSlug && dataSlug !== fileId) {
      paths.push({ params: { slug: dataSlug }, props: { collab: c.data } });
    }
  });
  return paths;
}

const c = Astro.props.collab as any;

const bg = c.bg || '#2a1640';
const photos = [c.logo, c.photo_2, c.photo_3, c.photo_4].filter(Boolean);
const bodyText = c.long_desc || c.desc || '';
---
<Base title={c.name + " | Babycakes Collabs"} description={c.desc ?? "A Babycakes collaboration with " + c.name}>

<!-- ── HERO ── -->
<section class="ch" style={"background:"+bg}>
  <div class="dots"></div>
  <div class="wrap ch-in">
    <a href="/collabs" class="ch-back">← All collabs</a>
    <div class="ch-meta">
      <span class="tag tag-ow">{c.type}</span>
    </div>
    <h1 class="lf ch-h1">{c.name}</h1>
    {c.desc && <p class="ch-sub">{c.desc}</p>}
    {(c.url || c.line) && (
      <div class="ch-ctas">
        {c.url  && <a href={c.url}  target="_blank" rel="noopener" class="btn btn-ow btn-lg">Visit site</a>}
        {c.line && <a href={c.line} target="_blank" rel="noopener" class="btn btn-y  btn-lg">Contact via LINE</a>}
      </div>
    )}
  </div>
</section>

<!-- ── PARTNERSHIP DETAILS STRIP ── -->
<div class="cl-strip">
  <div class="wrap cl-strip-in">
    <div class="cl-strip-row">
      <span class="cl-strip-label">Partner</span>
      <strong class="cl-strip-val">{c.name}</strong>
    </div>
    <div class="cl-strip-div"></div>
    <div class="cl-strip-row">
      <span class="cl-strip-label">Type</span>
      <strong class="cl-strip-val">{c.type}</strong>
    </div>
    {c.collab_date && <>
      <div class="cl-strip-div"></div>
      <div class="cl-strip-row">
        <span class="cl-strip-label">Year</span>
        <strong class="cl-strip-val">{c.collab_date}</strong>
      </div>
    </>}
    {c.status && <>
      <div class="cl-strip-div"></div>
      <div class="cl-strip-row">
        <span class="cl-strip-label">Status</span>
        <span class={"status-pill status-"+c.status}>{c.status}</span>
      </div>
    </>}
    {c.url && <>
      <div class="cl-strip-div"></div>
      <div class="cl-strip-row">
        <a href={c.url} target="_blank" rel="noopener" class="cl-strip-link">Visit site →</a>
      </div>
    </>}
  </div>
</div>

<!-- ── BODY ── -->
<section class="sec">
  <div class="wrap cl-body-wrap">
    {photos.length > 0 ? (
      <div class={"collage n"+Math.min(photos.length,4)}>
        {photos.slice(0,4).map((src:string, i:number) => (
          <div class={"ci ci"+(i+1)}>
            <img src={src} alt={c.name+" image "+(i+1)} loading={i===0?"eager":"lazy"}/>
          </div>
        ))}
      </div>
    ) : (
      <div class="cl-nophoto" style={"background:"+bg}>
        <span class="lf">{c.name}</span>
      </div>
    )}
    {bodyText && (
      <div class="cl-about">
        <span class="cl-eyebrow">About this partnership</span>
        <p class="cl-body">{bodyText}</p>
      </div>
    )}
    {c.line && (
      <div class="cl-line-card">
        <div>
          <h3 class="lf cl-line-h">Get in touch</h3>
          <p class="cl-line-sub">For enquiries about this partnership, reach out directly.</p>
        </div>
        <a href={c.line} target="_blank" rel="noopener" class="btn btn-y btn-lg">Contact via LINE</a>
      </div>
    )}
    <div class="cl-cta-block">
      <div class="cl-cta-text">
        <h3 class="lf cl-cta-h">Interested in collaborating?</h3>
        <p class="cl-cta-sub">Reach out on our partnership LINE or email us directly.</p>
      </div>
      <div class="cl-cta-btns">
        <a href="https://lin.ee/babycakes-collab" target="_blank" rel="noopener" class="btn btn-y btn-lg">Partnership LINE</a>
        <a href="mailto:hello@babycakes.th" class="btn btn-ow btn-lg">Email us</a>
      </div>
    </div>
    <a href="/collabs" class="cl-back-link">← All collabs</a>
  </div>
</section>

</Base>
<style>
/* ── HERO ── */
.ch {
  position: relative;
  padding: clamp(7rem,14vw,11rem) var(--px) clamp(4rem,7vw,5.5rem);
  overflow: hidden;
}
.ch-in { position: relative; z-index: 2; }
.ch-back {
  display: inline-flex; align-items: center; gap: .4rem;
  font-size: .65rem; font-weight: 700; letter-spacing: .1em;
  text-transform: uppercase; color: rgba(255,255,255,.4);
  margin-bottom: 1.75rem; transition: color .15s;
}
.ch-back:hover { color: rgba(255,255,255,.75); }
.ch-meta { margin-bottom: 1.25rem; }
.ch-h1 {
  font-size: clamp(3rem,9vw,7rem);
  color: #fff; line-height: .92;
  letter-spacing: -.03em;
  margin-bottom: 1.25rem;
}
.ch-sub {
  color: rgba(255,255,255,.55);
  font-size: clamp(.95rem,1.6vw,1.1rem);
  line-height: 1.9; max-width: 520px;
  margin-bottom: 2rem;
}
.ch-ctas { display: flex; gap: .875rem; flex-wrap: wrap; }

/* ── STRIP ── */
.cl-strip {
  background: var(--cr);
  border-bottom: 1px solid var(--g1);
}
.cl-strip-in {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 0;
  padding-block: 1.25rem;
}
.cl-strip-row {
  display: flex;
  flex-direction: column;
  gap: .2rem;
  padding: .5rem 2rem .5rem 0;
}
.cl-strip-div {
  width: 1px;
  height: 2rem;
  background: var(--g1);
  margin-right: 2rem;
  flex-shrink: 0;
}
.cl-strip-label {
  font-size: .55rem;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--g3);
}
.cl-strip-val {
  font-size: .88rem;
  font-weight: 700;
  color: var(--d);
}
.cl-strip-link {
  font-size: .75rem;
  font-weight: 700;
  color: var(--p);
  letter-spacing: .04em;
  margin-top: .75rem;
  transition: opacity .15s;
}
.cl-strip-link:hover { opacity: .7; }

/* ── BODY ── */
.cl-body-wrap { display: flex; flex-direction: column; gap: 3rem; }

/* ── PHOTO COLLAGE ── */
.collage {
  display: grid; border-radius: var(--rl);
  overflow: hidden; gap: 3px; background: var(--g1);
}
.n1 { grid-template-columns: 1fr; }
.n1 .ci1 { aspect-ratio: 16/9; }
.n2 { grid-template-columns: 1fr 1fr; }
.n2 .ci { aspect-ratio: 4/3; }
.n3 { grid-template-columns: 2fr 1fr; grid-template-rows: 1fr 1fr; }
.n3 .ci1 { grid-row: 1/3; }
.n3 .ci2, .n3 .ci3 { aspect-ratio: 4/3; }
.n4 { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; }
.n4 .ci { aspect-ratio: 4/3; }
.ci {
  position: relative; overflow: hidden; min-height: 160px;
}
.ci img {
  position: absolute; inset: 0;
  width: 100%; height: 100%; object-fit: cover;
  transition: transform .5s var(--ease);
}
.ci:hover img { transform: scale(1.04); }

/* No photo fallback */
.cl-nophoto {
  border-radius: var(--rl); aspect-ratio: 16/9;
  display: flex; align-items: center; justify-content: center;
}
.cl-nophoto span {
  font-size: clamp(2.5rem,7vw,5rem);
  color: rgba(255,255,255,.15);
  letter-spacing: -.02em;
}

/* ── ABOUT ── */
.cl-about {
  display: flex; flex-direction: column; gap: 1rem;
  padding-left: 1rem;
  border-left: 3px solid var(--y);
}
.cl-eyebrow {
  font-size: .6rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--p);
}
.cl-body {
  font-size: 1.05rem; color: var(--tx);
  line-height: 1.9; font-weight: var(--fw-body);
}

/* ── CTA BLOCK ── */
.cl-cta-block {
  display: flex; align-items: center;
  justify-content: space-between;
  gap: 2rem; flex-wrap: wrap;
  padding: 2.5rem;
  background: var(--xdk);
  border-radius: var(--rl);
}
.cl-cta-h {
  font-size: clamp(1.25rem,2.5vw,1.75rem);
  color: var(--y); margin-bottom: .5rem;
}
.cl-cta-sub {
  color: rgba(255,255,255,.45);
  font-size: .88rem; line-height: 1.75;
}
.cl-cta-btns { display: flex; gap: .75rem; flex-wrap: wrap; }

.cl-back-link {
  font-size: .68rem; font-weight: 700;
  letter-spacing: .08em; text-transform: uppercase;
  color: var(--p); transition: opacity .15s;
}
.cl-back-link:hover { opacity: .7; }
/* LINE card */
.cl-line-card {
  display: flex; align-items: center;
  justify-content: space-between;
  gap: 2rem; flex-wrap: wrap;
  padding: 2rem 2.5rem;
  background: var(--cr);
  border: 1px solid var(--g1);
  border-radius: var(--rl);
}
.cl-line-h { font-size: clamp(1.25rem,2.5vw,1.75rem); color: var(--d); margin-bottom: .4rem; }
.cl-line-sub { font-size: .88rem; color: var(--g3); line-height: 1.7; }

.status-pill{font-size:.55rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;padding:.2rem .6rem;border-radius:999px;font-family:var(--font)}
.status-ongoing{background:rgba(0,180,100,.12);color:#00b464}
.status-past{background:var(--g1);color:var(--g3)}
.status-upcoming{background:rgba(159,151,194,.15);color:var(--p)}
/* ── MOBILE ── */
@media (max-width: 768px) {
  .cl-strip-in { gap: 0; }
  .cl-strip-row { padding: .5rem 1.25rem .5rem 0; }
  .cl-strip-div { margin-right: 1.25rem; }
  .cl-cta-block { flex-direction: column; align-items: flex-start; padding: 1.75rem; }
  .cl-cta-btns .btn { width: 100%; justify-content: center; }
  .cl-line-card { flex-direction: column; align-items: flex-start; padding: 1.5rem; }
  .cl-line-card .btn { width: 100%; justify-content: center; }
  .n3 { grid-template-columns: 1fr; grid-template-rows: auto; }
  .n3 .ci1 { grid-row: auto; aspect-ratio: 4/3; }
}
@media (max-width: 600px) {
  .ch { padding-top: clamp(5.5rem,14vw,8rem); padding-bottom: 2.5rem; }
  .ch-h1 { font-size: clamp(2.25rem,10vw,4rem); }
  .ch-sub { font-size: .9rem; }
  .cl-strip-in { flex-wrap: wrap; gap: .25rem 0; }
  .cl-strip-div { display: none; }
  .cl-strip-row { width: 50%; padding: .625rem 0; }
}
</style>
