---
import Base from '../layouts/Base.astro';
---
<Base title="Babycakes — Feel Good Food" description="Born from baby + cakes. Classic recipes reimagined for today. Crafted with warmth, intention, and heart.">

<section class="hero">
  <div class="hero-inner">
    <div class="hero-text">
      <span class="badge badge-yellow fade-up">✦ Weekly Flavors Available Now</span>
      <h1 class="hero-h1 font-logo fade-up fade-up-2">feel good<br/>food.</h1>
      <p class="hero-sub fade-up fade-up-3">Born from <em>baby + cakes</em> — a name rooted in love and care.<br/>Classic recipes, reimagined for today. Baked with warmth, intention, and heart.</p>
      <div class="hero-actions fade-up fade-up-4">
        <a href="/weekly-updates" class="btn btn-primary">See This Week →</a>
        <a href="/brand" class="btn btn-ghost">Our Story</a>
      </div>
    </div>
    <div class="hero-badge-wrap pop-in">
      <div class="hero-badge">
        <span class="font-logo hero-badge-logo">babycakes</span>
        <span class="hero-badge-sub">feel good food ·</span>
      </div>
    </div>
  </div>
  <div class="hero-grain"></div>
</section>

<div class="marquee-wrap strip">
  <div class="marquee-inner">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Chocolate","Cake Cube","Party Tray","Thai Tea","All-star Flavors","feel good food ·","Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Chocolate","Cake Cube","Party Tray","Thai Tea","All-star Flavors","feel good food ·"].map(item => (
      <span class="strip-item">{item} <span class="strip-dot">✦</span></span>
    ))}
  </div>
</div>

<section class="story section-pad">
  <div class="container">
    <div class="story-grid">
      <div class="story-left">
        <span class="badge badge-outline">Our Story</span>
        <h2 class="story-h2">Sweet moments,<br/><em>made to be cherished.</em></h2>
      </div>
      <div class="story-right">
        <p>Babycakes was born from a simple belief: that food baked with love tastes different. Every cake is crafted with warmth, intention, and heart — inspired by timeless family recipes passed down through generations.</p>
        <p>Soft, nostalgic, and comforting like a taste of home. Sweet moments that become memories — the kind you'll want to share.</p>
        <a href="/brand" class="btn btn-secondary" style="margin-top:1.5rem;">Our Brand Standards →</a>
      </div>
    </div>
  </div>
</section>

<section class="updates-teaser section-pad" style="background:var(--yellow);">
  <div class="container">
    <div class="teaser-header">
      <div>
        <span class="badge badge-purple">Updated Weekly</span>
        <h2 class="teaser-h2">This week's<br/>flavors.</h2>
      </div>
      <a href="/weekly-updates" class="btn btn-secondary">View All Updates →</a>
    </div>
    <div class="cards-grid">
      {[
        {name:"Strawberry Kiss",period:"17 Feb – 13 March",tag:"bi-weekly",color:"#e8c4cc"},
        {name:"Dubai Chocolate",period:"17 Feb – 13 March",tag:"bi-weekly",color:"#3d2010"},
        {name:"Mayongchid",period:"11 – 17 April",tag:"bi-weekly",color:"#f5a623"},
        {name:"Cheesecake Blueberry",period:"13 – 18 Feb",tag:"weekly",color:"#5a3e7a"},
      ].map((item,i)=>(
        <a href="/weekly-updates" class="flavor-card card-hover" style={`animation-delay:${i*0.08}s`}>
          <div class="card-img-placeholder" style={`background:${item.color}`}>
            <span class="font-logo card-flavor-name">{item.name}</span>
          </div>
          <div class="card-body">
            <div class="card-top">
              <span class="badge badge-yellow">{item.tag}</span>
              <span class="card-period">{item.period}</span>
            </div>
            <h3 class="card-title">{item.name}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="cred section-pad" style="background:var(--purple);">
  <div class="container">
    <div class="cred-grid">
      {[
        {n:"Weekly",label:"New Flavors",icon:"✦"},
        {n:"100%",label:"Baked Fresh Daily",icon:"◎"},
        {n:"Feel",label:"Good Food Promise",icon:"♡"},
        {n:"Custom",label:"Message Cakes",icon:"✎"},
      ].map(item=>(
        <div class="cred-item">
          <span class="cred-icon">{item.icon}</span>
          <strong class="cred-n font-logo">{item.n}</strong>
          <span class="cred-label">{item.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

</Base>
<style>
.hero{position:relative;background:var(--purple-dark);overflow:hidden;padding:clamp(4rem,12vw,8rem) var(--pad-x) clamp(4rem,10vw,7rem);}
.hero-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:3rem;}
.hero-text{flex:1;max-width:580px;}
.hero-h1{font-size:clamp(3.5rem,10vw,7rem);color:var(--yellow);line-height:0.95;margin:1rem 0 1.5rem;letter-spacing:-0.02em;}
.hero-sub{color:rgba(251,245,171,0.75);font-size:clamp(1rem,2vw,1.15rem);line-height:1.7;margin-bottom:2.5rem;}
.hero-sub em{color:var(--yellow);font-style:normal;font-weight:700;}
.hero-actions{display:flex;gap:1rem;flex-wrap:wrap;}
.hero-badge-wrap{flex-shrink:0;}
.hero-badge{width:clamp(180px,22vw,260px);aspect-ratio:1;border-radius:50%;background:var(--yellow);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.4rem;box-shadow:0 0 60px rgba(251,245,171,0.25);transform:rotate(-6deg);}
.hero-badge-logo{font-size:clamp(1.4rem,3vw,2rem);color:var(--purple-dark);}
.hero-badge-sub{font-size:0.75rem;font-weight:700;color:var(--purple-dark);letter-spacing:0.05em;}
.hero-grain{position:absolute;inset:0;pointer-events:none;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.04'/%3E%3C/svg%3E");}
@media(max-width:640px){.hero-badge-wrap{display:none;}}
.strip{background:var(--yellow);overflow:hidden;padding:0.75rem 0;border-top:2px solid var(--purple-dark);border-bottom:2px solid var(--purple-dark);}
.strip-item{display:inline-flex;align-items:center;gap:1rem;padding:0 1.5rem;font-weight:800;font-size:0.85rem;letter-spacing:0.04em;text-transform:uppercase;color:var(--purple-dark);white-space:nowrap;}
.strip-dot{color:var(--purple);}
.section-pad{padding:clamp(4rem,8vw,7rem) var(--pad-x);}
.container{max-width:1280px;margin:0 auto;}
.story-grid{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,6vw,6rem);align-items:start;}
.story-h2{font-size:clamp(2rem,4vw,3rem);font-weight:900;color:var(--purple-dark);margin:1rem 0 0;line-height:1.15;}
.story-h2 em{color:var(--purple);font-style:normal;}
.story-right p{color:#555;line-height:1.8;margin-bottom:1rem;font-size:1.05rem;}
@media(max-width:768px){.story-grid{grid-template-columns:1fr;}}
.teaser-header{display:flex;align-items:flex-end;justify-content:space-between;gap:1rem;margin-bottom:2.5rem;flex-wrap:wrap;}
.teaser-h2{font-size:clamp(2rem,4vw,3rem);font-weight:900;color:var(--purple-dark);margin:0.75rem 0 0;line-height:1.1;}
.cards-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:1.5rem;}
.flavor-card{background:var(--white);border-radius:1.25rem;overflow:hidden;text-decoration:none;color:inherit;box-shadow:0 4px 20px rgba(76,67,120,0.1);display:block;}
.card-img-placeholder{width:100%;aspect-ratio:1;display:flex;align-items:flex-end;padding:1rem;}
.card-flavor-name{font-size:1.4rem;color:var(--white);text-shadow:0 2px 8px rgba(0,0,0,0.4);line-height:1.1;}
.card-body{padding:1rem 1.1rem 1.25rem;}
.card-top{display:flex;align-items:center;justify-content:space-between;margin-bottom:0.5rem;}
.card-period{font-size:0.72rem;color:var(--purple);font-weight:600;}
.card-title{font-size:1rem;font-weight:800;color:var(--purple-dark);margin:0;}
.cred-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem;text-align:center;}
.cred-item{display:flex;flex-direction:column;align-items:center;gap:0.4rem;padding:2rem 1rem;}
.cred-icon{font-size:1.5rem;color:var(--yellow);}
.cred-n{font-size:2rem;color:var(--yellow);line-height:1;}
.cred-label{font-size:0.85rem;font-weight:700;color:rgba(251,245,171,0.75);}
@media(max-width:640px){.cred-grid{grid-template-columns:repeat(2,1fr);}}
</style>
