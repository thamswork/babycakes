---
import Base from '../layouts/Base.astro';
const drops = [
  { slug:"strawberry-kiss",  name:"Strawberry Kiss",     period:"17 Feb – 13 March", bg:"#6a2030" },
  { slug:"dubai-chocolate",  name:"Dubai Chocolate",      period:"17 Feb – 13 March", bg:"#120804" },
  { slug:"mayongchid",       name:"Mayongchid",           period:"11 – 17 April",     bg:"#7a5010" },
  { slug:"cheesecake",       name:"Cheesecake Blueberry", period:"13 – 18 Feb",       bg:"#201038" },
];
const classics = [
  { slug:"chocolate",  name:"Chocolate",     bg:"#180a04" },
  { slug:"classic",    name:"Classic",       bg:"#4a3014" },
  { slug:"thai-tea",   name:"Thai Tea",      bg:"#7a2c0c" },
];
---
<Base title="Babycakes — Feel Good Food">

<!-- ══ HERO ══ -->
<section class="hero">
  <!-- Photo slot: replace .hero-ph with <img src="hero.jpg" alt="Babycakes tray cake" /> -->
  <div class="hero-ph">
    <div class="hero-ph-inner"></div>
  </div>
  <div class="hero-gradient"></div>
  <div class="wrap hero-wrap">
    <div class="hero-copy">
      <div class="tag tag-ow au" style="width:fit-content;margin-bottom:clamp(1.25rem,3vw,2rem)">New Drop Available Now</div>
      <h1 class="lf hero-h1 au au1">feel<br/>good<br/>food.</h1>
      <p class="hero-sub au au2">Born from <em>baby + cakes</em> — classic recipes reimagined for today. Crafted with warmth, intention, and heart.</p>
      <div class="hero-btns au au3">
        <a href="/bi-weekly" class="btn btn-y btn-lg">See This Week's Drop</a>
        <a href="/always-available" class="btn btn-ow">Always Available</a>
      </div>
    </div>
    <div class="hero-badge au au2">
      <span class="lf hb-n">babycakes</span>
      <span class="hb-t">feel good food</span>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">scroll</div>
</section>

<!-- MARQUEE -->
<div class="mq">
  <div class="mq-t">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Thai Tea","Cake Cube","Banoffee","Classic","Chocolate","feel good food","Baby Tray from ฿210","Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Thai Tea","Cake Cube","Banoffee","Classic","Chocolate","feel good food","Baby Tray from ฿210"].map(t=>(
      <span class="mq-i">{t}<span class="mq-dot"></span></span>
    ))}
  </div>
</div>

<!-- ══ BI-WEEKLY DROPS ══ -->
<section class="sec">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-y sh-eye">Updated Every Two Weeks</span>
        <h2 class="lf sh-h">Bi-Weekly<br/>Flavors.</h2>
      </div>
      <a href="/bi-weekly" class="btn btn-od">All Bi-Weekly</a>
    </div>

    <div class="drops-grid">
      <!-- Feature card — large -->
      <a href="/bi-weekly/strawberry-kiss" class="pc drops-big">
        <div class="pc-img drops-big-img">
          <div class="pc-ph">Upload hero flavor photo</div>
          <!-- <img src="strawberry-kiss.jpg" alt="Strawberry Kiss tray cake" /> -->
        </div>
        <div class="pc-body">
          <div class="pc-tag-row">
            <span class="tag tag-y">bi-weekly</span>
            <span class="pc-period">17 Feb – 13 March</span>
          </div>
          <h3 class="lf pc-name" style="font-size:clamp(1.35rem,2.5vw,1.75rem)">Strawberry Kiss</h3>
          <p class="pc-desc">Layered sponge with fresh strawberry cream. The season's most romantic slice — made to share.</p>
        </div>
      </a>

      <!-- Side cards -->
      <div class="drops-side">
        {drops.slice(1).map(d=>(
          <a href={"/bi-weekly/"+d.slug} class="pc drops-sm">
            <div class="pc-img" style={"aspect-ratio:16/9;position:relative"}>
              <div class="pc-ph" style={"background:linear-gradient(135deg,"+d.bg+" 0%,"+d.bg+"cc 100%)"}>{d.name} photo</div>
              <!-- <img src={d.slug+".jpg"} alt={d.name} /> -->
            </div>
            <div class="pc-body" style="padding:0.875rem 1rem 1rem">
              <div class="pc-tag-row"><span class="tag tag-y">bi-weekly</span><span class="pc-period">{d.period}</span></div>
              <div class="lf pc-name">{d.name}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ══ CLASSICS ══ -->
<section class="sec sec-cr">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-cr sh-eye">Always In Stock</span>
        <h2 class="lf sh-h">Our Classics.</h2>
      </div>
      <a href="/always-available" class="btn btn-od">See All Classics</a>
    </div>
    <div class="g3">
      {classics.map(c=>(
        <a href={"/always-available/"+c.slug} class="pc">
          <div class="pc-img" style={"aspect-ratio:4/3;position:relative"}>
            <div class="pc-ph" style={"background:linear-gradient(135deg,"+c.bg+" 0%,"+c.bg+"bb 100%)"}>Add {c.name} photo</div>
          </div>
          <div class="pc-body">
            <div class="pc-tag-row"><span class="tag tag-cr">always available</span></div>
            <div class="lf pc-name">{c.name}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ══ BRAND STORY — Lune-style: photo left, text right ══ -->
<section class="story-section">
  <div class="story-photo-col">
    <!-- Replace with: <img src="founder-nile.jpg" alt="Nile, Co-founder of Babycakes" /> -->
    <div class="story-ph">
      <span>Founder / store photo</span>
    </div>
    <div class="story-photo-credit">Pasiri "Nile" Tangkaravakun &amp; Natnicha "Tess" Burapachaisri, Co-founders</div>
  </div>
  <div class="story-text-col">
    <span class="tag tag-d sh-eye">Our Story</span>
    <h2 class="lf story-h2">Sweet moments,</h2>
    <h2 class="lf story-h2-soft">made to be cherished.</h2>
    <p class="story-p">Born from a 1999 family recipe and a belief that food baked with love tastes different. Babycakes started from a home kitchen in Bangna in 2021 — and grew into Bangkok's most-loved tray cake brand.</p>
    <p class="story-p">Baby Tray starts at ฿210. Available at 12+ points across Bangkok via walk-in, LINE, Grab, and LINE MAN.</p>
    <div class="story-nums">
      <div><strong class="lf">2021</strong><span>Founded</span></div>
      <div><strong class="lf">฿1M+</strong><span>Peak monthly</span></div>
      <div><strong class="lf">12+</strong><span>Locations</span></div>
    </div>
    <a href="/brand" class="btn btn-d btn-lg" style="margin-top:2.5rem">Read Our Story</a>
  </div>
</section>

<!-- ══ COLLABS STRIP ══ -->
<section class="sec-sm sec-cr">
  <div class="wrap">
    <div style="display:flex;align-items:center;justify-content:space-between;gap:1.5rem;flex-wrap:wrap;margin-bottom:2rem">
      <div>
        <span class="tag tag-line sh-eye">Partners &amp; Collabs</span>
        <h3 class="lf" style="font-size:clamp(1.5rem,3vw,2.25rem);color:var(--d);margin-top:0.5rem">We work with the best.</h3>
      </div>
      <a href="/collabs" class="btn btn-od btn-sm">All Collabs</a>
    </div>
    <!-- Logo grid — editable via CMS, placeholder blocks for now -->
    <div class="collab-logos">
      {["Refill Coffee","KitKat®","Only Grab","LINE MAN","Homeland"].map(b=>(
        <div class="collab-logo-ph">{b}</div>
      ))}
    </div>
  </div>
</section>

<!-- ══ CAREERS BAND ══ -->
<section class="sec-sm" style="background:var(--d)">
  <div class="wrap careers-row">
    <div>
      <span class="tag tag-y" style="margin-bottom:0.875rem">We're Hiring</span>
      <h3 class="lf" style="font-size:clamp(1.5rem,3.5vw,2.5rem);color:var(--y);line-height:1.1;margin-top:0.5rem">Join the Babycakes family.</h3>
      <p style="color:rgba(251,245,171,0.4);margin-top:0.625rem;font-size:0.875rem;line-height:1.75;max-width:380px">Passionate about feel-good food? We'd love to meet you.</p>
    </div>
    <a href="/careers" class="btn btn-y btn-lg">See Open Roles</a>
  </div>
</section>

</Base>
<style>
/* HERO */
.hero { position:relative; min-height:100svh; background:var(--dk); display:flex; flex-direction:column; justify-content:flex-end; overflow:hidden; }
.hero-ph { position:absolute; inset:0; }
.hero-ph-inner { position:absolute; inset:0; background:linear-gradient(145deg, var(--xdk) 0%, #3a2268 50%, #4C4378 100%); }
/* When photo added: .hero-ph img fills this space */
.hero-gradient { position:absolute; inset:0; background:linear-gradient(to top, rgba(18,10,40,0.95) 0%, rgba(18,10,40,0.6) 40%, rgba(18,10,40,0.15) 70%, transparent 100%); }
.hero-wrap { position:relative; z-index:2; display:flex; align-items:flex-end; justify-content:space-between; gap:2rem; padding-block:clamp(5rem,10vw,7rem); width:100%; }
.hero-h1 { font-size:clamp(4rem,14vw,11rem); color:var(--y); line-height:0.87; letter-spacing:-0.03em; margin-block:clamp(1.25rem,3vw,2rem); }
.hero-sub { font-size:clamp(0.95rem,1.6vw,1.05rem); color:rgba(251,245,171,0.48); line-height:1.9; max-width:440px; margin-bottom:clamp(1.75rem,4vw,2.75rem); }
.hero-sub em { color:var(--y); font-style:normal; font-weight:500; }
.hero-btns { display:flex; gap:0.875rem; flex-wrap:wrap; }
.hero-badge { width:clamp(125px,16vw,190px); aspect-ratio:1; border-radius:50%; background:var(--y); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.3rem; box-shadow:0 0 80px rgba(251,245,171,0.14); animation:popIn 0.7s var(--sp) 0.5s both; flex-shrink:0; }
.hb-n { font-size:clamp(0.85rem,1.6vw,1.3rem); color:var(--d); line-height:1; }
.hb-t { font-size:0.54rem; font-weight:500; letter-spacing:0.07em; color:var(--d); opacity:0.58; }
.hero-scroll { position:absolute; bottom:2rem; right:var(--px); font-size:0.54rem; font-weight:600; letter-spacing:0.22em; text-transform:uppercase; color:rgba(251,245,171,0.14); writing-mode:vertical-rl; z-index:2; }
@media(max-width:580px) { .hero-badge{display:none} .hero-wrap{flex-direction:column;align-items:flex-start} .hero-btns{flex-direction:column} .hero-btns .btn{width:100%;text-align:center} }

/* DROPS GRID */
.drops-grid { display:grid; grid-template-columns:1fr 1fr; gap:var(--gap); }
.drops-big { }
.drops-big-img { aspect-ratio:3/4; position:relative; }
.drops-side { display:flex; flex-direction:column; gap:var(--gap); }
@media(max-width:860px) { .drops-grid{grid-template-columns:1fr} .drops-big-img{aspect-ratio:16/9} .drops-side{display:grid;grid-template-columns:repeat(3,1fr)} }
@media(max-width:520px) { .drops-side{grid-template-columns:1fr} }

/* STORY */
.story-section { display:grid; grid-template-columns:1fr 1fr; }
.story-photo-col { position:relative; overflow:hidden; background:var(--d); min-height:clamp(480px,60vw,760px); }
.story-ph { position:absolute; inset:0; display:flex; align-items:center; justify-content:center; background:linear-gradient(145deg,var(--dk) 0%,#3a2060 100%); }
.story-ph span { font-size:0.65rem; font-weight:600; letter-spacing:0.1em; text-transform:uppercase; color:rgba(251,245,171,0.18); text-align:center; padding:2rem; }
.story-photo-credit { position:absolute; bottom:1.5rem; left:1.5rem; right:1.5rem; font-size:0.68rem; color:rgba(255,255,255,0.35); font-weight:500; z-index:2; }
.story-text-col { display:flex; flex-direction:column; justify-content:center; padding:clamp(3rem,7vw,7rem) clamp(2rem,5vw,6rem); background:var(--y); }
.story-h2 { font-family:'Shrikhand',serif; font-size:clamp(2.25rem,5vw,4rem); color:var(--d); line-height:1; }
.story-h2-soft { font-family:'DM Sans',sans-serif; font-size:clamp(1.25rem,2.5vw,2rem); font-weight:300; font-style:italic; color:var(--pm); margin-top:0.25rem; margin-bottom:1.75rem; }
.story-p { font-size:0.975rem; line-height:1.9; color:var(--d); opacity:0.7; }
.story-p+.story-p { margin-top:1rem; }
.story-nums { display:flex; gap:clamp(1.5rem,4vw,3rem); margin-top:clamp(1.75rem,4vw,2.5rem); padding-top:clamp(1.5rem,3.5vw,2.5rem); border-top:1.5px solid rgba(76,67,120,0.15); flex-wrap:wrap; }
.story-nums div { display:flex; flex-direction:column; gap:0.3rem; }
.story-nums strong { font-family:'Shrikhand',serif; font-size:clamp(1.5rem,3vw,2rem); color:var(--d); line-height:1; }
.story-nums span { font-size:0.6rem; font-weight:600; letter-spacing:0.09em; text-transform:uppercase; color:var(--pm); }
@media(max-width:768px) { .story-section{grid-template-columns:1fr;min-height:auto} .story-photo-col{min-height:clamp(280px,55vw,440px)} .story-text-col{padding:clamp(2.5rem,7vw,4rem) var(--px)} }

/* COLLABS */
.collab-logos { display:flex; align-items:center; gap:1.5rem; flex-wrap:wrap; }
.collab-logo-ph { height:44px; padding:0 1.5rem; background:var(--w); border:1px solid var(--g1); border-radius:var(--rm); display:flex; align-items:center; justify-content:center; font-size:0.75rem; font-weight:600; color:var(--g3); white-space:nowrap; }

.careers-row { display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap; }
@media(max-width:560px) { .careers-row{flex-direction:column;align-items:flex-start} .careers-row .btn{width:100%} }
</style>
