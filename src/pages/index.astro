---
import Base from '../layouts/Base.astro';
const drops = [
  { slug:"strawberry-kiss",  name:"Strawberry Kiss",      period:"17 Feb – 13 March", bg:"#5a1e2a" },
  { slug:"dubai-chocolate",  name:"Dubai Chocolate",       period:"17 Feb – 13 March", bg:"#100704" },
  { slug:"mayongchid",       name:"Mayongchid",            period:"11 – 17 April",     bg:"#6a4610" },
  { slug:"cheesecake",       name:"Cheesecake Blueberry",  period:"13 – 18 Feb",       bg:"#1c0e32" },
];
const classics = [
  { slug:"chocolate",  name:"Chocolate",  bg:"#160804" },
  { slug:"classic",    name:"Classic",    bg:"#3e2c10" },
  { slug:"thai-tea",   name:"Thai Tea",   bg:"#6a260a" },
];
// Collab logos — clean wordmarks, no blocks
const collabs = ["Refill Coffee","KitKat®","GrabFood","LINE MAN","Homeland"];
---
<Base title="Babycakes — Feel Good Food">

<!-- HERO -->
<section class="hero">
  <div class="dots"></div>
  <div class="hero-bg"></div>
  <div class="hero-ov"></div>
  <div class="wrap hero-wrap">
    <div class="hero-copy">
      <div class="tag tag-ow au" style="width:fit-content;margin-bottom:clamp(1.25rem,3vw,2rem)">New Drop Available Now</div>
      <h1 class="lf hero-h1 au au1">feel<br/>good<br/>food.</h1>
      <p class="hero-sub au au2">Born from <em>baby + cakes</em> — classic recipes reimagined for today.<br class="hero-br"/> Crafted with warmth, intention, and heart.</p>
      <div class="hero-btns au au3">
        <a href="/bi-weekly" class="btn btn-y btn-lg">See This Week's Drop</a>
        <a href="/always-available" class="btn btn-ow">Always Available</a>
      </div>
    </div>
    <div class="hero-badge au au2">
      <span class="lf hb-n">babycakes</span>
      <span class="hb-t">feel good food</span>
    </div>
  </div>
  <div class="hero-scroll" aria-hidden="true">scroll</div>
</section>

<!-- MARQUEE -->
<div class="mq">
  <div class="mq-t">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Thai Tea","Cake Cube","Banoffee","Classic","Chocolate","feel good food","Baby Tray from ฿210","Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Thai Tea","Cake Cube","Banoffee","Classic","Chocolate","feel good food","Baby Tray from ฿210"].map(t=>(
      <span class="mq-i">{t}<span class="mq-dot-el"></span></span>
    ))}
  </div>
</div>

<!-- BI-WEEKLY -->
<section class="sec">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-y sh-eye">Updated Every Two Weeks</span>
        <h2 class="lf sh-h">Bi-Weekly<br/>Flavors.</h2>
      </div>
      <a href="/bi-weekly" class="btn btn-od">All Drops</a>
    </div>
    <div class="drops-grid">
      <a href="/bi-weekly/strawberry-kiss" class="pc drops-big">
        <div class="pc-img drops-big-img" style="background:linear-gradient(145deg,#5a1e2a,#8a3044)">
          <div class="pc-ph">Upload flavor photo</div>
        </div>
        <div class="pc-body">
          <div class="pc-meta">
            <span class="tag tag-y">bi-weekly</span>
            <span class="pc-per">17 Feb – 13 March</span>
          </div>
          <div class="lf pc-name" style="font-size:clamp(1.35rem,2.5vw,1.75rem)">Strawberry Kiss</div>
          <p class="pc-desc">Layered sponge, fresh strawberry cream. The season's most romantic slice — made to share.</p>
        </div>
      </a>
      <div class="drops-side">
        {drops.slice(1).map(d=>(
          <a href={"/bi-weekly/"+d.slug} class="pc">
            <div class="pc-img" style={"aspect-ratio:16/9;background:linear-gradient(145deg,"+d.bg+","+d.bg+"aa)"}>
              <div class="pc-ph">{d.name} photo</div>
            </div>
            <div class="pc-body" style="padding:.875rem 1rem 1.1rem">
              <div class="pc-meta"><span class="tag tag-y">bi-weekly</span><span class="pc-per">{d.period}</span></div>
              <div class="lf pc-name">{d.name}</div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- CLASSICS -->
<section class="sec sec-cr">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-cr sh-eye">Always In Stock</span>
        <h2 class="lf sh-h">Our Classics.</h2>
      </div>
      <a href="/always-available" class="btn btn-od">See All</a>
    </div>
    <div class="g3">
      {classics.map(c=>(
        <a href={"/always-available/"+c.slug} class="pc">
          <div class="pc-img" style={"aspect-ratio:4/3;background:linear-gradient(145deg,"+c.bg+","+c.bg+"99)"}>
            <div class="pc-ph">{c.name} photo</div>
          </div>
          <div class="pc-body">
            <div class="pc-meta"><span class="tag tag-cr">always available</span></div>
            <div class="lf pc-name">{c.name}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- COLLABS — wordmarks, no blocks, no LINE links -->
<section class="sec-sm" style="background:var(--w);border-top:1px solid var(--g1);border-bottom:1px solid var(--g1)">
  <div class="wrap">
    <div class="collab-row">
      <p class="collab-label">Partners &amp; collaborations</p>
      <div class="collab-marks">
        {collabs.map(b=>(
          <span class="collab-mark">{b}</span>
        ))}
      </div>
      <a href="/collabs" class="collab-link">View all →</a>
    </div>
  </div>
</section>

<!-- CAREERS BAND -->
<section class="sec-sm" style="background:var(--d)">
  <div class="wrap careers-row">
    <div>
      <span class="tag tag-y" style="margin-bottom:.875rem">We're Hiring</span>
      <h3 class="lf" style="font-size:clamp(1.5rem,3.5vw,2.5rem);color:var(--y);line-height:1.1;margin-top:.5rem">Join the Babycakes family.</h3>
      <p style="color:rgba(251,245,171,.4);margin-top:.625rem;font-size:.9rem;line-height:1.75;max-width:360px">Passionate about feel-good food? We'd love to meet you.</p>
    </div>
    <a href="/careers" class="btn btn-y btn-lg">See Open Roles</a>
  </div>
</section>

</Base>
<style>
.hero{position:relative;min-height:100svh;background:var(--dk);display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:linear-gradient(145deg,var(--xdk) 0%,#3a2268 50%,var(--d) 100%)}
/* When photo: add <img> inside .hero-bg slot */
.hero-ov{position:absolute;inset:0;background:linear-gradient(to top,rgba(18,10,40,.95) 0%,rgba(18,10,40,.55) 40%,rgba(18,10,40,.1) 72%,transparent 100%)}
.hero-wrap{position:relative;z-index:2;display:flex;align-items:flex-end;justify-content:space-between;gap:2rem;padding-block:clamp(5rem,10vw,7.5rem);width:100%}
.hero-h1{font-size:clamp(3.75rem,13vw,10.5rem);color:var(--y);line-height:.87;letter-spacing:-.03em;margin-block:clamp(1.25rem,3vw,2rem)}
.hero-sub{font-size:clamp(.95rem,1.6vw,1.05rem);color:rgba(251,245,171,.48);line-height:1.9;max-width:440px;margin-bottom:clamp(1.75rem,4vw,2.75rem)}
.hero-sub em{color:var(--y);font-style:normal;font-weight:600}
.hero-br{display:none}
.hero-btns{display:flex;gap:.875rem;flex-wrap:wrap}
.hero-badge{width:clamp(120px,15vw,185px);aspect-ratio:1;border-radius:50%;background:var(--y);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.3rem;box-shadow:0 0 80px rgba(251,245,171,.14);animation:popIn .7s var(--sp) .5s both;flex-shrink:0}
.hb-n{font-size:clamp(.82rem,1.5vw,1.25rem);color:var(--d);line-height:1}
.hb-t{font-size:.52rem;font-weight:700;letter-spacing:.07em;color:var(--d);opacity:.58}
.hero-scroll{position:absolute;bottom:2rem;right:var(--px);font-size:.52rem;font-weight:700;letter-spacing:.22em;text-transform:uppercase;color:rgba(251,245,171,.13);writing-mode:vertical-rl;z-index:2}

/* Mobile hero adjustments */
@media(max-width:580px){
  .hero-badge{display:none}
  .hero-wrap{flex-direction:column;align-items:flex-start}
  .hero-h1{font-size:clamp(3.5rem,18vw,5.5rem)}
  .hero-btns{flex-direction:column;width:100%}
  .hero-btns .btn{width:100%;text-align:center}
  .hero-br{display:block}
}

/* DROPS GRID */
.drops-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--gap)}
.drops-big-img{aspect-ratio:3/4;position:relative}
.drops-side{display:flex;flex-direction:column;gap:var(--gap)}
@media(max-width:860px){
  .drops-grid{grid-template-columns:1fr}
  .drops-big-img{aspect-ratio:16/9}
  .drops-side{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap)}
}
@media(max-width:480px){.drops-side{grid-template-columns:1fr}}

/* COLLABS — clean wordmark strip */
.collab-row{display:flex;align-items:center;gap:clamp(1.5rem,4vw,4rem);flex-wrap:wrap}
.collab-label{font-size:.62rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--g2);white-space:nowrap;flex-shrink:0}
.collab-marks{display:flex;align-items:center;gap:clamp(1.25rem,3vw,3rem);flex-wrap:wrap;flex:1}
.collab-mark{
  font-size:clamp(.75rem,1.5vw,1rem);
  font-weight:700;
  color:var(--g2);
  letter-spacing:.01em;
  white-space:nowrap;
  transition:color .2s;
  cursor:default;
}
.collab-mark:hover{color:var(--d)}
.collab-link{font-size:.72rem;font-weight:700;color:var(--d);letter-spacing:.04em;margin-left:auto;white-space:nowrap;transition:opacity .15s;flex-shrink:0}
.collab-link:hover{opacity:.65}
@media(max-width:640px){.collab-row{gap:1.25rem}.collab-link{margin-left:0}}

.careers-row{display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap}
@media(max-width:560px){.careers-row{flex-direction:column;align-items:flex-start}.careers-row .btn{width:100%}}
</style>
