---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import orderLinks from '../content/settings/order-links.json';
import brandPhotos from '../content/settings/brand-photos.json';

const allDrops = await getCollection('weekly-updates', ({ data }) => !data.draft);
allDrops.sort((a,b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0));
const drops    = allDrops.slice(0, 6);
const allCls   = await getCollection('always-available', ({ data }) => data.available);
const classics = allCls.sort((a,b) => a.data.name.localeCompare(b.data.name));
const lineLink      = orderLinks.line_main    || 'https://lin.ee/babycakes';
const heroPhoto     = brandPhotos.hero_photo  || '';
const heroHeadline  = brandPhotos.hero_headline  || 'we feel good';
const heroMeta      = brandPhotos.hero_meta      || 'Baby Tray from ฿210 · 12+ Branches · Bangkok';
const heroBtnPrimary= brandPhotos.hero_btn_primary || "This Week's Drop";
const heroBtnGhost  = brandPhotos.hero_btn_ghost   || 'Always Available';
const bannerPhoto   = brandPhotos.feel_good_banner || heroPhoto;
---
<Base 
  title="Babycakes — We Feel Good" 
  description="Bangkok's most-loved tray cake. Classic recipes reimagined for today — bi-weekly flavors, 12+ branches, order via LINE."
>

<!-- ── HERO ── -->
<section class="hero">
  <div class="hero-img">
    {heroPhoto
      ? <img src={heroPhoto} alt="Babycakes" loading="eager" fetchpriority="high"/>
      : <div class="hero-img-ph"></div>
    }
  </div>
  <div class="hero-ov"></div>
  <div class="wrap hero-bottom">
    <h1 class="hero-h1 au">{heroHeadline}</h1>
    <p class="hero-meta au au1">{heroMeta}</p>
    <div class="hero-btns au au2">
      <a href="/bi-weekly" class="btn hero-btn-primary">{heroBtnPrimary}</a>
      <a href="/always-available" class="btn hero-btn-ghost">{heroBtnGhost}</a>
    </div>
  </div>
</section>

<!-- ── MARQUEE ── -->
<div class="mq">
  <div class="mq-t">
    {[...drops.map(d=>d.data.name),"we feel good","฿210",...drops.map(d=>d.data.name),"we feel good","฿210"].map(t=>(
      <span class="mq-i">{t}<span class="mq-dot-el"></span></span>
    ))}
  </div>
</div>

<!-- ── BI-WEEKLY DROPS ── -->
<section class="sec">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-y sh-eye" style="padding-inline:1.25rem">Every Two Weeks</span>
        <h2 class="sh-h" style="margin-top:.75rem">Bi-Weekly Flavors</h2>
      </div>
      <a href="/bi-weekly" class="btn btn-op btn-sm">View All</a>
    </div>
    <div class="drops-grid">
      {drops.map((d,i)=>(
        <a href={"/bi-weekly/"+d.data.slug} class="pc au" style={"animation-delay:"+i*.05+"s"}>
          <div class="pc-img" style={"aspect-ratio:3/4;background:"+(d.data.bg||'var(--d)')}>
            {d.data.image
              ? <img src={d.data.image} alt={d.data.name}/>
              : <div class="pc-ph">{d.data.name}</div>
            }
          </div>
          <div class="pc-body">
            <div class="pc-meta">
              <span class="tag tag-y">bi-weekly</span>
              <span class="pc-per">{d.data.period}</span>
            </div>
            <div class="pc-name">{d.data.name}</div>
            {d.data.desc && <p class="pc-desc">{d.data.desc}</p>}
          </div>
        </a>
      ))}
    </div>
    <div class="drops-more">
      <a href="/bi-weekly" class="btn btn-op">All Bi-Weekly Drops</a>
    </div>
  </div>
</section>

<!-- ── FULL BLEED BANNER ── -->
<div class="feel-banner">
  <img src={bannerPhoto} alt="Babycakes feel good" class="feel-banner-img" loading="lazy"/>
  <div class="feel-banner-overlay"></div>
  <div class="feel-banner-text">
    <span class="lf feel-banner-h">We Feel Good</span>
    <span class="feel-banner-sub">Bangkok's most-loved tray cake</span>
  </div>
</div>

<!-- ── CLASSICS ── -->
<section class="sec sec-cr">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-y sh-eye" style="padding-inline:1.25rem">Always In Stock</span>
        <h2 class="sh-h" style="margin-top:.75rem">Our Classics</h2>
      </div>
      <div class="classics-nav">
        <button class="classics-arr" id="classicsPrev" aria-label="Previous">&#8592;</button>
        <button class="classics-arr" id="classicsNext" aria-label="Next">&#8594;</button>
        <a href="/always-available" class="btn btn-op btn-sm">See All</a>
      </div>
    </div>
    <div class="classics-track" id="classicsTrack">
      {classics.map(c=>(
        <a href={"/always-available/"+c.data.slug} class="classics-card pc">
          <div class="pc-img" style={"aspect-ratio:3/2;background:"+(c.data.bg||'var(--d)')}>
            {c.data.image ? <img src={c.data.image} alt={c.data.name}/> : <div class="pc-ph">{c.data.name}</div>}
          </div>
          <div class="pc-body">
            <div class="pc-name">{c.data.name}</div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>



<!-- ── CAREERS ── -->
<section class="careers-band sec-sm">
  <div class="wrap">
    <div class="careers-inner">
      <div>
        <span class="tag tag-y" style="margin-bottom:.75rem">We're Hiring</span>
        <h3 class="careers-h">Join the Babycakes family</h3>
        <p class="careers-sub">Passionate about feel-good food? We'd love to meet you.</p>
      </div>
      <a href="/careers" class="btn btn-y careers-cta">See Open Roles</a>
    </div>
  </div>
</section>

</Base>
<style>
/* ── HERO ── */
.hero {
  position: relative;
  width: 100%;
  height: 100svh;
  min-height: 580px;
  background: #0e0c12;
  overflow: hidden;
  display: flex;
  flex-direction: column;
}
.hero-img { position: absolute; inset: 0; }
.hero-img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.hero-img-ph { position: absolute; inset: 0; background: linear-gradient(145deg, #1e1638 0%, #3a2060 50%, var(--p) 100%); }
.hero-ov {
  position: absolute; inset: 0;
  background: linear-gradient(to top, rgba(10,8,20,.93) 0%, rgba(10,8,20,.5) 42%, rgba(10,8,20,.08) 72%, transparent 100%);
}
/* Content — bottom center, no top label */
.hero-bottom {
  position: relative; z-index: 2;
  margin-top: auto;
  padding-bottom: clamp(3rem, 8vw, 5rem);
  padding-bottom: max(3rem, calc(env(safe-area-inset-bottom) + 2rem));
  display: flex; flex-direction: column;
  align-items: center; text-align: center;
}
.hero-h1 {
  font-family: var(--font);
  font-weight: 800; font-style: italic;
  font-size: clamp(2.75rem, 12vw, 5rem);
  color: rgba(255,255,255,.93);
  line-height: .95; letter-spacing: -.03em;
  margin-bottom: .875rem;
}
.hero-meta {
  font-family: var(--font);
  font-size: .62rem; font-weight: 600;
  letter-spacing: .14em; text-transform: uppercase;
  color: rgba(255,255,255,.28);
  margin-bottom: 1.75rem; line-height: 1.6;
}
.hero-btns { display: flex; gap: .625rem; flex-wrap: wrap; justify-content: center; width: 100%; max-width: 340px; }
.hero-btn-primary {
  flex: 1;
  background: transparent;
  border: 1.5px solid rgba(255,255,255,.4);
  color: rgba(255,255,255,.9);
  font-family: var(--font); font-size: .78rem; font-weight: 700;
  letter-spacing: .07em; text-transform: uppercase;
  padding: .9rem 1.25rem; border-radius: var(--r);
  min-height: 50px; white-space: nowrap;
}
.hero-btn-primary:active { background: rgba(255,255,255,.1); }
.hero-btn-ghost {
  background: transparent; border: none;
  font-family: var(--font); color: rgba(255,255,255,.35);
  font-size: .72rem; font-weight: 500;
  letter-spacing: .07em; text-transform: uppercase;
  text-decoration: underline; text-underline-offset: 4px;
  padding: .9rem 0; min-height: 50px;
}

/* ── DROPS GRID — clean 2-col on mobile ── */
.drops-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: var(--gap);
}
@media (min-width: 1024px) { .drops-grid { grid-template-columns: repeat(3, 1fr); } }
.drops-more { margin-top: clamp(1.5rem, 3vw, 2.5rem); text-align: center; }

/* ── CLASSICS ── */
.classics-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: var(--gap);
}


.partners-row {
  display: flex; align-items: center;
  gap: 1.25rem; overflow: hidden;
}
.partners-label {
  font-family: var(--font); font-size: .55rem; font-weight: 700;
  letter-spacing: .14em; text-transform: uppercase;
  color: var(--g2); white-space: nowrap; flex-shrink: 0;
}
.partners-list {
  display: flex; align-items: center;
  gap: 1.25rem; flex: 1;
  overflow-x: auto; scrollbar-width: none;
  -webkit-overflow-scrolling: touch;
}
.partners-list::-webkit-scrollbar { display: none; }
.partners-item {
  font-family: var(--font); font-size: .78rem; font-weight: 700;
  color: var(--g2); white-space: nowrap;
  transition: color .15s;
}
.partners-link {
  font-family: var(--font); font-size: .72rem; font-weight: 700;
  color: var(--p); white-space: nowrap; flex-shrink: 0;
  transition: opacity .15s;
}
.partners-link:hover { opacity: .65; }

/* ── CAREERS ── */
.careers-band { background: var(--d); }
.careers-inner {
  display: flex; align-items: center;
  justify-content: space-between; gap: 2rem; flex-wrap: wrap;
}
.careers-h {
  font-family: var(--font); font-weight: 800; font-style: italic;
  font-size: clamp(1.5rem, 3.5vw, 2.5rem); color: var(--y);
  line-height: 1.1; margin-top: .5rem;
}
.careers-sub {
  font-family: var(--font); color: rgba(255,255,255,.55);
  margin-top: .4rem; font-size: .875rem; line-height: 1.65;
  max-width: 320px;
}

/* ── FEEL GOOD BANNER ── */
.feel-banner {
  position: relative;
  height: clamp(320px, 45vw, 560px);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.feel-banner-img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center 30%;
  transform: scale(1.04);
  transition: transform 8s ease;
}
.feel-banner:hover .feel-banner-img { transform: scale(1); }
.feel-banner-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    to bottom,
    rgba(30,22,56,.35) 0%,
    rgba(30,22,56,.55) 100%
  );
  z-index: 1;
}
.feel-banner-text {
  position: relative;
  z-index: 2;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.feel-banner-h {
  font-size: clamp(3rem, 10vw, 8rem);
  color: var(--y);
  line-height: 1;
  letter-spacing: -.02em;
  text-shadow: 0 2px 32px rgba(0,0,0,.4);
}
.feel-banner-sub {
  font-family: var(--font);
  font-size: clamp(.75rem, 1.5vw, .95rem);
  font-weight: 600;
  letter-spacing: .18em;
  text-transform: uppercase;
  color: rgba(255,255,255,.6);
}

/* ── CLASSICS CAROUSEL ── */
.classics-nav {
  display: flex;
  align-items: center;
  gap: .75rem;
}
.classics-arr {
  width: 36px; height: 36px;
  border-radius: 50%;
  border: 1.5px solid var(--g1);
  background: var(--w);
  color: var(--d);
  font-size: 1rem;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all .2s;
  flex-shrink: 0;
}
.classics-arr:hover {
  background: var(--d);
  color: var(--y);
  border-color: var(--d);
}
.classics-arr:active { transform: scale(.93); }
.classics-track {
  display: flex;
  gap: 1rem;
  overflow-x: auto;
  scroll-snap-type: x mandatory;
  scroll-behavior: smooth;
  -webkit-overflow-scrolling: touch;
  padding-bottom: .5rem;
  /* Hide scrollbar */
  scrollbar-width: none;
}
.classics-track::-webkit-scrollbar { display: none; }
.classics-card {
  flex: 0 0 260px;
  scroll-snap-align: start;
  text-decoration: none;
  background: var(--w);
  border: 1px solid var(--g1);
  border-radius: var(--rm);
  overflow: hidden;
}
.classics-card .pc-body {
  padding: .875rem 1rem 1rem;
}
.classics-card .pc-name {
  font-size: .95rem;
  color: var(--d);
}
@media (max-width: 768px) {
  .classics-card { flex: 0 0 220px; }
  .feel-banner { height: clamp(220px, 55vw, 360px); }
  .feel-banner-h { font-size: clamp(2.5rem, 14vw, 5rem); }
}

/* ── CARD ANIMATION ── */
.pc { opacity: 0; transform: translateY(14px); }
.pc.in-view { opacity: 1; transform: translateY(0); transition: opacity .4s var(--ease), transform .4s var(--ease); }

/* ══════════════════════════════════════════
   MOBILE OVERRIDES — homepage
══════════════════════════════════════════ */
@media (max-width: 768px) {
  /* Hero — full bleed */
  .hero { min-height: 100svh; }
  .hero-h1 { font-size: clamp(2.5rem, 11vw, 3.5rem); }
  .hero-btns { flex-direction: column; max-width: 100%; }
  .hero-btn-primary { width: 100%; text-align: center; }

  /* Classics — 2 col */
  .classics-grid { grid-template-columns: repeat(2, 1fr); gap: .625rem; }
  .classics-grid .pc-desc { display: none; }

  /* Careers — stack */
  .careers-inner { flex-direction: column; align-items: flex-start; gap: 1.25rem; }
  .careers-cta { width: 100%; justify-content: center; }

  /* Order bar visible */
  .order-bar { display: flex; }

}

@media (max-width: 480px) {
  .drops-grid { gap: .5rem; }
  .pc-body { padding: .75rem .75rem .875rem; }
  .pc-name { font-size: .9rem; }
  .pc-desc { display: none; }
  .pc-per { display: none; } /* too cramped on small screens */
}
</style>
<script>
const track = document.getElementById('classicsTrack');
const prev  = document.getElementById('classicsPrev');
const next  = document.getElementById('classicsNext');
if (track && prev && next) {
  const scrollAmt = () => track.querySelector('.classics-card')?.offsetWidth + 16 || 296;
  prev.addEventListener('click', () => track.scrollBy({ left: -scrollAmt(), behavior: 'smooth' }));
  next.addEventListener('click', () => track.scrollBy({ left:  scrollAmt(), behavior: 'smooth' }));
}
</script>

