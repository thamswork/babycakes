---
import Base from '../layouts/Base.astro';
const featured = [
  { slug:"strawberry-kiss",  name:"Strawberry Kiss",     period:"17 Feb – 13 March", bg:"#96404f", desc:"Layered sponge, fresh strawberry cream. The season's most romantic slice." },
  { slug:"dubai-chocolate",  name:"Dubai Chocolate",      period:"17 Feb – 13 March", bg:"#1a0a04", desc:"Crispy knafeh, dark chocolate. A viral sensation, perfected." },
  { slug:"mayongchid",       name:"Mayongchid",           period:"11 – 17 April",     bg:"#9a6010", desc:"Thai mango custard. Seasonal and gone before you know it." },
  { slug:"cheesecake",       name:"Cheesecake Blueberry", period:"13 – 18 Feb",       bg:"#2d1848", desc:"Velvety cheesecake, jammy blueberry. A classic." },
];
const classics = [
  { slug:"chocolate", name:"Chocolate",  bg:"#241008" },
  { slug:"classic",   name:"Classic",    bg:"#6b4e22" },
  { slug:"thai-tea",  name:"Thai Tea",   bg:"#9e3e10" },
];
---
<Base title="Babycakes — Feel Good Food">

<section class="hero">
  <div class="dots"></div>
  <div class="wrap hero-wrap">
    <div class="hero-copy">
      <div class="tag tag-ow au" style="width:fit-content;margin-bottom:1.75rem">Bi-Weekly Flavors Available Now</div>
      <h1 class="lf hero-h1 au au1">feel<br/>good<br/>food.</h1>
      <p class="hero-body au au2">Born from <em>baby&nbsp;+&nbsp;cakes</em> — classic recipes reimagined for today. Baked with warmth, intention, and heart.</p>
      <div class="hero-btns au au3">
        <a href="/bi-weekly" class="btn btn-y">See This Week's Flavors</a>
        <a href="/always-available" class="btn btn-gh">Always Available</a>
      </div>
    </div>
    <div class="hero-badge au au2">
      <span class="lf hb-name">babycakes</span>
      <span class="hb-tag">feel good food</span>
    </div>
  </div>
  <div class="hero-scroll">scroll</div>
</section>

<div class="mq">
  <div class="mq-t">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Thai Tea","Cake Cube","Banoffee","All-star Flavors","Classic","Chocolate","feel good food","Strawberry Kiss","Dubai Chocolate","Mayongchid","Cheesecake Blueberry","Nomyen","Thai Tea","Cake Cube","Banoffee","All-star Flavors","Classic","Chocolate","feel good food"].map(t=>(
      <span class="mq-i">{t}<span class="mq-dot">&#9632;</span></span>
    ))}
  </div>
</div>

<section class="sec">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-o sh-eye">Updated Every Two Weeks</span>
        <h2 class="lf sh-h" style="margin-top:0.875rem">Bi-Weekly Flavors.</h2>
      </div>
      <a href="/bi-weekly" class="btn btn-d">All Bi-Weekly</a>
    </div>
    <div class="home-flavor-grid">
      <a href="/bi-weekly/strawberry-kiss" class="fc home-fc-lg" style="--fc-bg:#96404f">
        <div class="fc-ov"></div>
        <div class="fc-body">
          <span class="tag tag-ow">bi-weekly</span>
          <h3 class="lf fc-name" style="font-size:2.25rem;margin-top:0.75rem">Strawberry Kiss</h3>
          <p class="fc-desc">Layered sponge, fresh strawberry cream. The season's most romantic slice — made to share.</p>
          <span class="fc-period">17 Feb – 13 March</span>
        </div>
      </a>
      <div class="home-fc-grid">
        {featured.slice(1).map(f=>(
          <a href={"/bi-weekly/"+f.slug} class="fc" style={"--fc-bg:"+f.bg+";min-height:200px"}>
            <div class="fc-ov"></div>
            <div class="fc-body">
              <span class="tag tag-ow">bi-weekly</span>
              <h3 class="lf fc-name" style="font-size:1.3rem">{f.name}</h3>
              <span class="fc-period">{f.period}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<section class="sec" style="background:var(--cr)">
  <div class="wrap">
    <div class="sh">
      <div>
        <span class="tag tag-o sh-eye">Always In Stock</span>
        <h2 class="lf sh-h" style="margin-top:0.875rem">Our Classics.</h2>
      </div>
      <a href="/always-available" class="btn btn-d">See All Classics</a>
    </div>
    <div class="g3">
      {classics.map(c=>(
        <a href={"/always-available/"+c.slug} class="fc" style={"--fc-bg:"+c.bg+";min-height:280px"}>
          <div class="fc-ov"></div>
          <div class="fc-body">
            <span class="tag tag-ow">always available</span>
            <h3 class="lf fc-name" style="font-size:1.75rem">{c.name}</h3>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<section class="story-sec">
  <div class="wrap story-wrap">
    <div>
      <span class="tag tag-d sh-eye">Our Story</span>
      <h2 class="lf" style="font-size:clamp(2.5rem,5vw,4rem);color:var(--d);line-height:1.02;margin-top:0.875rem;margin-bottom:1.75rem">Sweet moments,<br/><span style="font-family:'Nunito',sans-serif;font-weight:400;font-style:italic;font-size:0.72em;color:var(--p)">made to be cherished.</span></h2>
      <a href="/brand" class="btn btn-d">Read Our Story</a>
    </div>
    <div class="story-text">
      <p>Babycakes was born from a simple belief: that food baked with love tastes different. Every cake is crafted with warmth, intention, and heart — inspired by timeless family recipes passed down through generations.</p>
      <p>Soft, nostalgic, and comforting like a taste of home. Sweet moments that become memories.</p>
      <div class="story-nums">
        <div><strong class="lf">10</strong><span>Bangkok Branches</span></div>
        <div><strong class="lf">88K+</strong><span>Community</span></div>
        <div><strong class="lf">2021</strong><span>Founded</span></div>
      </div>
    </div>
  </div>
</section>

<section class="sec-sm" style="background:var(--d)">
  <div class="wrap cta-row">
    <div>
      <span class="tag tag-y" style="margin-bottom:0.875rem">We're Hiring</span>
      <h3 class="lf" style="font-size:clamp(1.75rem,3vw,2.5rem);color:var(--y);line-height:1.1;margin-top:0.5rem">Join the Babycakes family.</h3>
    </div>
    <a href="/careers" class="btn btn-y">See Open Roles</a>
  </div>
</section>

</Base>
<style>
.hero { position:relative; min-height:100svh; background:var(--d); display:flex; align-items:flex-end; overflow:hidden; }
.hero-wrap { display:grid; grid-template-columns:1fr auto; align-items:flex-end; gap:4rem; padding-top:9rem; padding-bottom:clamp(4rem,8vw,6.5rem); width:100%; position:relative; z-index:2; }
.hero-h1 { font-size:clamp(4.5rem,13vw,10.5rem); color:var(--y); line-height:0.88; letter-spacing:-0.03em; margin-block:1.75rem; }
.hero-body { font-size:clamp(0.95rem,1.6vw,1.1rem); color:rgba(251,245,171,0.55); line-height:1.85; max-width:480px; margin-bottom:2.5rem; }
.hero-body em { color:var(--y); font-style:normal; font-weight:700; }
.hero-btns { display:flex; gap:0.875rem; flex-wrap:wrap; }
.hero-badge { width:clamp(150px,18vw,210px); aspect-ratio:1; border-radius:50%; background:var(--y); display:flex; flex-direction:column; align-items:center; justify-content:center; gap:0.3rem; box-shadow:0 0 80px rgba(251,245,171,0.15); animation:popIn 0.7s var(--sp) 0.5s both; flex-shrink:0; }
.hb-name { font-size:clamp(0.9rem,1.8vw,1.35rem); color:var(--d); line-height:1; }
.hb-tag  { font-size:0.58rem; font-weight:700; letter-spacing:0.06em; color:var(--d); opacity:0.6; }
.hero-scroll { position:absolute; bottom:2rem; right:var(--px); font-size:0.58rem; font-weight:800; letter-spacing:0.2em; text-transform:uppercase; color:rgba(251,245,171,0.18); writing-mode:vertical-rl; z-index:2; }
@media(max-width:640px){ .hero-badge { display:none; } .hero-wrap { grid-template-columns:1fr; } }
.home-flavor-grid { display:grid; grid-template-columns:1.4fr 1fr; gap:1.5rem; }
.home-fc-lg { min-height:520px; }
.home-fc-grid { display:grid; grid-template-rows:repeat(3,1fr); gap:1.5rem; }
@media(max-width:900px){ .home-flavor-grid { grid-template-columns:1fr; } .home-fc-lg { min-height:360px; } .home-fc-grid { grid-template-columns:repeat(3,1fr); grid-template-rows:auto; } }
@media(max-width:560px){ .home-fc-grid { grid-template-columns:1fr; } }
.story-sec { background:var(--y); padding-block:clamp(5rem,9vw,8rem); }
.story-wrap { display:grid; grid-template-columns:1fr 1fr; gap:clamp(3rem,7vw,8rem); align-items:center; }
.story-text p { font-size:1rem; line-height:1.9; color:var(--d); opacity:0.78; }
.story-text p + p { margin-top:1.1rem; }
.story-nums { display:flex; gap:2.5rem; margin-top:2.5rem; padding-top:2.5rem; border-top:1.5px solid rgba(76,67,120,0.15); flex-wrap:wrap; }
.story-nums div { display:flex; flex-direction:column; gap:0.3rem; }
.story-nums strong { font-size:1.75rem; color:var(--d); line-height:1; }
.story-nums span { font-size:0.65rem; font-weight:700; letter-spacing:0.07em; text-transform:uppercase; color:var(--p); }
@media(max-width:768px){ .story-wrap { grid-template-columns:1fr; } }
.cta-row { display:flex; align-items:center; justify-content:space-between; gap:2rem; flex-wrap:wrap; }
</style>
