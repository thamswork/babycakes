---
import Base from '../layouts/Base.astro';
const flavors=[
  {name:"Strawberry Kiss",period:"17 Feb – 13 March",tag:"bi-weekly",bg:"#c98fa0",txt:"The season's most romantic slice. Layered sponge with strawberry cream, made to share."},
  {name:"Dubai Chocolate",period:"17 Feb – 13 March",tag:"bi-weekly",bg:"#2a1508",txt:"A viral sensation. Crispy knafeh, rich dark chocolate — the cake that broke the internet."},
  {name:"Mayongchid",period:"11 – 17 April",tag:"bi-weekly",bg:"#d4890a",txt:"Thai mango custard. Seasonal, sun-golden, and gone before you know it."},
  {name:"Cheesecake Blueberry",period:"13 – 18 Feb",tag:"weekly",bg:"#3d2460",txt:"Velvety cheesecake meets jammy blueberry. A classic, perfected with care."},
  {name:"Nomyen",period:"13 – 18 Feb",tag:"weekly",bg:"#e8a0b0",txt:"Thai milk tea — the comfort of home in every soft, pink bite."},
  {name:"Cake Cube",period:"New Drop",tag:"new",bg:"#1a1a1a",txt:"Our iconic flavors in a bold new format. Box of joy — available at select spots."},
];
---
<Base title="Babycakes — Feel Good Food" description="Born from baby + cakes. Classic recipes reimagined for today.">

<!-- HERO -->
<section style="min-height:100svh;background:var(--pd);display:flex;flex-direction:column;justify-content:flex-end;padding:0 0 5rem;position:relative;overflow:hidden">
  <!-- BG pattern -->
  <div style="position:absolute;inset:0;opacity:0.04;background-image:radial-gradient(circle,#fff 1px,transparent 1px);background-size:28px 28px"></div>
  
  <div style="position:relative;z-index:2;padding:0 var(--px)">
    <div class="tag tag-y au" style="margin-bottom:1.5rem">✦ Weekly Flavors Available Now</div>
    <div style="display:grid;grid-template-columns:1fr auto;align-items:flex-end;gap:2rem;flex-wrap:wrap">
      <div>
        <h1 class="logo au au-1" style="font-size:clamp(4.5rem,14vw,10rem);color:var(--y);line-height:0.9;letter-spacing:-0.03em">feel<br/>good<br/>food.</h1>
      </div>
      <div class="au au-2" style="animation:popin 0.6s cubic-bezier(0.34,1.56,0.64,1) 0.3s both">
        <div style="width:clamp(140px,18vw,220px);aspect-ratio:1;border-radius:50%;background:var(--y);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:0.3rem;box-shadow:0 0 80px rgba(251,245,171,0.2)">
          <span class="logo" style="font-size:clamp(1rem,2.5vw,1.6rem);color:var(--pd)">babycakes</span>
          <span style="font-size:0.65rem;font-weight:700;color:var(--pd);letter-spacing:0.05em">feel good food ·</span>
        </div>
      </div>
    </div>
    <p class="au au-3" style="margin-top:2rem;font-size:clamp(1rem,2vw,1.2rem);color:rgba(251,245,171,0.65);max-width:520px;line-height:1.7">Born from <strong style="color:var(--y);font-style:italic">baby + cakes</strong> — inspired by timeless family recipes passed through generations. Sweet moments, made to be cherished.</p>
    <div class="au au-4" style="display:flex;gap:1rem;margin-top:2.5rem;flex-wrap:wrap">
      <a href="/weekly-updates" class="btn btn-y">See This Week's Flavors →</a>
      <a href="/brand" class="btn btn-ghost">Our Story</a>
    </div>
  </div>

  <!-- Scroll hint -->
  <div style="position:absolute;bottom:2rem;right:var(--px);color:rgba(251,245,171,0.3);font-size:0.72rem;font-weight:700;letter-spacing:0.1em;text-transform:uppercase;writing-mode:vertical-rl">scroll</div>
</section>

<!-- MARQUEE -->
<div class="marquee">
  <div class="marquee-track">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Cake Cube","Party Tray","Thai Tea","All-star Flavors","feel good food","Custom Message Cakes","Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Cake Cube","Party Tray","Thai Tea","All-star Flavors","feel good food","Custom Message Cakes"].map(t=>(
      <span class="marquee-item">{t}<span class="marquee-dot">✦</span></span>
    ))}
  </div>
</div>

<!-- FLAVOR GRID (Pidapipó journal style) -->
<section style="padding:6rem var(--px)">
  <div style="max-width:1400px;margin:0 auto">
    <div style="display:flex;align-items:flex-end;justify-content:space-between;margin-bottom:3.5rem;flex-wrap:wrap;gap:1rem">
      <div>
        <div class="tag tag-o" style="margin-bottom:0.75rem">Updated Weekly</div>
        <h2 class="logo" style="font-size:clamp(2.5rem,6vw,4.5rem);color:var(--pd);line-height:1">This Week's<br/>Flavors.</h2>
      </div>
      <a href="/weekly-updates" class="btn btn-p">All Updates →</a>
    </div>

    <!-- Hero card + side cards (YouMakeMe layout) -->
    <div style="display:grid;grid-template-columns:1.4fr 1fr;grid-template-rows:auto auto;gap:1.5rem">
      <!-- BIG card -->
      <a href="/weekly-updates/strawberry-kiss" style="grid-row:span 2;background:#c98fa0;border-radius:1.5rem;overflow:hidden;position:relative;min-height:600px;display:flex;flex-direction:column;justify-content:flex-end;padding:2rem;transition:transform 0.3s ease,box-shadow 0.3s ease" onmouseover="this.style.transform='scale(1.01)';this.style.boxShadow='0 20px 60px rgba(76,67,120,0.25)'" onmouseout="this.style.transform='scale(1)';this.style.boxShadow='none'">
        <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.6) 0%,transparent 55%)"></div>
        <div style="position:relative;z-index:2">
          <span class="tag tag-y" style="margin-bottom:0.75rem">bi-weekly</span>
          <h3 class="logo" style="font-size:3rem;color:#fff;line-height:1;margin-bottom:0.5rem">Strawberry Kiss</h3>
          <p style="color:rgba(255,255,255,0.8);font-size:0.9rem;line-height:1.6;margin-bottom:0.75rem">The season's most romantic slice. Layered sponge with strawberry cream.</p>
          <span style="color:rgba(255,255,255,0.55);font-size:0.75rem;font-weight:700">17 Feb – 13 March</span>
        </div>
      </a>
      {flavors.slice(1,5).map((f,i)=>(
        <a href={`/weekly-updates/${f.name.toLowerCase().replace(/ /g,'-')}`} style={`background:${f.bg};border-radius:1.25rem;overflow:hidden;position:relative;min-height:260px;display:flex;flex-direction:column;justify-content:flex-end;padding:1.5rem;transition:transform 0.25s ease,box-shadow 0.25s ease`} onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 40px rgba(76,67,120,0.2)'" onmouseout="this.style.transform='translateY(0)';this.style.boxShadow='none'">
          <div style="position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,0.65) 0%,transparent 60%)"></div>
          <div style="position:relative;z-index:2">
            <span class="tag tag-y" style="margin-bottom:0.5rem">{f.tag}</span>
            <h3 class="logo" style="font-size:1.6rem;color:#fff;line-height:1.1;margin-bottom:0.25rem">{f.name}</h3>
            <span style="color:rgba(255,255,255,0.5);font-size:0.7rem;font-weight:700">{f.period}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- STORY SECTION (full bleed, editorial) -->
<section style="background:var(--y);padding:7rem var(--px)">
  <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:1fr 1fr;gap:6rem;align-items:center">
    <div>
      <div class="tag tag-p" style="margin-bottom:1.5rem">Our Story</div>
      <h2 class="logo" style="font-size:clamp(2.5rem,5vw,4rem);color:var(--pd);line-height:1.05;margin-bottom:2rem">Sweet moments,<br/><em style="font-family:'Nunito',sans-serif;font-style:italic;font-size:0.75em;font-weight:400">made to be cherished.</em></h2>
      <a href="/brand" class="btn btn-p">Read Our Brand Story →</a>
    </div>
    <div>
      <p style="font-size:1.15rem;line-height:1.85;color:var(--pd);margin-bottom:1.5rem;opacity:0.85">Babycakes was born from a simple belief: that food baked with love tastes different. Every cake is crafted with warmth, intention, and heart — inspired by timeless family recipes passed down through generations.</p>
      <p style="font-size:1.05rem;line-height:1.8;color:var(--pd);opacity:0.7">Soft, nostalgic, and comforting like a taste of home. We believe in sweet moments that become memories — the kind you'll want to share with everyone you love.</p>
    </div>
  </div>
</section>

<!-- STATS BAR -->
<section style="background:var(--pd);padding:4rem var(--px)">
  <div style="max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(4,1fr);gap:2rem;text-align:center">
    {[{n:"Weekly",l:"New Flavors",i:"✦"},{n:"100%",l:"Baked Fresh Daily",i:"◎"},{n:"Custom",l:"Message Cakes",i:"✎"},{n:"Feel",l:"Good Food Promise",i:"♡"}].map(s=>(
      <div style="padding:2rem 1rem">
        <div style="font-size:1.5rem;color:var(--y);margin-bottom:0.5rem">{s.i}</div>
        <div class="logo" style="font-size:2.2rem;color:var(--y);line-height:1;margin-bottom:0.4rem">{s.n}</div>
        <div style="font-size:0.78rem;font-weight:700;color:rgba(251,245,171,0.6);letter-spacing:0.04em;text-transform:uppercase">{s.l}</div>
      </div>
    ))}
  </div>
</section>

</Base>
