---
import Base from '../layouts/Base.astro';
const flavors=[
  {slug:"strawberry-kiss",name:"Strawberry Kiss",period:"17 Feb – 13 March",tag:"bi-weekly",bg:"#b5606e",desc:"The season's most romantic slice. Layered sponge with strawberry cream."},
  {slug:"dubai-chocolate",name:"Dubai Chocolate",period:"17 Feb – 13 March",tag:"bi-weekly",bg:"#221009",desc:"Crispy knafeh, dark chocolate. A viral sensation, reimagined."},
  {slug:"mayongchid",name:"Mayongchid",period:"11 – 17 April",tag:"bi-weekly",bg:"#c17d10",desc:"Thai mango custard. Seasonal, sun-golden, gone before you know it."},
  {slug:"cheesecake",name:"Cheesecake Blueberry",period:"13 – 18 Feb",tag:"weekly",bg:"#3d2460",desc:"Velvety cheesecake meets jammy blueberry."},
  {slug:"nomyen",name:"Nomyen",period:"13 – 18 Feb",tag:"weekly",bg:"#d4849a",desc:"Thai milk tea — comfort of home in every soft bite."},
];
---
<Base title="Babycakes — Feel Good Food">

<!-- HERO -->
<section class="hero">
  <div class="dots"></div>
  <div class="wrap hero-grid">
    <div class="hero-left">
      <div class="tag tag-w au" style="width:fit-content;margin-bottom:1.5rem">✦ Weekly Flavors Available Now</div>
      <h1 class="lf hero-h1 au au1">feel<br/>good<br/>food.</h1>
      <p class="hero-body au au2">Born from <strong>baby + cakes</strong> — classic recipes reimagined for today. Baked with warmth, intention, and heart. Sweet moments, made to be cherished.</p>
      <div class="hero-btns au au3">
        <a href="/weekly-updates" class="btn btn-y">See This Week's Flavors →</a>
        <a href="/brand" class="btn btn-gh">Our Story</a>
      </div>
    </div>
    <div class="hero-right">
      <div class="hero-circle au au2">
        <span class="lf hero-circle-name">babycakes</span>
        <span class="hero-circle-sub">feel good food ·</span>
      </div>
    </div>
  </div>
  <div class="hero-scroll">scroll ↓</div>
</section>

<!-- MARQUEE -->
<div class="mq-strip">
  <div class="mq-track">
    {["Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Cake Cube","Party Tray","Thai Tea","All-star Flavors","feel good food","Custom Cakes","Strawberry Kiss","Dubai Chocolate","Mayongchid","Banoffee","Cheesecake Blueberry","Nomyen","Cake Cube","Party Tray","Thai Tea","All-star Flavors","feel good food","Custom Cakes"].map(t=>(
      <span class="mq-item">{t}<span class="mq-dot">✦</span></span>
    ))}
  </div>
</div>

<!-- FLAVORS -->
<section class="sec">
  <div class="wrap">
    <div class="sh">
      <div>
        <div class="tag tag-o" style="margin-bottom:.9rem">Updated Every Week</div>
        <h2 class="lf sh-title">This Week's<br/>Flavors.</h2>
      </div>
      <a href="/weekly-updates" class="btn btn-p">All Updates →</a>
    </div>
    <div class="fhg">
      <a href="/weekly-updates/strawberry-kiss" class="fcard fbig" style="--cb:#b5606e">
        <div class="fov"></div>
        <div class="fc">
          <span class="tag tag-w" style="margin-bottom:.75rem">bi-weekly</span>
          <h3 class="lf fcnbig">Strawberry Kiss</h3>
          <p class="fcdesc">The season's most romantic slice. Layered sponge with strawberry cream — made to share.</p>
          <span class="fcper">17 Feb – 13 March</span>
        </div>
      </a>
      <div class="fsg">
        {flavors.slice(1).map(f=>(
          <a href={"/weekly-updates/"+f.slug} class="fcard fsm" style={"--cb:"+f.bg}>
            <div class="fov"></div>
            <div class="fc">
              <span class="tag tag-w" style="margin-bottom:.4rem">{f.tag}</span>
              <h3 class="lf fcnsm">{f.name}</h3>
              <span class="fcper">{f.period}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- STORY -->
<section class="story-sec">
  <div class="wrap story-g">
    <div>
      <div class="tag tag-p" style="margin-bottom:1.25rem">Our Story</div>
      <h2 class="lf story-h2">Sweet moments,<br/><span class="story-sub">made to be cherished.</span></h2>
      <a href="/brand" class="btn btn-p" style="margin-top:2.5rem">Read Our Story →</a>
    </div>
    <div>
      <p class="story-body">Babycakes was born from a simple belief: that food baked with love tastes different. Every cake is crafted with warmth, intention, and heart — inspired by timeless family recipes passed down through generations.</p>
      <p class="story-body" style="margin-top:1.25rem;opacity:.7">Soft, nostalgic, and comforting like a taste of home. We believe in sweet moments that become memories — the kind you'll want to share with everyone you love.</p>
    </div>
  </div>
</section>

<!-- STATS -->
<section class="stats-sec">
  <div class="wrap stats-g">
    {[{n:"Weekly",l:"New Flavors",i:"✦"},{n:"100%",l:"Baked Fresh Daily",i:"◎"},{n:"Custom",l:"Message Cakes",i:"✎"},{n:"Feel",l:"Good Food Promise",i:"♡"}].map(s=>(
      <div class="stat">
        <span class="stat-i">{s.i}</span>
        <strong class="lf stat-n">{s.n}</strong>
        <span class="stat-l">{s.l}</span>
      </div>
    ))}
  </div>
</section>

<!-- CAREERS CTA -->
<section class="sec">
  <div class="wrap">
    <div class="cta-band">
      <div>
        <div class="tag tag-y" style="margin-bottom:1rem">We're Hiring</div>
        <h2 class="lf" style="font-size:clamp(2rem,4vw,3rem);color:var(--pd);line-height:1.1">Join the Babycakes family.</h2>
        <p style="color:var(--g3);margin-top:.75rem;font-size:1rem;max-width:400px;line-height:1.7">We're always looking for passionate people who believe in feel-good food.</p>
      </div>
      <a href="/careers" class="btn btn-p">See Open Roles →</a>
    </div>
  </div>
</section>

</Base>
<style>
.hero{position:relative;min-height:100svh;background:var(--pd);display:flex;align-items:flex-end;padding-bottom:clamp(4rem,8vw,7rem);overflow:hidden}
.hero-grid{display:grid;grid-template-columns:1fr auto;align-items:flex-end;gap:3rem;position:relative;z-index:2;padding-top:8rem;width:100%}
.hero-h1{font-size:clamp(4.5rem,13vw,10.5rem);color:var(--y);line-height:.88;letter-spacing:-.025em;margin-block:1.5rem}
.hero-body{font-size:clamp(1rem,1.8vw,1.15rem);color:rgba(251,245,171,.6);line-height:1.8;max-width:500px;margin-bottom:2.5rem}
.hero-body strong{color:var(--y);font-style:italic}
.hero-btns{display:flex;gap:1rem;flex-wrap:wrap}
.hero-circle{width:clamp(160px,20vw,240px);aspect-ratio:1;border-radius:50%;background:var(--y);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:.35rem;box-shadow:0 0 100px rgba(251,245,171,.2);animation:popIn .7s var(--esp) .4s both}
.hero-circle-name{font-size:clamp(1rem,2.2vw,1.6rem);color:var(--pd)}
.hero-circle-sub{font-size:.62rem;font-weight:700;letter-spacing:.06em;color:var(--pd)}
.hero-scroll{position:absolute;bottom:2rem;right:var(--px);font-size:.65rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase;color:rgba(251,245,171,.25);writing-mode:vertical-rl;z-index:2}
@media(max-width:640px){.hero-right{display:none}}
.sh{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:3rem;flex-wrap:wrap}
.sh-title{font-size:clamp(2.5rem,5vw,4rem);color:var(--pd);line-height:1}
.fhg{display:grid;grid-template-columns:1.35fr 1fr;gap:1.5rem}
.fsg{display:grid;grid-template-rows:repeat(2,1fr);grid-template-columns:repeat(2,1fr);gap:1.5rem}
.fcard{position:relative;border-radius:var(--rlg);overflow:hidden;background:var(--cb);display:flex;flex-direction:column;justify-content:flex-end;transition:transform .3s var(--eout),box-shadow .3s var(--eout)}
.fcard:hover{transform:translateY(-5px);box-shadow:0 20px 56px rgba(0,0,0,.22)}
.fbig{min-height:560px}
.fsm{min-height:240px}
.fov{position:absolute;inset:0;background:linear-gradient(to top,rgba(0,0,0,.72) 0%,transparent 55%)}
.fc{position:relative;z-index:2;padding:1.75rem}
.fcnbig{font-size:clamp(2rem,3.5vw,2.8rem);color:#fff;line-height:1.05;margin-bottom:.6rem}
.fcdesc{color:rgba(255,255,255,.75);font-size:.9rem;line-height:1.65;margin-bottom:.75rem}
.fcnsm{font-size:1.4rem;color:#fff;line-height:1.1;margin-bottom:.25rem}
.fcper{font-size:.7rem;font-weight:700;color:rgba(255,255,255,.5);letter-spacing:.04em}
@media(max-width:900px){.fhg{grid-template-columns:1fr}.fbig{min-height:380px}.fsg{grid-template-columns:repeat(2,1fr)}}
.story-sec{background:var(--y);padding-block:clamp(5rem,10vw,9rem)}
.story-g{display:grid;grid-template-columns:1fr 1fr;gap:clamp(3rem,6vw,7rem);align-items:center}
.story-h2{font-size:clamp(2.5rem,5vw,4rem);color:var(--pd);line-height:1.05}
.story-sub{display:block;font-family:'Nunito',sans-serif;font-size:.65em;font-weight:400;font-style:italic;color:var(--p);margin-top:.5rem}
.story-body{font-size:1.05rem;line-height:1.85;color:var(--pd)}
@media(max-width:768px){.story-g{grid-template-columns:1fr}}
.stats-sec{background:var(--pd);padding-block:clamp(4rem,7vw,6rem)}
.stats-g{display:grid;grid-template-columns:repeat(4,1fr)}
.stat{text-align:center;padding:2.5rem 1rem;border-right:1px solid rgba(251,245,171,.08)}
.stat:last-child{border-right:none}
.stat-i{display:block;font-size:1.3rem;color:var(--y);margin-bottom:.75rem;opacity:.7}
.stat-n{display:block;font-size:clamp(2rem,3vw,2.5rem);color:var(--y);line-height:1;margin-bottom:.5rem}
.stat-l{font-size:.75rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:rgba(251,245,171,.45)}
@media(max-width:640px){.stats-g{grid-template-columns:repeat(2,1fr)}.stat{border-right:none;border-bottom:1px solid rgba(251,245,171,.08)}}
.cta-band{display:flex;align-items:center;justify-content:space-between;gap:2rem;flex-wrap:wrap;background:var(--g1);border-radius:var(--rlg);padding:3.5rem}
</style>
