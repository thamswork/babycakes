---
interface Props { title?: string; description?: string; }
const { title = "Babycakes — Feel Good Food", description = "Born from baby + cakes. Classic recipes reimagined for today." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0,viewport-fit=cover"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <meta name="theme-color" content="#9F97C2"/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Neulis+Neue:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&display=swap" rel="stylesheet"/>
</head>
<body>

<!-- NAV -->
<header class="nav" id="nav">
  <div class="nav-in">
    <a href="/" class="nav-logo">babycakes</a>
    <nav class="nav-links">
      <div class="nav-group">
        <button class="nav-gbtn" aria-expanded="false" aria-haspopup="true">
          Flavors
          <svg class="nav-chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="nav-drop" role="menu">
          <a href="/bi-weekly" role="menuitem"><span class="nd-dot nd-y"></span>Bi-Weekly Flavors</a>
          <a href="/always-available" role="menuitem"><span class="nd-dot nd-cr"></span>Always Available</a>
        </div>
      </div>
      <a href="/locations">Locations</a>
      <a href="/collabs">Collabs</a>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
    </nav>
    <a href="/bi-weekly" class="nav-cta">This Week's Drop</a>
    <button class="nav-ham" id="ham" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<!-- MOBILE OVERLAY — full screen, thumb-friendly -->
<div class="mob" id="mob" aria-hidden="true">
  <div class="mob-top">
    <a href="/" class="mob-logo" tabindex="-1">babycakes</a>
    <button class="mob-x" id="mobX" aria-label="Close menu">&#x2715;</button>
  </div>
  <nav class="mob-nav">
    <div class="mob-acc">
      <button class="mob-abtn" aria-expanded="false">
        Flavors
        <svg width="12" height="7" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="mob-abody">
        <a href="/bi-weekly"><span class="nd-dot nd-y"></span>Bi-Weekly Flavors</a>
        <a href="/always-available"><span class="nd-dot nd-cr"></span>Always Available</a>
      </div>
    </div>
    <a href="/locations">Locations</a>
    <a href="/collabs">Collabs</a>
    <a href="/brand">Brand</a>
    <a href="/careers">Careers</a>
  </nav>
  <!-- Bottom CTAs in thumb zone -->
  <div class="mob-foot">
    <a href="/bi-weekly" class="btn btn-y w100">This Week's Drop</a>
    <a href="https://lin.ee/babycakes" target="_blank" rel="noopener" class="btn btn-line w100">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      Order via LINE
    </a>
  </div>
</div>

<main><slot/></main>

<!-- FOOTER -->
<footer class="ft">
  <div class="ft-top">
    <div class="ft-brand">
      <span class="ft-logo">babycakes</span>
      <p>Born from baby + cakes. Classic recipes reimagined for today.</p>
      <div class="ft-soc">
        <a href="https://instagram.com/babycakes.bkk" target="_blank" rel="noopener">Instagram</a>
        <a href="https://facebook.com/babycakes.bkk" target="_blank" rel="noopener">Facebook</a>
        <a href="https://lin.ee/babycakes" target="_blank" rel="noopener">LINE</a>
        <a href="https://tiktok.com/@babycakes.bkk" target="_blank" rel="noopener">TikTok</a>
      </div>
    </div>
    <div class="ft-col">
      <h5>Menu</h5>
      <a href="/bi-weekly">Bi-Weekly Flavors</a>
      <a href="/always-available">Always Available</a>
      <a href="/locations">Locations</a>
      <a href="/collabs">Collabs</a>
    </div>
    <div class="ft-col">
      <h5>Company</h5>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
      <a href="/admin">CMS</a>
    </div>
    <div class="ft-col">
      <h5>Order</h5>
      <a href="https://lin.ee/babycakes" target="_blank" rel="noopener">LINE (Main order)</a>
      <a href="https://food.grab.com/th/en/search?keyword=babycakes" target="_blank" rel="noopener">GrabFood</a>
      <a href="https://linemanwongnai.com" target="_blank" rel="noopener">LINE MAN</a>
    </div>
  </div>
  <div class="ft-bot">
    <span>&copy; {new Date().getFullYear()} Babycakes Co., Ltd.</span>
    <span>feel good food</span>
  </div>
</footer>

<script>
(function () {
  if (!('IntersectionObserver' in window)) return;

  /* Card reveal */
  const cardObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const idx = Array.from(e.target.parentElement?.children ?? []).indexOf(e.target);
      setTimeout(() => e.target.classList.add('in-view'), idx * 50);
      cardObs.unobserve(e.target);
    });
  }, { threshold: 0.06, rootMargin: '0px 0px -32px 0px' });
  document.querySelectorAll('.pc').forEach(el => cardObs.observe(el));

  /* Section fade */
  const secObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      (e.target as HTMLElement).style.animationPlayState = 'running';
      secObs.unobserve(e.target);
    });
  }, { threshold: 0.05 });
  document.querySelectorAll('.au').forEach(el => {
    (el as HTMLElement).style.animationPlayState = 'paused';
    secObs.observe(el);
  });

  /* Parallax — desktop only */
  const heroImg = document.querySelector('.hero-img') as HTMLElement;
  if (heroImg && window.innerWidth > 768) {
    window.addEventListener('scroll', () => {
      heroImg.style.transform = `translateY(${window.scrollY * 0.28}px)`;
    }, { passive: true });
  }

  /* 3D tilt — desktop only */
  if (window.innerWidth > 1024) {
    document.querySelectorAll('.pc').forEach(card => {
      card.addEventListener('mousemove', e => {
        const rect = card.getBoundingClientRect();
        const rotX = (((e as MouseEvent).clientY - rect.top) / rect.height - 0.5) * -5;
        const rotY = (((e as MouseEvent).clientX - rect.left) / rect.width - 0.5) * 5;
        (card as HTMLElement).style.transform = `perspective(600px) rotateX(${rotX}deg) rotateY(${rotY}deg) translateY(-3px)`;
        (card as HTMLElement).style.transition = 'transform .05s ease';
      });
      card.addEventListener('mouseleave', () => {
        (card as HTMLElement).style.transform = '';
        (card as HTMLElement).style.transition = 'transform .4s ease';
      });
    });
  }

  /* Number counter */
  const numObs = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (!e.isIntersecting) return;
      const el = e.target as HTMLElement;
      const target = parseFloat(el.dataset.target ?? el.textContent!.replace(/[^0-9.]/g, ''));
      const prefix = el.dataset.prefix ?? '', suffix = el.dataset.suffix ?? '';
      let t0: number | null = null;
      const step = (ts: number) => {
        if (!t0) t0 = ts;
        const p = Math.min((ts - t0) / 1000, 1);
        el.textContent = prefix + Math.floor((1 - Math.pow(1 - p, 3)) * target).toLocaleString() + suffix;
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
      numObs.unobserve(e.target);
    });
  }, { threshold: 0.5 });
  document.querySelectorAll('[data-count]').forEach(el => numObs.observe(el));
})();
</script>

</body>
</html>

<style is:global>
/* ══════════════════════════════════════════════════════════
   BABYCAKES v19 — Global Design System + Mobile-first
   Breakpoints: 480 (phone) · 768 (phablet) · 1080 (desktop)
══════════════════════════════════════════════════════════ */

/* ── TOKENS ── */
:root {
  --y:   #FBF5AB;
  --p:   #9F97C2;
  --d:   #4C4378;
  --dk:  #2e2350;
  --xdk: #1e1638;
  --w:   #ffffff;
  --cr:  #F4F3EE;
  --cr2: #EAE9E2;
  --g1:  #E0DFD9;
  --g2:  #C0BFB8;
  --g3:  #7E7C74;
  --tx:  #1A1820;

  --px:     clamp(1rem, 5vw, 5.5rem);
  --px-mob: 1.125rem;           /* tighter mobile padding */
  --mx:     1440px;
  --gap:    clamp(0.75rem, 2vw, 1.5rem);
  --r:      0.25rem;
  --rm:     0.625rem;
  --rl:     1rem;
  --ease:   cubic-bezier(0.22, 1, 0.36, 1);
  --nav-h:  60px;

  --font:      'Neulis Neue', sans-serif;
  --font-logo: 'Shrikhand', serif;
  --fw-body:   400;
  --fw-med:    500;
  --fw-semi:   600;
  --fw-bold:   700;
  --fw-xbold:  800;

  /* Mobile safe areas */
  --sat: env(safe-area-inset-top, 0px);
  --sab: env(safe-area-inset-bottom, 0px);
}

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; -webkit-text-size-adjust: 100%; }
body {
  font-family: var(--font);
  background: var(--w);
  color: var(--tx);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  line-height: 1.75;
  font-size: 16px;
  font-weight: var(--fw-body);
  /* Reserve space for home bar on iPhone */
  padding-bottom: var(--sab);
}
a { text-decoration: none; color: inherit; }
img { display: block; width: 100%; height: 100%; object-fit: cover; }
a, button { -webkit-tap-highlight-color: transparent; touch-action: manipulation; }

/* ── UTILITIES ── */
.w100  { width: 100%; }
.lf    { font-family: var(--font-logo); }
.wrap  { max-width: var(--mx); margin-inline: auto; padding-inline: var(--px); }
.sec   { padding-block: clamp(4rem, 10vw, 10rem); }
.sec-sm{ padding-block: clamp(3rem, 6vw, 6rem); }
.sec-cr{ background: var(--cr); }
.dots  { position: absolute; inset: 0; pointer-events: none; background-image: radial-gradient(circle, rgba(255,255,255,.05) 1px, transparent 1px); background-size: 28px 28px; }

/* ── GRIDS ── */
.g2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap); }
.g3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
.g4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gap); }
@media (max-width: 1024px) { .g4 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 860px)  { .g3 { grid-template-columns: repeat(2, 1fr); } }
@media (max-width: 540px)  { .g4, .g3, .g2 { grid-template-columns: 1fr; } }

/* ── SECTION HEADER ── */
.sh     { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.25rem; margin-bottom: clamp(2rem, 5vw, 4.5rem); flex-wrap: wrap; }
.sh-eye { display: block; margin-bottom: .75rem; }
.sh-h   {
  font-family: var(--font); font-weight: var(--fw-xbold);
  font-size: clamp(1.875rem, 5vw, 3.75rem);
  color: var(--p); line-height: 1; letter-spacing: -.02em;
}

/* ── TAGS ── */
.tag {
  display: inline-flex; align-items: center;
  padding: .3rem .9rem; border-radius: var(--r);
  font-family: var(--font); font-size: .6rem; font-weight: var(--fw-bold);
  letter-spacing: .1em; text-transform: uppercase; line-height: 2;
  white-space: nowrap; max-width: 100%;
}
.tag-p  { background: var(--p);  color: #fff; }
.tag-y  { background: var(--y);  color: var(--d); }
.tag-d  { background: var(--d);  color: var(--y); }
.tag-cr { background: var(--cr2); color: var(--g3); border: 1px solid var(--g1); }
.tag-ow { border: 1px solid rgba(255,255,255,.28); color: rgba(255,255,255,.85); background: rgba(255,255,255,.1); }
.tag-o  { border: 1.5px solid var(--p); color: var(--p); }
.tag-tx { background: transparent; border: 1px solid var(--d); color: var(--d); }

/* ── BUTTONS ── */
.btn {
  display: inline-flex; align-items: center; justify-content: center; gap: .45rem;
  padding: .9rem 2rem; border-radius: 999px;
  font-family: var(--font); font-size: .875rem; font-weight: var(--fw-bold);
  letter-spacing: .01em; border: none; cursor: pointer;
  transition: transform .18s var(--ease), box-shadow .18s var(--ease), opacity .15s;
  line-height: 1; white-space: nowrap;
  min-height: 48px; /* accessibility touch target */
  user-select: none;
}
/* Remove hover effects on touch devices */
@media (hover: hover) {
  .btn:hover  { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(0,0,0,.1); }
}
.btn:active { transform: scale(.97); box-shadow: none; opacity: .88; }
.btn-y    { background: var(--y);  color: var(--d); }
.btn-p    { background: var(--p);  color: #fff; }
.btn-d    { background: var(--d);  color: var(--y); }
.btn-ow   { background: transparent; border: 1.5px solid rgba(255,255,255,.35); color: rgba(255,255,255,.9); }
.btn-op   { background: transparent; border: 1.5px solid var(--p); color: var(--p); }
.btn-od   { background: transparent; border: 1.5px solid var(--d); color: var(--d); }
.btn-tx   { background: transparent; border: 1.5px solid var(--tx); color: var(--tx); }
.btn-line { background: #06C755; color: #fff; }
.btn-sm   { padding: .6rem 1.4rem; font-size: .8rem; min-height: 42px; }
.btn-lg   { padding: 1.05rem 2.4rem; font-size: .95rem; }

/* ── MARQUEE ── */
.mq { overflow: hidden; background: var(--y); border-top: 1.5px solid var(--d); border-bottom: 1.5px solid var(--d); padding-block: .625rem; }
.mq-t { display: flex; width: max-content; animation: mqs 32s linear infinite; }
.mq:hover .mq-t { animation-play-state: paused; }
@keyframes mqs { to { transform: translateX(-50%); } }
.mq-i { display: inline-flex; align-items: center; gap: .875rem; padding-inline: 2rem; font-family: var(--font); font-size: .65rem; font-weight: var(--fw-bold); letter-spacing: .1em; text-transform: uppercase; color: var(--d); white-space: nowrap; }
.mq-dot-el { width: 3px; height: 3px; border-radius: 50%; background: var(--p); display: inline-block; flex-shrink: 0; }

/* ── PHOTO CARD ── */
.pc {
  display: block; border-radius: var(--rm); overflow: hidden;
  background: var(--cr); text-decoration: none; color: inherit;
  transition: transform .28s var(--ease), box-shadow .28s var(--ease);
  opacity: 0; transform: translateY(16px);
  /* GPU layer for smooth animation */
  will-change: transform, opacity;
}
.pc.in-view { opacity: 1; transform: translateY(0); transition: opacity .45s var(--ease), transform .45s var(--ease); }
@media (hover: hover) {
  .pc:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(159,151,194,.2); }
  .pc:hover .pc-img img { transform: scale(1.04); }
}
.pc:active { transform: scale(.98); }
.pc-img { position: relative; overflow: hidden; background: var(--d); }
.pc-img img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .5s var(--ease); }
.pc-ph { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-family: var(--font); font-size: .6rem; font-weight: var(--fw-bold); letter-spacing: .1em; text-transform: uppercase; color: rgba(255,255,255,.2); text-align: center; padding: 1.5rem; }
.pc-body { padding: clamp(.875rem, 2.5vw, 1.4rem); }
.pc-meta { display: flex; align-items: center; justify-content: space-between; margin-bottom: .5rem; gap: .4rem; flex-wrap: wrap; }
.pc-name { font-family: var(--font); font-weight: var(--fw-xbold); font-size: clamp(1rem, 2.5vw, 1.3rem); color: var(--p); line-height: 1.1; margin-bottom: .3rem; letter-spacing: -.01em; }
.pc-desc { font-size: .85rem; color: var(--g3); line-height: 1.7; }
.pc-per  { font-size: .65rem; font-weight: var(--fw-semi); color: var(--p); letter-spacing: .04em; }

/* ── ANIMATIONS ── */
@keyframes fadeUp { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: translateY(0); } }
.au  { animation: fadeUp .6s var(--ease) both; }
.au1 { animation-delay: .08s; }
.au2 { animation-delay: .16s; }
.au3 { animation-delay: .24s; }
.au4 { animation-delay: .32s; }
.nd-dot { display: inline-block; width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
.nd-y { background: var(--y); }
.nd-cr { background: var(--g2); }

/* ══════════════════════════════════════════════
   NAV — desktop
══════════════════════════════════════════════ */
.nav { position: fixed; inset: 0 0 auto; z-index: 900; height: var(--nav-h); transition: background .25s, box-shadow .25s; }
.nav.on { background: var(--p); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); box-shadow: 0 1px 0 rgba(76,67,120,.2), 0 4px 24px rgba(76,67,120,.18); }
.nav-in { display: flex; align-items: center; height: 100%; padding-inline: var(--px); max-width: var(--mx); margin-inline: auto; gap: 1rem; }
.nav-logo { font-family: var(--font-logo); font-size: 1.4rem; color: var(--y); flex-shrink: 0; margin-right: auto; opacity: 0; transition: opacity .25s; pointer-events: none; }
.nav.on .nav-logo { opacity: 1; pointer-events: auto; }
.nav-links { display: flex; align-items: center; gap: 1.75rem; margin-right: 1.5rem; }
.nav-links > a, .nav-gbtn { font-family: var(--font); font-size: .68rem; font-weight: var(--fw-semi); letter-spacing: .07em; text-transform: uppercase; color: rgba(255,255,255,.85); transition: color .15s; background: none; border: none; cursor: pointer; padding: 0; display: flex; align-items: center; gap: .35rem; min-height: 48px; }
.nav-links > a:hover, .nav-gbtn:hover { color: #fff; }
.nav-chev { transition: transform .2s; flex-shrink: 0; opacity: .6; }
.nav-group { position: relative; }
.nav-group:hover .nav-chev { transform: rotate(180deg); }
.nav-drop { position: absolute; top: calc(100% + 1rem); left: -.875rem; background: var(--dk); border: 1px solid rgba(159,151,194,.15); border-radius: var(--rl); padding: .625rem; min-width: 210px; opacity: 0; visibility: hidden; transform: translateY(-6px); transition: opacity .18s var(--ease), transform .18s var(--ease), visibility .18s; box-shadow: 0 12px 40px rgba(0,0,0,.28); }
.nav-group:hover .nav-drop { opacity: 1; visibility: visible; transform: translateY(0); }
.nav-drop a { font-family: var(--font); display: flex; align-items: center; gap: .75rem; padding: .75rem .9rem; border-radius: var(--rm); font-size: .82rem; font-weight: var(--fw-med); color: rgba(255,255,255,.55); transition: background .15s, color .15s; }
.nav-drop a:hover { background: rgba(159,151,194,.12); color: #fff; }
.nav-cta { font-family: var(--font); flex-shrink: 0; background: var(--y); color: var(--d); font-size: .68rem; font-weight: var(--fw-bold); letter-spacing: .04em; text-transform: uppercase; padding: .52rem 1.3rem; border-radius: 999px; transition: opacity .15s; }
.nav-cta:hover { opacity: .88; }
.nav-ham { display: none; flex-direction: column; justify-content: center; gap: 5px; background: none; border: none; cursor: pointer; padding: 10px; margin-left: auto; width: 48px; height: 48px; }
.nav-ham span { display: block; width: 22px; height: 1.5px; background: var(--y); border-radius: 1px; transition: all .2s var(--ease); transform-origin: center; }
.nav-ham.open span:nth-child(1) { transform: translateY(6.5px) rotate(45deg); }
.nav-ham.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
.nav-ham.open span:nth-child(3) { transform: translateY(-6.5px) rotate(-45deg); }

/* ── NAV MOBILE ── */
@media (max-width: 1080px) {
  .nav { background: var(--p); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px); }
  .nav-logo { opacity: 1 !important; pointer-events: auto !important; }
  .nav-links, .nav-cta { display: none; }
  .nav-ham { display: flex; }
}

/* ══════════════════════════════════════════════
   MOBILE OVERLAY — full-screen, cinematic
══════════════════════════════════════════════ */
.mob {
  display: none;
  position: fixed; inset: 0;
  z-index: 950;
  background: var(--dk);
  flex-direction: column;
  overflow-y: auto;
  overflow-x: hidden;
  /* Slide in from right */
  transform: translateX(100%);
  transition: transform .32s var(--ease);
}
.mob.open {
  display: flex;
  transform: translateX(0);
  animation: slideInRight .32s var(--ease) both;
}
@keyframes slideInRight {
  from { transform: translateX(100%); opacity: .8; }
  to   { transform: translateX(0); opacity: 1; }
}
.mob-top {
  display: flex; align-items: center; justify-content: space-between;
  padding: max(calc(var(--nav-h) * .35), .875rem) var(--px-mob);
  padding-top: max(calc(var(--nav-h) * .5 + var(--sat)), 1.25rem);
  border-bottom: 1px solid rgba(159,151,194,.12);
  flex-shrink: 0;
}
.mob-logo { font-family: var(--font-logo); font-size: 1.5rem; color: var(--y); }
.mob-x {
  background: rgba(255,255,255,.08); border: none; border-radius: 50%;
  color: rgba(255,255,255,.7); font-size: 1rem; cursor: pointer;
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
  transition: background .15s;
}
.mob-x:hover { background: rgba(255,255,255,.16); }

/* Large, generous nav links — easy to tap */
.mob-nav { display: flex; flex-direction: column; padding: .75rem var(--px-mob); flex: 1; }
.mob-nav > a {
  font-family: var(--font); display: flex; align-items: center;
  padding: 1rem 0;
  font-size: 1.25rem; font-weight: var(--fw-semi);
  color: rgba(255,255,255,.55);
  border-bottom: 1px solid rgba(159,151,194,.08);
  transition: color .15s, padding-left .15s;
  min-height: 56px;
}
.mob-nav > a:last-child { border-bottom: none; }
.mob-nav > a:active { color: #fff; padding-left: .5rem; }

.mob-acc { border-bottom: 1px solid rgba(159,151,194,.08); }
.mob-abtn {
  font-family: var(--font); width: 100%;
  display: flex; align-items: center; justify-content: space-between;
  padding: 1rem 0; background: none; border: none; cursor: pointer;
  font-size: 1.25rem; font-weight: var(--fw-semi);
  color: rgba(255,255,255,.55); transition: color .15s;
  min-height: 56px;
}
.mob-abtn.open { color: rgba(255,255,255,.9); }
.mob-abtn svg { transition: transform .2s; opacity: .5; flex-shrink: 0; }
.mob-abtn.open svg { transform: rotate(180deg); opacity: 1; }

.mob-abody { display: none; flex-direction: column; padding-bottom: .5rem; }
.mob-abody.open { display: flex; }
.mob-abody a {
  font-family: var(--font); display: flex; align-items: center; gap: .875rem;
  padding: .875rem 1.25rem; font-size: 1rem;
  color: rgba(255,255,255,.45); border-radius: var(--rm);
  transition: background .15s, color .15s; min-height: 50px;
}
.mob-abody a:active { background: rgba(159,151,194,.12); color: #fff; }

/* CTAs anchored in thumb zone */
.mob-foot {
  display: flex; flex-direction: column; gap: .75rem;
  padding: 1.25rem var(--px-mob);
  padding-bottom: max(1.5rem, calc(var(--sab) + 1rem));
  border-top: 1px solid rgba(159,151,194,.1);
  flex-shrink: 0;
}
.mob-foot .btn { font-size: 1rem; padding: 1rem; border-radius: var(--rm); }

/* ══════════════════════════════════════════════
   FOOTER — mobile
══════════════════════════════════════════════ */
.ft { background: var(--p); border-top: 1px solid rgba(255,255,255,.08); }
.ft-top { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2.5rem; max-width: var(--mx); margin-inline: auto; padding: clamp(3rem,6vw,5rem) var(--px) clamp(2rem,4vw,3.5rem); }
.ft-logo { display: block; font-family: var(--font-logo); font-size: 1.625rem; color: var(--y); margin-bottom: .625rem; }
.ft-brand p { font-family: var(--font); color: rgba(255,255,255,.6); font-size: .8rem; line-height: 1.75; max-width: 220px; margin-bottom: 1.1rem; }
.ft-soc { display: flex; flex-wrap: wrap; gap: .5rem 1rem; }
.ft-soc a { font-family: var(--font); color: rgba(255,255,255,.6); font-size: .78rem; font-weight: var(--fw-med); transition: color .15s; min-height: 36px; display: flex; align-items: center; }
.ft-soc a:hover { color: #fff; }
.ft-col h5 { font-family: var(--font); font-size: .55rem; letter-spacing: .14em; text-transform: uppercase; color: rgba(255,255,255,.45); margin-bottom: .875rem; font-weight: var(--fw-bold); }
.ft-col a { font-family: var(--font); display: block; color: rgba(255,255,255,.7); font-size: .8rem; margin-bottom: .5rem; transition: color .15s; padding-block: .15rem; }
.ft-col a:hover { color: #fff; }
.ft-bot { display: flex; justify-content: space-between; align-items: center; max-width: var(--mx); margin-inline: auto; padding: .875rem var(--px); border-top: 1px solid rgba(255,255,255,.1); font-size: .65rem; color: rgba(255,255,255,.3); font-family: var(--font); padding-bottom: max(1rem, var(--sab)); }

@media (max-width: 860px) { .ft-top { grid-template-columns: 1fr 1fr; gap: 2rem; } }
@media (max-width: 520px) {
  /* Mobile footer — logo + social only, then 2-col links */
  .ft-top { grid-template-columns: 1fr 1fr; gap: 1.25rem 2rem; padding: 2rem var(--px-mob) 1.5rem; }
  .ft-brand { grid-column: 1 / -1; display: flex; flex-direction: column; gap: .875rem; }
  .ft-brand p { display: none; } /* hide tagline on mobile to save space */
  .ft-soc { gap: .25rem .875rem; }
  .ft-col h5 { margin-bottom: .625rem; font-size: .52rem; }
  .ft-col a { font-size: .76rem; margin-bottom: .35rem; }
  .ft-bot { flex-direction: column; gap: .2rem; text-align: center; padding: .75rem var(--px-mob); font-size: .6rem; }
}
@media (max-width: 360px) { .ft-top { grid-template-columns: 1fr; } }

/* ══════════════════════════════════════════════
   GLOBAL MOBILE OVERRIDES
══════════════════════════════════════════════ */
@media (max-width: 768px) {
  .wrap { padding-inline: var(--px-mob); }
  .sec  { padding-block: clamp(3rem, 8vw, 5.5rem); }
  .sec-sm { padding-block: clamp(2rem, 5vw, 3.5rem); }
  .sh   { margin-bottom: 1.75rem; gap: 1rem; }
  .sh-h { font-size: clamp(1.75rem, 7vw, 2.75rem); }
  .sh .btn { min-height: 44px; font-size: .82rem; }
  .mq-i { font-size: .6rem; padding-inline: 1.5rem; }
}

/* Sticky sidebars must never overlay on mobile */
@media (max-width: 960px) {
  aside, .role-side, .collab-side, .cside-card { position: static !important; top: auto !important; }
}
</style>

<script>
/* ── NAV ── */
const nav = document.getElementById('nav')!;
window.addEventListener('scroll', () => nav.classList.toggle('on', window.scrollY > 32), { passive: true });

/* ── MOBILE MENU ── */
const ham  = document.getElementById('ham')!;
const mob  = document.getElementById('mob')!;
const mobX = document.getElementById('mobX')!;

function openMob() {
  mob.style.display = 'flex';
  requestAnimationFrame(() => mob.classList.add('open'));
  ham.classList.add('open');
  ham.setAttribute('aria-expanded', 'true');
  mob.setAttribute('aria-hidden', 'false');
  document.body.style.overflow = 'hidden';
}
function closeMob() {
  mob.classList.remove('open');
  ham.classList.remove('open');
  ham.setAttribute('aria-expanded', 'false');
  mob.setAttribute('aria-hidden', 'true');
  document.body.style.overflow = '';
  setTimeout(() => { if (!mob.classList.contains('open')) mob.style.display = ''; }, 340);
}

ham.addEventListener('click', () => mob.classList.contains('open') ? closeMob() : openMob());
mobX.addEventListener('click', closeMob);
document.querySelectorAll('.mob-nav > a, .mob-foot a').forEach(a => a.addEventListener('click', closeMob));

/* Close on backdrop tap (outside menu content) */
mob.addEventListener('click', e => { if (e.target === mob) closeMob(); });

/* ── MOBILE ACCORDION ── */
document.querySelectorAll('.mob-abtn').forEach(btn => {
  btn.addEventListener('click', () => {
    const body = btn.nextElementSibling!;
    const open = btn.classList.contains('open');
    btn.classList.toggle('open', !open);
    body.classList.toggle('open', !open);
    btn.setAttribute('aria-expanded', String(!open));
  });
});

/* ── DESKTOP DROPDOWN ── */
document.querySelectorAll('.nav-group').forEach(g => {
  g.addEventListener('mouseenter', () => g.classList.add('open'));
  g.addEventListener('mouseleave', () => g.classList.remove('open'));
});

/* ── SECTION ANIMATIONS ── */
if ('IntersectionObserver' in window) {
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).style.animationPlayState = 'running';
        io.unobserve(e.target);
      }
    });
  }, { threshold: 0.06 });
  document.querySelectorAll('.au').forEach(el => {
    (el as HTMLElement).style.animationPlayState = 'paused';
    io.observe(el);
  });
}
</script>
