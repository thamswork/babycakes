---
interface Props { title?: string; description?: string; }
const {
  title = "Babycakes — Feel Good Food",
  description = "Born from baby + cakes. Classic recipes reimagined for today."
} = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Nunito:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400&display=swap" rel="stylesheet"/>
</head>
<body>

<header class="nav" id="nav">
  <div class="nav-in">
    <a href="/" class="nav-logo">babycakes</a>
    <nav class="nav-links">
      <div class="nav-group" id="ngf">
        <button class="nav-gbtn" aria-expanded="false" aria-haspopup="true">
          Flavors <svg class="nav-chev" width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        </button>
        <div class="nav-drop" role="menu">
          <a href="/bi-weekly" role="menuitem"><span class="nd-dot nd-y"></span>Bi-Weekly Flavors</a>
          <a href="/always-available" role="menuitem"><span class="nd-dot nd-cr"></span>Always Available</a>
        </div>
      </div>
      <a href="/locations">Locations</a>
      <a href="/collabs">Collabs</a>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
    </nav>
    <a href="/bi-weekly" class="nav-cta">This Week's Drop</a>
    <button class="nav-ham" id="ham" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mob" id="mob">
  <div class="mob-top">
    <a href="/" class="mob-logo">babycakes</a>
    <button class="mob-x" id="mobX" aria-label="Close">&#x2715;</button>
  </div>
  <nav class="mob-nav">
    <div class="mob-acc">
      <button class="mob-abtn" aria-expanded="false">
        Flavors
        <svg width="10" height="6" viewBox="0 0 10 6" fill="none"><path d="M1 1l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
      <div class="mob-abody">
        <a href="/bi-weekly"><span class="nd-dot nd-y"></span>Bi-Weekly Flavors</a>
        <a href="/always-available"><span class="nd-dot nd-cr"></span>Always Available</a>
      </div>
    </div>
    <a href="/locations">Locations</a>
    <a href="/collabs">Collabs</a>
    <a href="/brand">Brand</a>
    <a href="/careers">Careers</a>
  </nav>
  <div class="mob-foot">
    <a href="/bi-weekly" class="btn btn-y w100">This Week's Drop</a>
    <a href="https://lin.ee/babycakes" target="_blank" rel="noopener" class="btn btn-line w100">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19.365 9.863c.349 0 .63.285.63.631 0 .345-.281.63-.63.63H17.61v1.125h1.755c.349 0 .63.283.63.63 0 .344-.281.629-.63.629h-2.386c-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63h2.386c.346 0 .627.285.627.63 0 .349-.281.63-.63.63H17.61v1.125h1.755zm-3.855 3.016c0 .27-.174.51-.432.596-.064.021-.133.031-.199.031-.211 0-.391-.09-.51-.25l-2.443-3.317v2.94c0 .344-.279.629-.631.629-.346 0-.626-.285-.626-.629V8.108c0-.27.173-.51.43-.595.06-.023.136-.033.194-.033.195 0 .375.104.495.254l2.462 3.33V8.108c0-.345.282-.63.63-.63.345 0 .63.285.63.63v4.771zm-5.741 0c0 .344-.282.629-.631.629-.345 0-.627-.285-.627-.629V8.108c0-.345.282-.63.63-.63.346 0 .628.285.628.63v4.771zm-2.466.629H4.917c-.345 0-.63-.285-.63-.629V8.108c0-.345.285-.63.63-.63.348 0 .63.285.63.63v4.141h1.756c.348 0 .629.283.629.63 0 .344-.282.629-.629.629M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
      Order via LINE
    </a>
  </div>
</div>

<!-- Sticky LINE button — only on mobile, shows after hero -->
<a href="https://lin.ee/babycakes" target="_blank" rel="noopener" class="sticky-line" id="stickyLine">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M24 10.314C24 4.943 18.615.572 12 .572S0 4.943 0 10.314c0 4.811 4.27 8.842 10.035 9.608.391.082.923.258 1.058.59.12.301.079.766.038 1.08l-.164 1.02c-.045.301-.24 1.186 1.049.645 1.291-.539 6.916-4.078 9.436-6.975C23.176 14.393 24 12.458 24 10.314"/></svg>
  Order via LINE
</a>

<main><slot/></main>

<footer class="ft">
  <div class="ft-top">
    <div class="ft-brand">
      <span class="ft-logo">babycakes</span>
      <p>Born from baby + cakes. Classic recipes reimagined for today.</p>
      <div class="ft-soc">
        <a href="https://instagram.com/babycakes.bkk" target="_blank" rel="noopener">Instagram</a>
        <a href="https://facebook.com/babycakes.bkk" target="_blank" rel="noopener">Facebook</a>
        <a href="https://lin.ee/babycakes" target="_blank" rel="noopener">LINE</a>
        <a href="https://tiktok.com/@babycakes.bkk" target="_blank" rel="noopener">TikTok</a>
      </div>
    </div>
    <div class="ft-col">
      <h5>Menu</h5>
      <a href="/bi-weekly">Bi-Weekly Flavors</a>
      <a href="/always-available">Always Available</a>
      <a href="/locations">Locations</a>
      <a href="/collabs">Collabs</a>
    </div>
    <div class="ft-col">
      <h5>Company</h5>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
      <a href="/admin">CMS</a>
    </div>
    <div class="ft-col">
      <h5>Order</h5>
      <a href="https://lin.ee/babycakes" target="_blank" rel="noopener">LINE (Main order)</a>
      <a href="https://food.grab.com/th/en/search?keyword=babycakes" target="_blank" rel="noopener">GrabFood</a>
      <a href="https://linemanwongnai.com" target="_blank" rel="noopener">LINE MAN</a>
    </div>
  </div>
  <div class="ft-bot">
    <span>&copy; {new Date().getFullYear()} Babycakes Co., Ltd.</span>
    <span>feel good food</span>
  </div>
</footer>

</body>
</html>

<style is:global>
/* ══════════════════════════════════════════════════════
   BABYCAKES v10
   Tone: Breathing room. Lune-level restraint.
   Font: Nunito (body — Thai-friendly, warm, rounded)
         Shrikhand (logo + display only)
   Color: 70% white/cream · 20% dark purple · 10% yellow
══════════════════════════════════════════════════════ */
:root {
  --y:   #FBF5AB;
  --pm:  #9F97C2;
  --d:   #4C4378;
  --dk:  #2e2350;
  --xdk: #1e1638;
  --w:   #ffffff;
  --cr:  #F4F3EE;
  --g1:  #E4E3DD;
  --g2:  #C6C5BE;
  --g3:  #86847C;
  --tx:  #1A1820;
  --px:  clamp(1.25rem, 5.5vw, 5.5rem);
  --mx:  1440px;
  --gap: clamp(0.875rem, 2vw, 1.5rem);
  --r:   0.25rem;
  --rm:  0.5rem;
  --rl:  0.875rem;
  --ease: cubic-bezier(0.22,1,0.36,1);
  --sp:   cubic-bezier(0.34,1.56,0.64,1);
  --nav-h: 62px;
}

*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Nunito',sans-serif;
  background:var(--w); color:var(--tx);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
  /* BREATHING ROOM: generous base line-height */
  line-height:1.8;
  font-size:16px;
  font-weight:400;
}
a{text-decoration:none;color:inherit}
img{display:block;width:100%;height:100%;object-fit:cover}
.lf{font-family:'Shrikhand',serif}
.w100{width:100%}
.wrap{max-width:var(--mx);margin-inline:auto;padding-inline:var(--px)}

/* GENEROUS SECTION SPACING — the core of breathing room */
.sec    { padding-block: clamp(5.5rem,11vw,10rem); }
.sec-sm { padding-block: clamp(4rem,7vw,6rem); }
.sec-cr { background:var(--cr); }

/* ── TAGS ── */
.tag{display:inline-flex;align-items:center;padding:.28rem .8rem;border-radius:var(--r);font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;line-height:2;white-space:nowrap;font-family:'Nunito',sans-serif}
.tag-y  {background:var(--y);color:var(--d)}
.tag-d  {background:var(--d);color:var(--y)}
.tag-cr {background:var(--cr);color:var(--g3);border:1px solid var(--g1)}
.tag-ow {border:1px solid rgba(255,255,255,.28);color:rgba(255,255,255,.82);background:rgba(255,255,255,.1)}
.tag-ln {border:1px solid var(--g1);color:var(--g3)}

/* ── BUTTONS ── pill, never blocky ── */
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:.45rem;
  padding:.875rem 2rem; border-radius:999px;
  font-family:'Nunito',sans-serif;font-size:.875rem;font-weight:700;
  letter-spacing:.01em; border:none; cursor:pointer;
  transition:transform .18s var(--ease),box-shadow .18s var(--ease),opacity .15s;
  line-height:1; white-space:nowrap; text-decoration:none;
  -webkit-tap-highlight-color:transparent;
}
.btn:hover  {transform:translateY(-1px);box-shadow:0 6px 18px rgba(0,0,0,.1)}
.btn:active {transform:translateY(1px);box-shadow:none}
.btn-y    {background:var(--y);color:var(--d)}
.btn-d    {background:var(--d);color:var(--y)}
.btn-ow   {background:transparent;border:1.5px solid rgba(255,255,255,.32);color:rgba(255,255,255,.85)}
.btn-od   {background:transparent;border:1.5px solid var(--d);color:var(--d)}
.btn-tx   {background:transparent;border:1.5px solid var(--g1);color:var(--tx)}
.btn-sm   {padding:.58rem 1.4rem;font-size:.8rem}
.btn-lg   {padding:1.05rem 2.4rem;font-size:.925rem}
/* LINE brand button */
.btn-line {background:#06C755;color:#fff}
.btn-line:hover {opacity:.9;transform:translateY(-1px)}

/* ── MARQUEE ── */
.mq{overflow:hidden;background:var(--y);border-top:1.5px solid var(--d);border-bottom:1.5px solid var(--d);padding-block:.68rem}
.mq-t{display:flex;width:max-content;animation:mqs 36s linear infinite}
.mq:hover .mq-t{animation-play-state:paused}
@keyframes mqs{to{transform:translateX(-50%)}}
.mq-i{display:inline-flex;align-items:center;gap:1rem;padding-inline:2.5rem;font-size:.68rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--d);white-space:nowrap}
.mq-dot-el{width:3px;height:3px;border-radius:50%;background:var(--pm);display:inline-block;flex-shrink:0}

/* ── SECTION HEADER ── */
.sh{display:flex;align-items:flex-end;justify-content:space-between;gap:1.5rem;margin-bottom:clamp(2.75rem,5.5vw,4.5rem);flex-wrap:wrap}
.sh-eye{display:block;margin-bottom:1rem}
.sh-h{font-family:'Shrikhand',serif;font-size:clamp(2rem,5vw,3.75rem);color:var(--d);line-height:1.02}

/* ── PHOTO CARD — photo top, text below ── */
.pc{display:block;border-radius:var(--rm);overflow:hidden;background:var(--cr);text-decoration:none;color:inherit;transition:transform .28s var(--ease),box-shadow .28s var(--ease)}
.pc:hover{transform:translateY(-3px);box-shadow:0 12px 36px rgba(76,67,120,.1)}
.pc-img{position:relative;overflow:hidden;background:var(--d)}
.pc-img img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .6s var(--ease)}
.pc:hover .pc-img img{transform:scale(1.04)}
.pc-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:.6rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:rgba(255,255,255,.18);text-align:center;padding:1.5rem}
.pc-body{padding:clamp(1rem,2.5vw,1.4rem) clamp(1rem,2.5vw,1.4rem) clamp(1.25rem,2.5vw,1.65rem)}
.pc-meta{display:flex;align-items:center;justify-content:space-between;margin-bottom:.6rem;gap:.5rem;flex-wrap:wrap}
.pc-name{font-family:'Shrikhand',serif;font-size:clamp(1.1rem,2.5vw,1.35rem);color:var(--d);line-height:1.05;margin-bottom:.35rem}
.pc-desc{font-size:.875rem;color:var(--g3);line-height:1.75}
.pc-per{font-size:.68rem;font-weight:600;color:var(--pm);letter-spacing:.04em}

/* ── GRIDS ── */
.g2{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--gap)}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--gap)}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:var(--gap)}
@media(max-width:1024px){.g4{grid-template-columns:repeat(2,1fr)}}
@media(max-width:860px) {.g3{grid-template-columns:repeat(2,1fr)}}
@media(max-width:540px) {.g4,.g3,.g2{grid-template-columns:1fr}}

/* ── ANIMATIONS ── */
@keyframes fadeUp{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes popIn{0%{opacity:0;transform:scale(.72) rotate(-6deg)}70%{transform:scale(1.04) rotate(-6deg)}100%{opacity:1;transform:scale(1) rotate(-6deg)}}
.au  {animation:fadeUp .7s var(--ease) both}
.au1 {animation-delay:.07s}.au2{animation-delay:.15s}.au3{animation-delay:.23s}.au4{animation-delay:.31s}
.dots{position:absolute;inset:0;pointer-events:none;background-image:radial-gradient(circle,rgba(255,255,255,.04) 1px,transparent 1px);background-size:32px 32px}

/* nav dot tags */
.nd-dot{display:inline-block;width:6px;height:6px;border-radius:50%;flex-shrink:0}
.nd-y{background:var(--y)}
.nd-cr{background:var(--g2)}

/* ══════════════════════════════
   NAV
══════════════════════════════ */
.nav{position:fixed;inset:0 0 auto;z-index:900;height:var(--nav-h);transition:background .3s,box-shadow .3s}
.nav.on{background:rgba(30,22,56,.97);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 1px 0 rgba(251,245,171,.07),0 4px 32px rgba(0,0,0,.2)}
.nav-in{display:flex;align-items:center;height:100%;padding-inline:var(--px);max-width:var(--mx);margin-inline:auto}
.nav-logo{font-family:'Shrikhand',serif;font-size:1.4rem;color:var(--y);letter-spacing:-.01em;flex-shrink:0;margin-right:auto}
.nav-links{display:flex;align-items:center;gap:1.875rem;margin-right:2rem}
.nav-links>a,.nav-gbtn{font-size:.68rem;font-weight:600;letter-spacing:.07em;text-transform:uppercase;color:rgba(251,245,171,.5);transition:color .15s;background:none;border:none;cursor:pointer;padding:0;font-family:'Nunito',sans-serif;display:flex;align-items:center;gap:.35rem}
.nav-links>a:hover,.nav-gbtn:hover{color:var(--y)}
.nav-chev{transition:transform .2s;flex-shrink:0;opacity:.6}
.nav-group{position:relative}
.nav-group:hover .nav-chev{transform:rotate(180deg)}
.nav-drop{position:absolute;top:calc(100% + 1.25rem);left:-.875rem;background:var(--xdk);border:1px solid rgba(251,245,171,.08);border-radius:var(--rl);padding:.625rem;min-width:210px;opacity:0;visibility:hidden;transform:translateY(-6px);transition:opacity .2s var(--ease),transform .2s var(--ease),visibility .2s;box-shadow:0 12px 40px rgba(0,0,0,.28)}
.nav-group:hover .nav-drop{opacity:1;visibility:visible;transform:translateY(0)}
.nav-drop a{display:flex;align-items:center;gap:.75rem;padding:.7rem .9rem;border-radius:var(--rm);font-size:.82rem;font-weight:500;color:rgba(251,245,171,.6);transition:background .15s,color .15s;text-transform:none;letter-spacing:0}
.nav-drop a:hover{background:rgba(255,255,255,.06);color:var(--y)}
.nav-cta{flex-shrink:0;background:var(--y);color:var(--d);font-size:.68rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;padding:.52rem 1.3rem;border-radius:999px;transition:opacity .15s,transform .15s;-webkit-tap-highlight-color:transparent}
.nav-cta:hover{opacity:.88;transform:scale(1.02)}
.nav-ham{display:none;flex-direction:column;justify-content:center;gap:5px;background:none;border:none;cursor:pointer;padding:8px;margin-left:1rem;min-width:44px;min-height:44px;-webkit-tap-highlight-color:transparent}
.nav-ham span{display:block;width:20px;height:1.5px;background:var(--y);border-radius:1px;transition:all .22s}
.nav-ham.open span:nth-child(1){transform:translateY(6.5px) rotate(45deg)}
.nav-ham.open span:nth-child(2){opacity:0}
.nav-ham.open span:nth-child(3){transform:translateY(-6.5px) rotate(-45deg)}
@media(max-width:1080px){.nav-links,.nav-cta{display:none}.nav-ham{display:flex}}

/* Mobile overlay */
.mob{display:none;position:fixed;inset:0;z-index:950;background:var(--xdk);flex-direction:column;overflow-y:auto}
.mob.open{display:flex}
.mob-top{display:flex;align-items:center;justify-content:space-between;padding:clamp(.9rem,2vw,1.1rem) var(--px);border-bottom:1px solid rgba(251,245,171,.07);flex-shrink:0}
.mob-logo{font-family:'Shrikhand',serif;font-size:1.4rem;color:var(--y)}
.mob-x{background:none;border:none;color:rgba(251,245,171,.5);font-size:1.2rem;cursor:pointer;padding:10px;min-width:44px;min-height:44px;display:flex;align-items:center;justify-content:center;-webkit-tap-highlight-color:transparent}
.mob-nav{display:flex;flex-direction:column;padding:.5rem var(--px);flex:1}
.mob-nav>a{display:block;padding:1.1rem 0;font-size:1.05rem;font-weight:400;color:rgba(251,245,171,.52);border-bottom:1px solid rgba(251,245,171,.05);transition:color .15s}
.mob-nav>a:last-child{border-bottom:none}
.mob-nav>a:hover{color:var(--y)}
.mob-acc{border-bottom:1px solid rgba(251,245,171,.05)}
.mob-abtn{width:100%;display:flex;align-items:center;justify-content:space-between;padding:1.1rem 0;background:none;border:none;cursor:pointer;font-size:1.05rem;font-weight:400;font-family:'Nunito',sans-serif;color:rgba(251,245,171,.52);-webkit-tap-highlight-color:transparent;transition:color .15s}
.mob-abtn.open{color:var(--y)}
.mob-abtn svg{transition:transform .2s;opacity:.5}
.mob-abtn.open svg{transform:rotate(180deg)}
.mob-abody{display:none;flex-direction:column;gap:0;padding:.25rem 0 .75rem}
.mob-abody.open{display:flex}
.mob-abody a{display:flex;align-items:center;gap:.75rem;padding:.75rem 1rem;font-size:.95rem;color:rgba(251,245,171,.45);border-radius:var(--rm);transition:all .15s}
.mob-abody a:hover{background:rgba(255,255,255,.04);color:var(--y)}
.mob-foot{display:flex;flex-direction:column;gap:.75rem;padding:1.25rem var(--px) clamp(2rem,5vh,3.5rem);border-top:1px solid rgba(251,245,171,.07);flex-shrink:0}
.mob-foot .btn{font-size:.95rem;padding:1.05rem}

/* Sticky LINE button */
.sticky-line{
  display:none;
  position:fixed;bottom:0;left:0;right:0;z-index:800;
  margin:0;
  align-items:center;justify-content:center;gap:.5rem;
  padding:.95rem var(--px) calc(.95rem + env(safe-area-inset-bottom));
  background:#06C755;color:#fff;
  font-family:'Nunito',sans-serif;font-size:.95rem;font-weight:700;
  text-decoration:none;
  -webkit-tap-highlight-color:transparent;
  transition:opacity .15s;
  box-shadow:0 -1px 0 rgba(0,0,0,.08);
}
.sticky-line:hover{opacity:.92}
.sticky-line.show{display:flex}
@media(min-width:1081px){.sticky-line{display:none!important}}

/* ══════════════════════════════
   FOOTER
══════════════════════════════ */
.ft{background:var(--xdk);border-top:1px solid rgba(251,245,171,.06);padding-bottom:env(safe-area-inset-bottom)}
.ft-top{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:3rem;max-width:var(--mx);margin-inline:auto;padding:clamp(4rem,8vw,6rem) var(--px) clamp(3rem,5vw,4.5rem)}
.ft-logo{display:block;font-family:'Shrikhand',serif;font-size:1.875rem;color:var(--y);margin-bottom:.875rem}
.ft-brand p{color:rgba(251,245,171,.28);font-size:.84rem;line-height:1.85;max-width:220px;margin-bottom:1.5rem}
.ft-soc{display:flex;flex-wrap:wrap;gap:.3rem 1.1rem}
.ft-soc a{color:rgba(251,245,171,.38);font-size:.8rem;font-weight:500;transition:color .15s}
.ft-soc a:hover{color:var(--y)}
.ft-col h5{font-size:.58rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(251,245,171,.18);margin-bottom:1.25rem}
.ft-col a{display:block;color:rgba(251,245,171,.4);font-size:.82rem;font-weight:400;margin-bottom:.65rem;transition:color .15s}
.ft-col a:hover{color:var(--y)}
.ft-bot{display:flex;justify-content:space-between;align-items:center;max-width:var(--mx);margin-inline:auto;padding:1.25rem var(--px);border-top:1px solid rgba(251,245,171,.06);font-size:.68rem;color:rgba(251,245,171,.15)}
@media(max-width:860px){.ft-top{grid-template-columns:1fr 1fr;gap:2.5rem}}
@media(max-width:520px){.ft-top{grid-template-columns:1fr}.ft-bot{flex-direction:column;gap:.4rem;text-align:center}}
</style>

<script>
// Nav scroll
const nav=document.getElementById('nav');
window.addEventListener('scroll',()=>nav.classList.toggle('on',window.scrollY>20),{passive:true});

// Ham / mobile
const ham=document.getElementById('ham');
const mob=document.getElementById('mob');
const mobX=document.getElementById('mobX');
function openMob(){mob.classList.add('open');ham.classList.add('open');ham.setAttribute('aria-expanded','true');document.body.style.overflow='hidden'}
function closeMob(){mob.classList.remove('open');ham.classList.remove('open');ham.setAttribute('aria-expanded','false');document.body.style.overflow=''}
ham.addEventListener('click',()=>mob.classList.contains('open')?closeMob():openMob());
mobX.addEventListener('click',closeMob);
document.querySelectorAll('.mob-nav>a,.mob-foot .btn').forEach(a=>a.addEventListener('click',closeMob));

// Mobile accordion
document.querySelectorAll('.mob-abtn').forEach(btn=>{
  btn.addEventListener('click',()=>{
    const body=btn.nextElementSibling;
    const open=btn.classList.contains('open');
    btn.classList.toggle('open',!open);
    body.classList.toggle('open',!open);
    btn.setAttribute('aria-expanded',String(!open));
  });
});

// Desktop dropdown
document.querySelectorAll('.nav-group').forEach(g=>{
  g.addEventListener('mouseenter',()=>g.classList.add('open'));
  g.addEventListener('mouseleave',()=>g.classList.remove('open'));
});

// Sticky LINE — shows after hero leaves viewport
const sl=document.getElementById('stickyLine');
if(sl){
  const hero=document.querySelector('.hero,.pg-hero,.brand-hero');
  if(hero){
    const io=new IntersectionObserver(([e])=>sl.classList.toggle('show',!e.isIntersecting),{threshold:0});
    io.observe(hero);
  } else { sl.classList.add('show'); }
}

// Scroll-triggered animations
if('IntersectionObserver' in window){
  const io=new IntersectionObserver(entries=>{
    entries.forEach(e=>{if(e.isIntersecting){e.target.style.animationPlayState='running';io.unobserve(e.target)}});
  },{threshold:0.08});
  document.querySelectorAll('.au').forEach(el=>{el.style.animationPlayState='paused';io.observe(el)});
}
</script>
