---
interface Props {
  title?: string;
  description?: string;
}
const { title = "Babycakes — Feel Good Food", description = "Born from baby + cakes. Classic recipes reimagined for today." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Nunito:ital,wght@0,400;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet"/>
  <style>
    :root{--y:#FBF5AB;--p:#9F97C2;--pd:#4C4378;--w:#fff;--blk:#111;--px:clamp(1.5rem,5vw,5rem)}
    *,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth;-webkit-font-smoothing:antialiased}
    body{font-family:'Nunito',sans-serif;background:var(--w);color:var(--blk);overflow-x:hidden}
    a{text-decoration:none;color:inherit}
    img{display:block;width:100%;object-fit:cover}
    .logo{font-family:'Shrikhand',serif}

    /* NAV */
    nav{position:fixed;top:0;left:0;right:0;z-index:200;display:flex;align-items:center;justify-content:space-between;padding:1.1rem var(--px);transition:background 0.3s,box-shadow 0.3s}
    nav.scrolled{background:var(--pd);box-shadow:0 2px 20px rgba(0,0,0,0.2)}
    .nav-logo{font-family:'Shrikhand',serif;font-size:1.5rem;color:var(--y);letter-spacing:-0.01em}
    .nav-links{display:flex;gap:2rem;list-style:none}
    .nav-links a{font-size:0.85rem;font-weight:700;color:rgba(251,245,171,0.75);letter-spacing:0.04em;text-transform:uppercase;transition:color 0.15s}
    .nav-links a:hover{color:var(--y)}
    .nav-cta{background:var(--y);color:var(--pd);font-weight:800;font-size:0.8rem;padding:0.5rem 1.25rem;border-radius:999px;letter-spacing:0.02em;transition:transform 0.15s,opacity 0.15s}
    .nav-cta:hover{transform:scale(1.04);opacity:0.9}
    .hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px}
    .hamburger span{display:block;width:22px;height:2px;background:var(--y);border-radius:2px;transition:all 0.2s}
    .mobile-nav{display:none;position:fixed;inset:0;background:var(--pd);z-index:199;flex-direction:column;align-items:center;justify-content:center;gap:2rem}
    .mobile-nav.open{display:flex}
    .mobile-nav a{font-size:2rem;font-weight:900;color:var(--y)}
    @media(max-width:768px){.nav-links,.nav-cta{display:none}.hamburger{display:flex}}

    /* MARQUEE */
    .marquee{overflow:hidden;background:var(--y);border-top:2px solid var(--pd);border-bottom:2px solid var(--pd);padding:0.6rem 0}
    .marquee-track{display:flex;width:max-content;animation:scroll 28s linear infinite}
    .marquee:hover .marquee-track{animation-play-state:paused}
    @keyframes scroll{to{transform:translateX(-50%)}}
    .marquee-item{display:inline-flex;align-items:center;gap:0.75rem;padding:0 2rem;font-size:0.78rem;font-weight:800;letter-spacing:0.08em;text-transform:uppercase;color:var(--pd);white-space:nowrap}
    .marquee-dot{color:var(--p);font-size:0.6rem}

    /* BADGES */
    .tag{display:inline-flex;align-items:center;padding:0.15rem 0.7rem;border-radius:999px;font-size:0.68rem;font-weight:700;letter-spacing:0.05em;text-transform:uppercase;line-height:1.7}
    .tag-y{background:var(--y);color:var(--pd)}
    .tag-p{background:var(--pd);color:var(--y)}
    .tag-o{background:transparent;border:1.5px solid currentColor;color:var(--pd)}

    /* BTN */
    .btn{display:inline-flex;align-items:center;gap:0.5rem;border-radius:999px;padding:0.8rem 2.2rem;font-family:'Nunito',sans-serif;font-weight:800;font-size:0.9rem;cursor:pointer;border:none;transition:transform 0.15s,background 0.15s}
    .btn:hover{transform:scale(1.03)}
    .btn-y{background:var(--y);color:var(--pd)}
    .btn-p{background:var(--pd);color:var(--y)}
    .btn-ghost{background:transparent;border:2px solid var(--y);color:var(--y)}

    /* FOOTER */
    footer{background:var(--pd);color:var(--y);padding:4rem var(--px) 1.5rem;margin-top:8rem}
    .footer-top{display:grid;grid-template-columns:2fr 1fr 1fr;gap:3rem;padding-bottom:3rem;border-bottom:1px solid rgba(251,245,171,0.15)}
    .footer-brand-name{font-family:'Shrikhand',serif;font-size:2.5rem;line-height:1;margin-bottom:0.75rem}
    .footer-tagline{color:rgba(251,245,171,0.5);font-size:0.85rem;line-height:1.7;max-width:260px}
    .footer-col h4{font-size:0.7rem;letter-spacing:0.1em;text-transform:uppercase;color:rgba(251,245,171,0.4);margin-bottom:1rem}
    .footer-col a{display:block;color:rgba(251,245,171,0.7);font-size:0.9rem;font-weight:600;margin-bottom:0.5rem;transition:color 0.15s}
    .footer-col a:hover{color:var(--y)}
    .footer-bottom{display:flex;justify-content:space-between;align-items:center;padding-top:1.5rem;font-size:0.72rem;color:rgba(251,245,171,0.3)}
    @media(max-width:640px){.footer-top{grid-template-columns:1fr}}

    /* ANIMATIONS */
    @keyframes fadeUp{from{opacity:0;transform:translateY(24px)}to{opacity:1;transform:translateY(0)}}
    .au{animation:fadeUp 0.6s cubic-bezier(0.22,1,0.36,1) both}
    .au-1{animation-delay:0.05s}.au-2{animation-delay:0.12s}.au-3{animation-delay:0.2s}.au-4{animation-delay:0.28s}
    @keyframes popin{0%{transform:scale(0.75) rotate(-6deg);opacity:0}70%{transform:scale(1.05) rotate(-6deg)}100%{transform:scale(1) rotate(-6deg);opacity:1}}
  </style>
</head>
<body>

<nav id="nav">
  <a href="/" class="nav-logo">babycakes</a>
  <ul class="nav-links">
    <li><a href="/">Home</a></li>
    <li><a href="/weekly-updates">Updates</a></li>
    <li><a href="/brand">Brand</a></li>
  </ul>
  <a href="/weekly-updates" class="nav-cta">This Week →</a>
  <button class="hamburger" id="ham" aria-label="Menu">
    <span></span><span></span><span></span>
  </button>
</nav>

<div class="mobile-nav" id="mob">
  <a href="/" onclick="closeMob()">Home</a>
  <a href="/weekly-updates" onclick="closeMob()">Weekly Updates</a>
  <a href="/brand" onclick="closeMob()">Brand</a>
</div>

<main><slot/></main>

<footer>
  <div class="footer-top">
    <div>
      <div class="footer-brand-name logo">babycakes</div>
      <p class="footer-tagline">Born from baby + cakes. Classic recipes reimagined for today. Crafted with warmth, intention, and heart.</p>
    </div>
    <div class="footer-col">
      <h4>Navigate</h4>
      <a href="/">Home</a>
      <a href="/weekly-updates">Weekly Updates</a>
      <a href="/brand">Brand</a>
      <a href="/admin">CMS Admin</a>
    </div>
    <div class="footer-col">
      <h4>Follow</h4>
      <a href="https://instagram.com" target="_blank">Instagram</a>
      <a href="https://facebook.com" target="_blank">Facebook</a>
      <a href="#" target="_blank">LINE</a>
      <a href="#" target="_blank">TikTok</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Babycakes. All rights reserved.</span>
    <span>feel good food ·</span>
  </div>
</footer>

<script>
const nav=document.getElementById('nav');
const ham=document.getElementById('ham');
const mob=document.getElementById('mob');
window.addEventListener('scroll',()=>{nav.classList.toggle('scrolled',window.scrollY>60)});
ham.addEventListener('click',()=>mob.classList.toggle('open'));
function closeMob(){mob.classList.remove('open')}
</script>
</body>
</html>
