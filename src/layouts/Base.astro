---
interface Props { title?: string; description?: string; }
const { title = "Babycakes — Feel Good Food", description = "Born from baby + cakes. Classic recipes reimagined for today. Crafted with warmth, intention, and heart." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Nunito:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,700&display=swap" rel="stylesheet"/>
</head>
<body>

<header class="nav" id="nav">
  <div class="nav-inner">
    <a href="/" class="nav-logo">babycakes</a>
    <nav class="nav-links">
      <a href="/">Home</a>
      <a href="/bi-weekly">Bi-Weekly Flavors</a>
      <a href="/always-available">Always Available</a>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
    </nav>
    <a href="/bi-weekly" class="nav-cta">This Week's Drop</a>
    <button class="nav-ham" id="navHam" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<div class="mob" id="mob">
  <button class="mob-x" id="mobX">✕</button>
  <div class="mob-logo">babycakes</div>
  <nav class="mob-nav">
    <a href="/">Home</a>
    <a href="/bi-weekly">Bi-Weekly Flavors</a>
    <a href="/always-available">Always Available</a>
    <a href="/brand">Brand</a>
    <a href="/careers">Careers</a>
  </nav>
  <a href="/bi-weekly" class="btn btn-y" style="margin-top:2rem;font-size:1rem">This Week's Drop →</a>
</div>

<main><slot/></main>

<footer class="footer">
  <div class="footer-top">
    <div class="footer-brand">
      <span class="footer-logo">babycakes</span>
      <p>Born from baby + cakes — a name rooted<br/>in love and care. Feel good food.</p>
      <div class="footer-social">
        <a href="#" aria-label="Instagram">IG</a>
        <a href="#" aria-label="Facebook">FB</a>
        <a href="#" aria-label="LINE">LINE</a>
        <a href="#" aria-label="TikTok">TK</a>
      </div>
    </div>
    <div class="footer-col">
      <h5>Discover</h5>
      <a href="/">Home</a>
      <a href="/bi-weekly">Bi-Weekly Flavors</a>
      <a href="/always-available">Always Available</a>
    </div>
    <div class="footer-col">
      <h5>Company</h5>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
      <a href="/admin">CMS Admin</a>
    </div>
    <div class="footer-col">
      <h5>Connect</h5>
      <a href="https://instagram.com" target="_blank" rel="noopener">Instagram</a>
      <a href="https://facebook.com" target="_blank" rel="noopener">Facebook</a>
      <a href="#" target="_blank">LINE Official</a>
      <a href="#" target="_blank">TikTok</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Babycakes Co., Ltd. All rights reserved.</span>
    <span class="footer-tagline">feel good food ·</span>
  </div>
</footer>

</body>
</html>

<style is:global>
/* ═══════════════════════════════════════════════
   BABYCAKES DESIGN SYSTEM — Brand Book 2026
   Primary:   #FBF5AB (yellow) · #9F97C2 (purple)
   Secondary: #4C4378 (dark) · #fff · #000
   Font:      Shrikhand (logo) · Nunito (body)
═══════════════════════════════════════════════ */

:root {
  /* Brand colors — exact from brand book */
  --yellow:    #FBF5AB;
  --purple:    #9F97C2;
  --dark:      #4C4378;
  --darker:    #2e2350;
  --black:     #000000;
  --white:     #ffffff;

  /* UI neutrals */
  --cream:     #FAFAF5;
  --gray-1:    #F2F1EC;
  --gray-2:    #E0DFDA;
  --gray-3:    #9A9890;
  --text:      #1a1a1a;

  /* Layout */
  --px:        clamp(1.75rem, 5vw, 5rem);
  --max:       1380px;
  --gap:       1.75rem;

  /* Radius */
  --r-sm:  0.625rem;
  --r-md:  1.125rem;
  --r-lg:  1.75rem;
  --r-xl:  2.5rem;

  /* Motion */
  --ease:   cubic-bezier(0.22, 1, 0.36, 1);
  --spring: cubic-bezier(0.34, 1.56, 0.64, 1);

  /* Type scale */
  --text-xs:   0.6875rem;
  --text-sm:   0.8125rem;
  --text-base: 1rem;
  --text-lg:   1.125rem;
  --text-xl:   1.375rem;
}

/* ── RESET ── */
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { scroll-behavior: smooth; font-size: 16px; }
body {
  font-family: 'Nunito', sans-serif;
  background: var(--white);
  color: var(--text);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  overflow-x: hidden;
  line-height: 1.65;
}
a { text-decoration: none; color: inherit; }
img { display: block; width: 100%; }

/* ── BRAND FONT ── */
.lf { font-family: 'Shrikhand', serif; }

/* ── CONTAINER ── */
.wrap {
  max-width: var(--max);
  margin-inline: auto;
  padding-inline: var(--px);
}

/* ── SECTION SPACING ── */
.sec  { padding-block: clamp(5rem, 9vw, 8rem); }
.sec-sm { padding-block: clamp(3rem, 5vw, 5rem); }

/* ── TAGS ── */
.tag {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.3rem 1rem;
  border-radius: 999px;
  font-size: var(--text-xs);
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
  line-height: 1.9;
  white-space: nowrap;
}
.tag-y  { background: var(--yellow);  color: var(--dark); }
.tag-p  { background: var(--dark);    color: var(--yellow); }
.tag-mid{ background: var(--purple);  color: var(--white); }
.tag-o  { border: 1.5px solid var(--dark); color: var(--dark); }
.tag-w  { background: rgba(255,255,255,0.15); color: var(--white); border: 1px solid rgba(255,255,255,0.25); }

/* ── BUTTONS ── */
.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  padding: 0.875rem 2.25rem;
  border-radius: 999px;
  font-family: 'Nunito', sans-serif;
  font-size: var(--text-sm);
  font-weight: 800;
  letter-spacing: 0.02em;
  border: none;
  cursor: pointer;
  transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease), opacity 0.15s;
  text-decoration: none;
  line-height: 1;
}
.btn:hover  { transform: translateY(-2px); box-shadow: 0 8px 28px rgba(0,0,0,0.14); }
.btn:active { transform: translateY(0);    box-shadow: none; }
.btn-y   { background: var(--yellow);  color: var(--dark); }
.btn-p   { background: var(--dark);    color: var(--yellow); }
.btn-mid { background: var(--purple);  color: var(--white); }
.btn-gh  { background: transparent; border: 2px solid var(--yellow); color: var(--yellow); }
.btn-ghd { background: transparent; border: 2px solid var(--dark);   color: var(--dark); }
.btn-sm  { padding: 0.6rem 1.5rem; font-size: var(--text-xs); }

/* ── MARQUEE ── */
.mq {
  overflow: hidden;
  background: var(--yellow);
  border-top: 2px solid var(--dark);
  border-bottom: 2px solid var(--dark);
  padding-block: 0.75rem;
}
.mq-track { display: flex; width: max-content; animation: mq-scroll 30s linear infinite; }
.mq:hover .mq-track { animation-play-state: paused; }
@keyframes mq-scroll { to { transform: translateX(-50%); } }
.mq-item {
  display: inline-flex;
  align-items: center;
  gap: 0.75rem;
  padding-inline: 2rem;
  font-size: var(--text-xs);
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  color: var(--dark);
  white-space: nowrap;
}
.mq-dot { color: var(--purple); font-size: 0.5rem; }

/* ── GRIDS ── */
.g3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--gap); }
.g2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--gap); }
.g4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--gap); }
@media (max-width: 1024px) { .g3 { grid-template-columns: repeat(2,1fr); } .g4 { grid-template-columns: repeat(2,1fr); } }
@media (max-width: 640px)  { .g3, .g2, .g4 { grid-template-columns: 1fr; } }

/* ── ANIMATIONS ── */
@keyframes fadeUp {
  from { opacity: 0; transform: translateY(30px); }
  to   { opacity: 1; transform: translateY(0); }
}
@keyframes popSpin {
  0%   { opacity: 0; transform: scale(0.65) rotate(-8deg); }
  70%  { transform: scale(1.07) rotate(-6deg); }
  100% { opacity: 1; transform: scale(1) rotate(-6deg); }
}
.au    { animation: fadeUp 0.7s var(--ease) both; }
.au-1  { animation-delay: 0.08s; }
.au-2  { animation-delay: 0.17s; }
.au-3  { animation-delay: 0.26s; }
.au-4  { animation-delay: 0.35s; }

/* ── DOT PATTERN ── */
.dots {
  position: absolute; inset: 0; pointer-events: none;
  background-image: radial-gradient(circle, rgba(255,255,255,0.06) 1px, transparent 1px);
  background-size: 30px 30px;
}

/* ── SECTION HEADER ── */
.sh { display: flex; align-items: flex-end; justify-content: space-between; gap: 2rem; margin-bottom: 3.5rem; flex-wrap: wrap; }
.sh-eyebrow { display: block; margin-bottom: 1rem; }
.sh-title { font-family: 'Shrikhand', serif; font-size: clamp(2.25rem, 4.5vw, 3.5rem); color: var(--dark); line-height: 1.05; letter-spacing: -0.01em; }

/* ── FLAVOR CARD ── */
.fcard {
  position: relative;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--card-bg, #999);
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
}
.fcard:hover { transform: translateY(-5px); box-shadow: 0 22px 60px rgba(0,0,0,0.22); }
.fcard-ov { position: absolute; inset: 0; background: linear-gradient(to top, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0) 55%); }
.fcard-body { position: relative; z-index: 2; padding: 1.75rem 2rem; }
.fcard-name { font-family: 'Shrikhand', serif; color: #fff; line-height: 1.05; margin-top: 0.6rem; margin-bottom: 0.4rem; }
.fcard-period { font-size: var(--text-xs); font-weight: 700; letter-spacing: 0.05em; color: rgba(255,255,255,0.5); }
.fcard-desc { font-size: var(--text-sm); color: rgba(255,255,255,0.72); line-height: 1.6; margin-top: 0.5rem; }

/* ══════════════════════════════════════════
   NAVBAR
══════════════════════════════════════════ */
.nav {
  position: fixed;
  inset: 0 0 auto;
  z-index: 900;
  transition: background 0.35s var(--ease), box-shadow 0.35s var(--ease), backdrop-filter 0.35s;
}
.nav.solid {
  background: rgba(46, 35, 80, 0.97);
  backdrop-filter: blur(12px);
  box-shadow: 0 1px 0 rgba(251,245,171,0.08), 0 4px 32px rgba(0,0,0,0.25);
}
.nav-inner {
  display: flex;
  align-items: center;
  gap: 0;
  padding: 1.35rem var(--px);
  max-width: var(--max);
  margin-inline: auto;
}
.nav-logo {
  font-family: 'Shrikhand', serif;
  font-size: 1.6rem;
  color: var(--yellow);
  letter-spacing: -0.01em;
  flex-shrink: 0;
  margin-right: auto;
}
.nav-links {
  display: flex;
  gap: 2rem;
  margin-right: 2.5rem;
}
.nav-links a {
  font-size: var(--text-xs);
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: rgba(251,245,171,0.6);
  transition: color 0.15s;
  padding-block: 0.25rem;
  position: relative;
}
.nav-links a::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0; right: 0;
  height: 1.5px;
  background: var(--yellow);
  transform: scaleX(0);
  transition: transform 0.2s var(--ease);
}
.nav-links a:hover { color: var(--yellow); }
.nav-links a:hover::after { transform: scaleX(1); }
.nav-cta {
  flex-shrink: 0;
  background: var(--yellow);
  color: var(--dark);
  font-size: var(--text-xs);
  font-weight: 800;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  padding: 0.6rem 1.5rem;
  border-radius: 999px;
  transition: transform 0.15s, opacity 0.15s;
}
.nav-cta:hover { transform: scale(1.04); opacity: 0.88; }
.nav-ham {
  display: none;
  flex-direction: column;
  gap: 5px;
  background: none;
  border: none;
  cursor: pointer;
  padding: 6px;
  margin-left: 1.5rem;
}
.nav-ham span { display: block; width: 23px; height: 2px; background: var(--yellow); border-radius: 2px; transition: all 0.22s; }
@media (max-width: 960px) { .nav-links, .nav-cta { display: none; } .nav-ham { display: flex; } }

/* ── MOBILE OVERLAY ── */
.mob {
  display: none;
  position: fixed;
  inset: 0;
  z-index: 950;
  background: var(--darker);
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 0;
}
.mob.open { display: flex; }
.mob-x { position: absolute; top: 1.5rem; right: var(--px); background: none; border: none; color: var(--yellow); font-size: 1.5rem; cursor: pointer; }
.mob-logo { font-family: 'Shrikhand', serif; font-size: 2.5rem; color: var(--yellow); margin-bottom: 3rem; }
.mob-nav { display: flex; flex-direction: column; align-items: center; gap: 1.5rem; margin-bottom: 1rem; }
.mob-nav a { font-size: 1.6rem; font-weight: 800; color: rgba(251,245,171,0.7); transition: color 0.15s; }
.mob-nav a:hover { color: var(--yellow); }

/* ══════════════════════════════════════════
   FOOTER
══════════════════════════════════════════ */
.footer {
  background: var(--darker);
  margin-top: 0;
  border-top: 1px solid rgba(251,245,171,0.07);
}
.footer-top {
  display: grid;
  grid-template-columns: 1.8fr 1fr 1fr 1fr;
  gap: 3rem;
  max-width: var(--max);
  margin-inline: auto;
  padding: 5rem var(--px) 4rem;
}
.footer-logo {
  display: block;
  font-family: 'Shrikhand', serif;
  font-size: 2.2rem;
  color: var(--yellow);
  margin-bottom: 1.1rem;
}
.footer-brand p { color: rgba(251,245,171,0.38); font-size: var(--text-sm); line-height: 1.8; max-width: 240px; margin-bottom: 1.75rem; }
.footer-social { display: flex; gap: 0.7rem; }
.footer-social a {
  display: flex; align-items: center; justify-content: center;
  width: 34px; height: 34px; border-radius: 50%;
  border: 1.5px solid rgba(251,245,171,0.18);
  color: rgba(251,245,171,0.5);
  font-size: 0.65rem; font-weight: 800;
  transition: all 0.15s;
}
.footer-social a:hover { background: var(--yellow); color: var(--dark); border-color: var(--yellow); }
.footer-col h5 { font-size: 0.62rem; letter-spacing: 0.13em; text-transform: uppercase; color: rgba(251,245,171,0.28); margin-bottom: 1.35rem; }
.footer-col a { display: block; color: rgba(251,245,171,0.55); font-size: var(--text-sm); font-weight: 600; margin-bottom: 0.7rem; transition: color 0.15s; }
.footer-col a:hover { color: var(--yellow); }
.footer-bottom {
  display: flex; justify-content: space-between; align-items: center;
  max-width: var(--max); margin-inline: auto;
  padding: 1.5rem var(--px);
  border-top: 1px solid rgba(251,245,171,0.07);
  font-size: 0.68rem;
  color: rgba(251,245,171,0.2);
}
@media (max-width: 900px) { .footer-top { grid-template-columns: 1fr 1fr; } }
@media (max-width: 560px) { .footer-top { grid-template-columns: 1fr; } .footer-bottom { flex-direction: column; gap: 0.5rem; text-align: center; } }
</style>

<script>
const nav = document.getElementById('nav');
const ham = document.getElementById('navHam');
const mob = document.getElementById('mob');
const mobX = document.getElementById('mobX');
window.addEventListener('scroll', () => nav.classList.toggle('solid', window.scrollY > 30));
ham.addEventListener('click', () => mob.classList.toggle('open'));
mobX.addEventListener('click', () => mob.classList.remove('open'));
document.querySelectorAll('.mob-nav a, .mob .btn').forEach(a => a.addEventListener('click', () => mob.classList.remove('open')));
</script>
