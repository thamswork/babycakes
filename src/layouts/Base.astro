---
interface Props { title?: string; description?: string; }
const { title = "Babycakes — Feel Good Food", description = "Born from baby + cakes. Classic recipes reimagined for today. Crafted with warmth, intention, and heart." } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <meta name="viewport" content="width=device-width,initial-scale=1.0"/>
  <title>{title}</title>
  <meta name="description" content={description}/>
  <link rel="preconnect" href="https://fonts.googleapis.com"/>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Nunito:ital,wght@0,400;0,600;0,700;0,800;0,900;1,400&display=swap" rel="stylesheet"/>
</head>
<body>

<header class="site-nav" id="siteNav">
  <div class="nav-inner">
    <a href="/" class="nav-brand">babycakes</a>
    <nav class="nav-menu">
      <a href="/">Home</a>
      <a href="/weekly-updates">Weekly Updates</a>
      <a href="/brand">Brand</a>
      <a href="/careers">Careers</a>
    </nav>
    <a href="/weekly-updates" class="nav-btn">This Week's Drop</a>
    <button class="nav-hamburger" id="navHam" aria-label="Menu"><span></span><span></span><span></span></button>
  </div>
</header>

<div class="mob-overlay" id="mobOverlay">
  <button class="mob-close" id="mobClose">✕</button>
  <nav class="mob-menu">
    <a href="/">Home</a>
    <a href="/weekly-updates">Weekly Updates</a>
    <a href="/brand">Brand</a>
    <a href="/careers">Careers</a>
    <a href="/weekly-updates" class="mob-cta">This Week's Drop →</a>
  </nav>
</div>

<main><slot/></main>

<footer class="site-footer">
  <div class="ft-wrap">
    <div class="ft-brand">
      <span class="ft-wordmark">babycakes</span>
      <p class="ft-desc">Born from baby + cakes. Classic recipes reimagined for today. Crafted with warmth, intention, and heart.</p>
      <div class="ft-socials">
        <a href="#" target="_blank">IG</a>
        <a href="#" target="_blank">FB</a>
        <a href="#" target="_blank">LINE</a>
        <a href="#" target="_blank">TK</a>
      </div>
    </div>
    <div class="ft-col"><h5>Navigate</h5><a href="/">Home</a><a href="/weekly-updates">Weekly Updates</a><a href="/brand">Brand</a><a href="/careers">Careers</a></div>
    <div class="ft-col"><h5>Follow</h5><a href="https://instagram.com" target="_blank">Instagram</a><a href="https://facebook.com" target="_blank">Facebook</a><a href="#" target="_blank">LINE Official</a><a href="#" target="_blank">TikTok</a></div>
    <div class="ft-col"><h5>Work With Us</h5><a href="/careers">Open Roles</a><a href="/admin" target="_blank">CMS Admin</a><a href="mailto:hello@babycakes.th">hello@babycakes.th</a></div>
  </div>
  <div class="ft-bottom"><span>© {new Date().getFullYear()} Babycakes Co., Ltd. All rights reserved.</span><span>feel good food ·</span></div>
</footer>

</body>
</html>

<style is:global>
:root{--y:#FBF5AB;--yd:#f0e870;--p:#9F97C2;--pd:#4C4378;--pxd:#2e2650;--w:#fff;--ow:#FAFAF7;--k:#0D0D0D;--g1:#F5F4F0;--g2:#E8E7E2;--g3:#9A9890;--px:clamp(1.5rem,5vw,5rem);--mx:1360px;--rsm:0.75rem;--rmd:1.25rem;--rlg:2rem;--eout:cubic-bezier(0.22,1,0.36,1);--esp:cubic-bezier(0.34,1.56,0.64,1)}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:'Nunito',sans-serif;background:var(--w);color:var(--k);-webkit-font-smoothing:antialiased;overflow-x:hidden;line-height:1.6}
a{text-decoration:none;color:inherit}
img{display:block;width:100%}
.lf{font-family:'Shrikhand',serif}
.wrap{max-width:var(--mx);margin-inline:auto;padding-inline:var(--px)}
.sec{padding-block:clamp(5rem,10vw,9rem)}
.sec-sm{padding-block:clamp(3rem,6vw,5rem)}

/* TAGS */
.tag{display:inline-flex;align-items:center;gap:.3rem;padding:.25rem .85rem;border-radius:999px;font-size:.68rem;font-weight:800;letter-spacing:.08em;text-transform:uppercase;line-height:1.8;white-space:nowrap}
.tag-y{background:var(--y);color:var(--pd)}
.tag-p{background:var(--pd);color:var(--y)}
.tag-o{border:1.5px solid var(--pd);color:var(--pd)}
.tag-w{background:rgba(255,255,255,.18);color:#fff;backdrop-filter:blur(4px)}

/* BUTTONS */
.btn{display:inline-flex;align-items:center;gap:.5rem;padding:.85rem 2.25rem;border-radius:999px;font-family:'Nunito',sans-serif;font-size:.9rem;font-weight:800;letter-spacing:.01em;border:none;cursor:pointer;transition:transform .18s var(--eout),box-shadow .18s var(--eout)}
.btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.15)}
.btn:active{transform:translateY(0);box-shadow:none}
.btn-y{background:var(--y);color:var(--pd)}
.btn-p{background:var(--pd);color:var(--y)}
.btn-gh{background:transparent;border:2px solid var(--y);color:var(--y)}
.btn-ghd{background:transparent;border:2px solid var(--pd);color:var(--pd)}
.btn-sm{padding:.55rem 1.4rem;font-size:.8rem}

/* MARQUEE */
.mq-strip{overflow:hidden;background:var(--y);border-top:2px solid var(--pd);border-bottom:2px solid var(--pd);padding-block:.7rem}
.mq-track{display:flex;width:max-content;animation:mq 32s linear infinite}
.mq-strip:hover .mq-track{animation-play-state:paused}
@keyframes mq{to{transform:translateX(-50%)}}
.mq-item{display:inline-flex;align-items:center;gap:.6rem;padding-inline:2rem;font-size:.75rem;font-weight:800;letter-spacing:.09em;text-transform:uppercase;color:var(--pd);white-space:nowrap}
.mq-dot{color:var(--p);font-size:.55rem}

/* GRIDS */
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:1.75rem}
.g2{display:grid;grid-template-columns:repeat(2,1fr);gap:1.75rem}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:1.5rem}
@media(max-width:1024px){.g3{grid-template-columns:repeat(2,1fr)}}
@media(max-width:768px){.g3,.g2,.g4{grid-template-columns:1fr}}

/* ANIMATIONS */
@keyframes fadeUp{from{opacity:0;transform:translateY(28px)}to{opacity:1;transform:translateY(0)}}
@keyframes popIn{0%{opacity:0;transform:scale(.7) rotate(-6deg)}70%{transform:scale(1.06) rotate(-6deg)}100%{opacity:1;transform:scale(1) rotate(-6deg)}}
.au{animation:fadeUp .65s var(--eout) both}
.au1{animation-delay:.08s}.au2{animation-delay:.16s}.au3{animation-delay:.24s}.au4{animation-delay:.32s}

/* NAV */
.site-nav{position:fixed;inset:0 0 auto;z-index:900;transition:background .35s,box-shadow .35s}
.site-nav.scrolled{background:var(--pxd);box-shadow:0 2px 32px rgba(0,0,0,.25)}
.nav-inner{display:flex;align-items:center;gap:2.5rem;padding:1.25rem var(--px);max-width:var(--mx);margin-inline:auto}
.nav-brand{font-family:'Shrikhand',serif;font-size:1.55rem;color:var(--y);letter-spacing:-.01em;flex-shrink:0}
.nav-menu{display:flex;gap:2.25rem;margin-inline:auto}
.nav-menu a{font-size:.82rem;font-weight:700;letter-spacing:.06em;text-transform:uppercase;color:rgba(251,245,171,.65);transition:color .15s}
.nav-menu a:hover{color:var(--y)}
.nav-btn{flex-shrink:0;background:var(--y);color:var(--pd);font-size:.8rem;font-weight:800;padding:.55rem 1.4rem;border-radius:999px;transition:transform .15s,opacity .15s}
.nav-btn:hover{transform:scale(1.04);opacity:.9}
.nav-hamburger{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:6px;margin-left:auto}
.nav-hamburger span{display:block;width:24px;height:2px;background:var(--y);border-radius:2px}
@media(max-width:900px){.nav-menu,.nav-btn{display:none}.nav-hamburger{display:flex}}

/* MOBILE OVERLAY */
.mob-overlay{display:none;position:fixed;inset:0;z-index:950;background:var(--pxd);flex-direction:column;align-items:center;justify-content:center;gap:2rem}
.mob-overlay.open{display:flex}
.mob-close{position:absolute;top:1.5rem;right:var(--px);background:none;border:none;color:var(--y);font-size:1.5rem;cursor:pointer}
.mob-menu{display:flex;flex-direction:column;align-items:center;gap:1.75rem}
.mob-menu a{font-size:2rem;font-weight:900;color:rgba(251,245,171,.75);transition:color .15s}
.mob-menu a:hover{color:var(--y)}
.mob-cta{margin-top:.5rem;background:var(--y)!important;color:var(--pd)!important;padding:.85rem 2.5rem;border-radius:999px;font-size:1rem!important;font-weight:900!important}

/* FOOTER */
.site-footer{background:var(--pxd);color:var(--y);margin-top:8rem;border-top:1px solid rgba(251,245,171,.08)}
.ft-wrap{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:3rem;max-width:var(--mx);margin-inline:auto;padding:5rem var(--px) 3.5rem}
.ft-wordmark{display:block;font-family:'Shrikhand',serif;font-size:2.25rem;color:var(--y);margin-bottom:1rem}
.ft-desc{color:rgba(251,245,171,.45);font-size:.88rem;line-height:1.8;max-width:260px;margin-bottom:1.75rem}
.ft-socials{display:flex;gap:.75rem}
.ft-socials a{display:flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;border:1.5px solid rgba(251,245,171,.25);color:rgba(251,245,171,.6);font-size:.7rem;font-weight:800;transition:all .15s}
.ft-socials a:hover{background:var(--y);color:var(--pd);border-color:var(--y)}
.ft-col h5{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;color:rgba(251,245,171,.3);margin-bottom:1.25rem}
.ft-col a{display:block;color:rgba(251,245,171,.6);font-size:.88rem;font-weight:600;margin-bottom:.65rem;transition:color .15s}
.ft-col a:hover{color:var(--y)}
.ft-bottom{display:flex;justify-content:space-between;align-items:center;max-width:var(--mx);margin-inline:auto;padding:1.5rem var(--px);border-top:1px solid rgba(251,245,171,.08);font-size:.72rem;color:rgba(251,245,171,.25)}
@media(max-width:900px){.ft-wrap{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.ft-wrap{grid-template-columns:1fr}}

/* DOT PATTERN */
.dots{position:absolute;inset:0;background-image:radial-gradient(circle,rgba(255,255,255,.04) 1px,transparent 1px);background-size:28px 28px;pointer-events:none}
</style>

<script>
const nav=document.getElementById('siteNav');
const ham=document.getElementById('navHam');
const ov=document.getElementById('mobOverlay');
const cl=document.getElementById('mobClose');
window.addEventListener('scroll',()=>nav.classList.toggle('scrolled',window.scrollY>40));
ham.addEventListener('click',()=>ov.classList.toggle('open'));
cl.addEventListener('click',()=>ov.classList.remove('open'));
</script>
