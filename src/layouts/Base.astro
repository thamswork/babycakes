    <div class="nav-social">
      <a href="https://lin.ee/babycakes" target="_blank" rel="noopener" aria-label="LINE OA" class="nav-soc-link nav-line-btn">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5C21 7.36 16.97 4 12 4S3 7.36 3 11.5c0 3.69 3.27 6.79 7.69 7.38.3.06.71.2.81.45.09.23.06.58.03.81l-.13.79c-.04.23-.18.9.79.49 1-.42 5.37-3.16 7.33-5.41C20.4 14.69 21 13.16 21 11.5z"/><circle cx="9" cy="11.5" r=".5" fill="currentColor" stroke="none"/><circle cx="12" cy="11.5" r=".5" fill="currentColor" stroke="none"/><circle cx="15" cy="11.5" r=".5" fill="currentColor" stroke="none"/></svg>
