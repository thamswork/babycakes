---
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = "Babycakes — Feel Good Food",
  description = "Born from baby + cakes. Classic recipes reimagined for today. Crafted with warmth, intention, and heart.",
  ogImage = "/og-default.jpg",
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Shrikhand&family=Nunito:wght@400;500;600;700;800;900&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/src/styles/global.css" />
</head>
<body>
<header id="navbar">
  <nav>
    <a href="/" class="nav-logo font-logo">babycakes</a>
    <ul class="nav-links">
      <li><a href="/">Home</a></li>
      <li><a href="/weekly-updates">Weekly Updates</a></li>
      <li><a href="/brand">Brand</a></li>
    </ul>
    <a href="/weekly-updates" class="btn btn-primary nav-cta">This Week's Flavor →</a>
    <button id="menu-btn" aria-label="Open menu"><span></span><span></span><span></span></button>
  </nav>
  <div id="mobile-menu">
    <a href="/">Home</a>
    <a href="/weekly-updates">Weekly Updates</a>
    <a href="/brand">Brand</a>
    <a href="/weekly-updates" class="btn btn-primary" style="margin-top:1rem;">This Week's Flavor →</a>
  </div>
</header>
<main><slot /></main>
<footer>
  <div class="footer-inner">
    <div class="footer-brand">
      <span class="font-logo footer-logo">babycakes</span>
      <p>feel good food ·</p>
    </div>
    <div class="footer-links">
      <a href="/weekly-updates">Weekly Updates</a>
      <a href="/brand">Brand Standards</a>
      <a href="/admin" target="_blank">CMS</a>
    </div>
    <div class="footer-social">
      <a href="https://instagram.com/babycakes" target="_blank" rel="noopener">Instagram</a>
      <a href="https://line.me/babycakes" target="_blank" rel="noopener">LINE</a>
      <a href="https://facebook.com/babycakes" target="_blank" rel="noopener">Facebook</a>
    </div>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} Babycakes. All rights reserved.</span>
  </div>
</footer>
</body>
</html>
<style>
#navbar{position:sticky;top:0;z-index:100;background:var(--purple-dark);border-bottom:2px solid rgba(251,245,171,0.15);}
nav{display:flex;align-items:center;gap:2rem;padding:0.85rem var(--pad-x);max-width:1280px;margin:0 auto;}
.nav-logo{font-size:1.6rem;color:var(--yellow);text-decoration:none;flex-shrink:0;}
.nav-links{display:flex;list-style:none;margin:0 auto;padding:0;gap:2.5rem;}
.nav-links a{color:rgba(251,245,171,0.75);text-decoration:none;font-weight:700;font-size:0.9rem;transition:color 0.15s;}
.nav-links a:hover{color:var(--yellow);}
.nav-cta{padding:0.5rem 1.4rem;font-size:0.85rem;flex-shrink:0;}
#menu-btn{display:none;flex-direction:column;gap:5px;background:none;border:none;cursor:pointer;padding:4px;margin-left:auto;}
#menu-btn span{display:block;width:24px;height:2px;background:var(--yellow);border-radius:2px;}
#mobile-menu{display:none;flex-direction:column;padding:1.25rem var(--pad-x) 1.5rem;gap:0.75rem;border-top:1px solid rgba(251,245,171,0.1);}
#mobile-menu a{color:rgba(251,245,171,0.85);text-decoration:none;font-weight:700;font-size:1rem;}
#mobile-menu.open{display:flex;}
@media(max-width:768px){.nav-links,.nav-cta{display:none;}#menu-btn{display:flex;}}
footer{background:var(--purple-dark);color:var(--yellow);margin-top:6rem;}
.footer-inner{display:grid;grid-template-columns:1fr 1fr 1fr;gap:2rem;padding:3.5rem var(--pad-x) 2.5rem;max-width:1280px;margin:0 auto;}
.footer-logo{font-size:2rem;display:block;margin-bottom:0.5rem;}
.footer-brand p{color:rgba(251,245,171,0.6);font-size:0.85rem;margin:0;}
.footer-links,.footer-social{display:flex;flex-direction:column;gap:0.6rem;padding-top:0.5rem;}
.footer-links a,.footer-social a{color:rgba(251,245,171,0.7);text-decoration:none;font-size:0.9rem;font-weight:600;transition:color 0.15s;}
.footer-links a:hover,.footer-social a:hover{color:var(--yellow);}
.footer-bottom{border-top:1px solid rgba(251,245,171,0.1);text-align:center;padding:1rem var(--pad-x);font-size:0.75rem;color:rgba(251,245,171,0.4);}
@media(max-width:640px){.footer-inner{grid-template-columns:1fr;}}
</style>
<script>
const btn=document.getElementById('menu-btn');
const menu=document.getElementById('mobile-menu');
btn?.addEventListener('click',()=>menu?.classList.toggle('open'));
</script>
